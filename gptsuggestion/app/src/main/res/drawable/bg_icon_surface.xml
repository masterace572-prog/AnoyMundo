<?xml version="1.0" encoding="utf-8"?>
<!-- Identical contained treatment for Home help/settings and Settings back. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="100"
    android:exitFadeDuration="100">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/accent" />
            <corners android:radius="@dimen/radius_icon_button" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_3" />
            <corners android:radius="@dimen/radius_icon_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_1" />
            <corners android:radius="@dimen/radius_icon_button" />
        </shape>
    </item>
</selector>
