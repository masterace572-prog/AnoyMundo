<?xml version="1.0" encoding="utf-8"?>
<!-- Row press: fill change over 100 ms (motion "press"), no ripple, no scale. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="100"
    android:exitFadeDuration="100">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/accent" />
            <corners android:radius="@dimen/radius_tiny" />
        </shape>
    </item>
    <item android:state_pressed="true" android:drawable="@color/surface_3" />
    <item android:drawable="@color/transparent" />
</selector>
