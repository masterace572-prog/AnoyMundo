<?xml version="1.0" encoding="utf-8"?>
<!-- Native AMOLED Home and Settings. Existing IDs/state bindings and all real
     actions are preserved. Content can grow with font size and clear system bars. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ScrollView
        android:id="@+id/mainScroll"
        style="@style/Scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/screen_padding">

            <!-- Brand and navigation share a compact bar; the greeting gets full width. -->
            <LinearLayout
                android:id="@+id/mainHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_20"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/homeKicker"
                        style="@style/Text.Brand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/brand_name" />

                    <ImageButton
                        android:id="@+id/helpButton"
                        style="@style/IconButton.Surface"
                        android:contentDescription="@string/help_open"
                        app:srcCompat="@drawable/ic_help" />

                    <ImageButton
                        android:id="@+id/settingsButton"
                        style="@style/IconButton.Surface"
                        android:layout_marginStart="@dimen/space_8"
                        android:contentDescription="@string/settings_open"
                        app:srcCompat="@drawable/ic_settings" />
                </LinearLayout>

                <TextView
                    android:id="@+id/homeTitle"
                    style="@style/Text.Header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:accessibilityHeading="true"
                    android:text="@string/home_title" />
            </LinearLayout>

            <!-- ======================================================= notice -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelNoteCard"
                style="@style/Widget.Anoy.Card.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <ImageView
                        android:layout_width="@dimen/icon_inline"
                        android:layout_height="@dimen/icon_inline"
                        android:layout_marginTop="@dimen/space_2"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_megaphone"
                        app:tint="@color/notice_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/panelNoteKicker"
                            style="@style/Text.Kicker.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/announcement" />

                        <TextView
                            android:id="@+id/panelNote"
                            style="@style/Text.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================ BGMI updated (2.3.5)
                 Shown when the installed BGMI is newer than the version the
                 panel says the library works with. Only a notice. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/gameUpdateCard"
                style="@style/Widget.Anoy.Card.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <ImageView
                        android:layout_width="@dimen/icon_inline"
                        android:layout_height="@dimen/icon_inline"
                        android:layout_marginTop="@dimen/space_2"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_triangle_alert"
                        app:tint="@color/notice_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Kicker.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/game_update_kicker" />

                        <TextView
                            android:id="@+id/gameUpdateText"
                            style="@style/Text.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================================================== time card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/licenceCard"
                style="@style/Widget.Anoy.Card.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/licenceLabel"
                            style="@style/Text.Kicker"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/licence_expires_in" />

                        <TextView
                            android:id="@+id/statusValue"
                            style="@style/Text.Caption.Medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:drawablePadding="@dimen/space_8"
                            android:gravity="center_vertical"
                            android:text="@string/dash" />
                    </LinearLayout>

                    <!-- Primary time remaining. At large font sizes units may wrap, never clip. -->
                    <TextView
                        android:id="@+id/timeLeftValue"
                        style="@style/Text.Countdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/dash" />

                    <TextView
                        android:id="@+id/expiresValue"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:id="@+id/licenceChecked"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textColor="@color/text_tertiary"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================================================== game card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/gameCard"
                style="@style/Widget.Anoy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <LinearLayout
                        android:id="@+id/gameHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- The BGMI icon, bundled (res/drawable-nodpi); never loaded at runtime. -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/gameTile"
                            android:layout_width="@dimen/game_tile"
                            android:layout_height="@dimen/game_tile"
                            android:contentDescription="@string/game_icon_description"
                            android:padding="@dimen/game_icon_inset"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Anoy.GameTile"
                            app:srcCompat="@drawable/ic_game_bgmi"
                            app:strokeColor="@color/hairline"
                            app:strokeWidth="@dimen/hairline" />

                        <View
                            android:layout_width="@dimen/hairline"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_marginEnd="@dimen/space_16"
                            android:background="@color/divider"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/gameValue"
                                style="@style/Text.TitleM"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/game_name" />

                            <TextView
                                android:id="@+id/gameVersion"
                                style="@style/Text.Mono"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:fontFeatureSettings="tnum"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/libraryValue"
                                style="@style/Text.Mono"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/text_tertiary" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        style="@style/Divider"
                        android:layout_marginTop="@dimen/space_16" />

                    <LinearLayout
                        android:id="@+id/stateCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Micro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/row_state" />

                            <TextView
                                android:id="@+id/gameStateValue"
                                style="@style/Text.BodyL.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:drawablePadding="@dimen/space_8"
                                android:gravity="center_vertical"
                                android:text="@string/dash" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Micro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/row_server" />

                            <TextView
                                android:id="@+id/serverValue"
                                style="@style/Text.BodyL.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:drawablePadding="@dimen/space_8"
                                android:gravity="center_vertical"
                                android:text="@string/dash" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- ===================================================== pinned action bar -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/black"
        android:orientation="vertical"
        android:tag="snackbar_anchor">

        <View
            android:id="@+id/actionDivider"
            style="@style/Divider"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/actionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_16">

            <TextView
                android:id="@+id/statusMessage"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/taskProgress"
                style="@style/Widget.Anoy.Progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primaryAction"
                style="@style/Widget.Anoy.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launch" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================================= settings -->
    <FrameLayout
        android:id="@+id/settingsPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/settingsScroll"
            style="@style/Scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/settingsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/space_24">

                <LinearLayout
                    android:id="@+id/settingsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/brand_row_height"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/settingsBack"
                        style="@style/IconButton.Surface"
                        android:contentDescription="@string/settings_back"
                        app:srcCompat="@drawable/ic_chevron_left" />

                    <TextView
                        android:id="@+id/settingsTitle"
                        style="@style/Text.Header"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/settings" />
                </LinearLayout>

                <!-- Licence (2.3.1): key (masked, eye reveals, tap copies), status, expiry -->
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/space_24"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_licence" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/licenceGroup"
                    style="@style/Widget.Anoy.Group">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- The row still copies on tap; explicit copy/eye each get 48 dp. -->
                        <LinearLayout
                            android:id="@+id/licenceKeyRow"
                            style="@style/Row"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingTop="@dimen/space_8"
                            android:paddingEnd="@dimen/space_4"
                            android:paddingBottom="@dimen/space_8">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/space_4"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Text.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/licence_key" />

                                <TextView
                                    android:id="@+id/licenceKeyValue"
                                    style="@style/Text.Mono.Key"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:singleLine="true"
                                    android:text="@string/dash" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/licenceKeyEye"
                                style="@style/IconButton.Inline"
                                android:contentDescription="@string/licence_key_show"
                                app:srcCompat="@drawable/ic_eye" />

                            <ImageButton
                                android:id="@+id/licenceKeyCopy"
                                style="@style/IconButton.Inline"
                                android:contentDescription="@string/licence_key_copy"
                                app:srcCompat="@drawable/ic_copy" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            style="@style/Row"
                            android:background="@null"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_licence_status" />

                            <!-- wrap_content: the dot sits right before the word, at the end. -->
                            <TextView
                                android:id="@+id/licenceStatusValue"
                                style="@style/Text.RowValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:drawablePadding="@dimen/space_8"
                                android:text="@string/dash" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            style="@style/Row"
                            android:background="@null"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_licence_expires" />

                            <TextView
                                android:id="@+id/licenceExpiresValue"
                                style="@style/Text.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:layout_weight="1"
                                android:fontFeatureSettings="tnum"
                                android:text="@string/dash" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Updates: the app check (with "Last checked"), library re-download and
                     version, and the app version -->
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_updates" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/updatesGroup"
                    style="@style/Widget.Anoy.Group">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/checkUpdateRow"
                            style="@style/Row"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                style="@style/RowIcon"
                                app:srcCompat="@drawable/ic_refresh_cw" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Text.RowLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_check_updates" />

                                <TextView
                                    android:id="@+id/checkUpdateCaption"
                                    style="@style/Text.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:accessibilityLiveRegion="polite"
                                    android:text="@string/settings_not_checked" />

                                <!-- Status uses a full line so large text never crushes the label. -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:baselineAligned="false"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <com.google.android.material.progressindicator.CircularProgressIndicator
                                        android:id="@+id/checkUpdateSpinner"
                                        style="@style/Widget.Anoy.StatusSpinner"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="@dimen/space_8"
                                        android:importantForAccessibility="no"
                                        android:indeterminate="true"
                                        android:visibility="gone" />

                                    <ImageView
                                        android:id="@+id/checkUpdateIcon"
                                        android:layout_width="@dimen/icon_small"
                                        android:layout_height="@dimen/icon_small"
                                        android:layout_marginEnd="@dimen/space_8"
                                        android:importantForAccessibility="no"
                                        android:visibility="gone"
                                        app:srcCompat="@drawable/ic_check"
                                        app:tint="@color/success" />

                                    <TextView
                                        android:id="@+id/checkUpdateValue"
                                        style="@style/Text.Caption.Medium"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:accessibilityLiveRegion="polite"
                                        android:visibility="gone" />
                                </LinearLayout>
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/checkUpdateGlyph"
                                style="@style/RowGlyph"
                                app:srcCompat="@drawable/ic_chevron_right" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            android:id="@+id/redownloadRow"
                            style="@style/Row"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                style="@style/RowIcon"
                                app:srcCompat="@drawable/ic_download" />

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_redownload" />

                            <ImageView
                                style="@style/RowGlyph"
                                app:srcCompat="@drawable/ic_chevron_right" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            style="@style/Row"
                            android:background="@null"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_library_version" />

                            <TextView
                                android:id="@+id/libraryVersionValue"
                                style="@style/Text.Mono"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:layout_weight="1"
                                android:fontFeatureSettings="tnum"
                                android:gravity="end"
                                android:text="@string/dash" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <!-- 2.3.4: App version lives here now (the About group is gone). -->
                        <LinearLayout
                            style="@style/Row"
                            android:background="@null"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_version" />

                            <TextView
                                android:id="@+id/appVersionValue"
                                style="@style/Text.Mono"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:layout_weight="1"
                                android:fontFeatureSettings="tnum"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Device -->
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_device" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/deviceCard"
                    style="@style/Widget.Anoy.Group">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            style="@style/Row"
                            android:background="@null"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_model" />

                            <TextView
                                android:id="@+id/modelValue"
                                style="@style/Text.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            style="@style/Row"
                            android:background="@null"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_android" />

                            <TextView
                                android:id="@+id/androidValue"
                                style="@style/Text.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Report a problem -->
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_report" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/reportCard"
                    style="@style/Widget.Anoy.Group">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/settingsTelegram"
                            style="@style/Row"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                style="@style/RowIcon"
                                app:srcCompat="@drawable/ic_telegram" />

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_telegram" />

                            <ImageView
                                style="@style/RowGlyph"
                                app:srcCompat="@drawable/ic_arrow_up_right" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            android:id="@+id/settingsCopySupport"
                            style="@style/Row"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                style="@style/RowIcon"
                                app:srcCompat="@drawable/ic_copy" />

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_copy_support" />

                            <ImageView
                                style="@style/RowGlyph"
                                app:srcCompat="@drawable/ic_chevron_right" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Account -->
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_account" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/accountCard"
                    style="@style/Widget.Anoy.Group">

                    <LinearLayout
                        android:id="@+id/signOut"
                        style="@style/Row.Danger"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            style="@style/RowIcon"
                            app:srcCompat="@drawable/ic_log_out"
                            app:tint="@color/danger" />

                        <TextView
                            style="@style/Text.RowLabel.Danger"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sign_out" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
