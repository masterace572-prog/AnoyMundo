<?xml version="1.0" encoding="utf-8"?>
<!-- Solid AMOLED palette. Keep raw UI colours centralized here. -->
<resources>
    <!-- Surfaces: black canvas, quiet cards, elevated controls. -->
    <color name="background">#FF000000</color>
    <color name="surface_1">#FF151619</color>
    <color name="surface_2">#FF1C1D21</color>
    <color name="surface_3">#FF26282E</color>
    <color name="surface_well">#FF0E0F11</color>
    <color name="hairline">#FF303239</color>
    <color name="divider">#FF27292F</color>
    <color name="handle">#FF464951</color>
    <color name="progress_track">#FF26282E</color>

    <!-- Text: all small metadata remains legible on both card surfaces. -->
    <color name="text_primary">#FFF5F5F5</color>
    <color name="text_secondary">#FF92949B</color>
    <color name="text_tertiary">#FF8E919B</color>
    <color name="wordmark">#FFFFFFFF</color>

    <!-- Accent: dark on-accent content gives 5.75:1 contrast on this blue. -->
    <color name="accent">#FF2585F5</color>
    <color name="accent_pressed">#FF1F77DF</color>
    <color name="accent_tint">#FF101E30</color>
    <color name="on_accent">#FF000000</color>

    <!-- Status: the word/icon always accompanies colour. -->
    <color name="success">#FF30C96B</color>
    <color name="warning">#FFF3B34C</color>
    <color name="danger">#FFF04444</color>
    <color name="danger_tint">#FF281619</color>
    <color name="danger_outline">#FF633037</color>

    <!-- Announcements are neutral, not a second attention-grabbing accent. -->
    <color name="notice_bg">#FF151619</color>
    <color name="notice_stroke">#FF303239</color>
    <color name="notice_text">#FFF5F5F5</color>
    <color name="notice_icon">#FF92949B</color>
    <color name="notice_kicker">#FF92949B</color>

    <color name="scrim">#A3000000</color>
    <color name="ripple_none">#00000000</color>
    <color name="transparent">#00000000</color>

    <!-- Stable aliases used by existing drawables and button selectors. -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="blue">#FF2585F5</color>
</resources>
