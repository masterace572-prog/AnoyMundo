# ---------------------------------------------------------------------------
# Copy to .env.local for local development, and add these as Environment
# Variables in the Vercel project (Production + Preview + Development).
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Server-only secret. NEVER prefix this with NEXT_PUBLIC_.
# Supabase: Project Settings -> API -> service_role (legacy JWT) OR a secret key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Random 32+ char string used to sign session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Optional ------------------------------------------------------------------

# Brand shown in the sidebar / <title>
BRAND_NAME=Anoy

# Telegram handle shown on the login + register pages and in GET /connect info
# (with or without the leading @)
TELEGRAM_USERNAME=libAkAudioVisiual

# Secret word used by the /connect licensing token (must match the loader).
STATIC_WORDS=Vm8Lk7Uj2JmsjCPVPVjrLa7zgfx3uz9E

# Canonical public URL (used in docs / redirects)
PUBLIC_BASE_URL=https://your-project.vercel.app

# Max library upload size in MB (Vercel body limit is 4.5 MB)
MAX_LIB_UPLOAD_MB=4

# Fallback version string served by /api/lib/version
FALLBACK_LIB_VERSION=1.0

# DB_DRIVER=memory  -> offline demo mode (no Supabase needed), tests only
