{
  "name": "anoymundo-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PHP/CodeIgniter panel converted to Vercel serverless functions + Supabase",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "prebuild": "node scripts/build-templates.mjs && node scripts/build-css.mjs && node scripts/build-fonts.mjs",
    "build": "npm run check",
    "check": "node scripts/check.mjs",
    "dev": "node scripts/dev-server.mjs",
