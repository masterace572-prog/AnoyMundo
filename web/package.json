{
  "name": "anoymundo-panel",
  "version": "2.4.1",
  "private": true,
  "type": "module",
  "description": "Anoy licence panel: Vercel serverless functions + Supabase",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "prebuild": "node scripts/build-icons.mjs && node scripts/build-templates.mjs",
    "build": "npm run check",
    "check": "node scripts/check.mjs",
    "dev": "node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "test": "npm run test:smoke && npm run test:channels && npm run test:db",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:channels": "node --test scripts/channels-test.mjs",
    "test:db": "node scripts/channel-db-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "bcryptjs": "^2.4.3",
    "fflate": "^0.8.3",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "dotenv": "^16.4.7",
    "lucide-static": "^1.70.0"
  }
}
