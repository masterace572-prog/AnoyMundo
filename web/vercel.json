{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "regions": ["bom1"],
  "routes": [
    {
      "src": "^/assets/icons/ui-[0-9a-f]+\\.svg$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "src": "^/api/.*$", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
