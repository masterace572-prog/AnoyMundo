<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#F2F2F7">
    <meta name="color-scheme" content="light dark">
    <script>
    /* Apply the saved appearance before the stylesheets paint (no flash). */
    (function () {
      try {
        var m = localStorage.getItem('anoy-appearance') || 'system';
        if (m !== 'light' && m !== 'dark') m = 'system';
        var dark = m === 'dark' || (m === 'system' && window.matchMedia &&
          window.matchMedia('(prefers-color-scheme: dark)').matches);
        var root = document.documentElement;
        root.setAttribute('data-theme', m);
        root.setAttribute('data-theme-resolved', dark ? 'dark' : 'light');
      } catch (e) { /* private mode: follow the OS instead */ }
    })();
    </script>
    <title>{{brand}} · Sign in</title>
    <link rel="stylesheet" href="/assets/css/tailwind.css">
    <link rel="stylesheet" href="/assets/css/natacode.css">
    <link rel="stylesheet" href="/assets/css/app.css">
    <link rel="stylesheet" href="/assets/css/ios.css">
</head>
<body class="app-body auth-body">
    <main class="auth-shell">
        <div class="auth-card">
            <button type="button" class="anoy-theme-toggle auth-theme" data-theme-toggle aria-label="Change appearance" title="Change appearance">
        <svg class="anoy-theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.5 14.2A8.5 8.5 0 019.8 3.5a8.5 8.5 0 1010.7 10.7z"/></svg>
        <svg class="anoy-theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
            <div class="auth-header">
                <span class="brand-mark brand-mark-lg" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                </span>
                <p class="auth-eyebrow">{{brand}}</p>
                <h1 class="auth-title">Welcome back</h1>
                <p class="auth-subtitle">Sign in to continue.</p>
            </div>

            {{> msgStatus}}

            <form method="post" action="" class="auth-form">
                <div class="field">
                    <label for="username">Username</label>
                    <input type="text" name="username" id="username" required minlength="4" maxlength="25"
                           autocomplete="username" autofocus placeholder="Enter your username"
                           {{#if errors.username}}aria-invalid="true"{{/if}}>
                    {{#if errors.username}}<p class="field-error">{{errors.username}}</p>{{/if}}
                </div>

                <div class="field">
                    <label for="password">Password</label>
                    <input type="password" name="password" id="password" required minlength="6" maxlength="45"
                           autocomplete="current-password" placeholder="Enter your password"
                           {{#if errors.password}}aria-invalid="true"{{/if}}>
                    {{#if errors.password}}<p class="field-error">{{errors.password}}</p>{{/if}}
                </div>

                <input type="hidden" name="ip" value="{{userAgent}}" id="ip" required>

                <div class="auth-row">
                    <label class="checkbox-row" for="stay_log">
                        <input type="checkbox" name="stay_log" id="stay_log" value="yes">
                        <span>Remember me</span>
                    </label>
                    <a class="auth-link" href="/register">Create account</a>
                </div>

                <button type="submit" class="ui-btn ui-btn--primary auth-submit" data-busy-label="Signing in…">Sign In</button>
                <p class="auth-hint">Please wait — no need to press twice.</p>
            </form>

            <div class="auth-footer">
                <span>New here?</span>
                <a href="/register" class="auth-link">Create an account</a>
            </div>
        </div>

        <p class="auth-legal">
            TO BUY PANEL DM HERE :- <a href="{{telegram.url}}" target="_blank" rel="noopener">{{telegram.handle}}</a>
        </p>
    </main>

    <script src="/assets/js/app-ui.js"></script>
</body>
</html>
