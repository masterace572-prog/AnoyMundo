<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#000000">
    <meta name="color-scheme" content="dark">
    <meta name="robots" content="noindex">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <title>Sign In · {{brand}}</title>
    <link rel="stylesheet" href="/assets/css/ui.css">
</head>
<body class="auth">
<main class="auth-shell">
    <div class="auth-panel">
        <div class="auth-wordmark">{{brand}}</div>
        <h1 class="auth-title">Sign In</h1>
        <p class="muted">Use your panel account to continue.</p>

        {{> msgStatus}}

        <form method="post" action="/login" novalidate data-busy-form>
            <div class="field {{#if errors.username}}invalid{{/if}}">
                <label class="label" for="username">Username</label>
                <input class="input" type="text" name="username" id="username" value="{{old.username}}"
                       autocomplete="username" autocapitalize="none" spellcheck="false" required minlength="3" maxlength="25"
                       placeholder="Username" {{#unless old.username}}autofocus{{/unless}}>
                {{#if errors.username}}<div class="error">{{errors.username}}</div>{{/if}}
            </div>
            <div class="field {{#if errors.password}}invalid{{/if}}">
                <label class="label" for="password">Password</label>
                <div class="input-group">
                    <input class="input" type="password" name="password" id="password" autocomplete="current-password"
                           required minlength="6" maxlength="45" placeholder="Password" {{#if old.username}}autofocus{{/if}}>
                    <button type="button" class="addon-btn" data-toggle-password="password">Show</button>
                </div>
                {{#if errors.password}}<div class="error">{{errors.password}}</div>{{/if}}
            </div>
            <div class="field">
                <label class="check"><input type="checkbox" name="stay_log" id="stay_log" value="yes"> Keep me signed in</label>
            </div>
            <button type="submit" class="btn btn-primary btn-block" data-busy-label="Signing in…">Sign In</button>
        </form>

        <p class="auth-foot">Have a referral code? <a href="/register">Create an account</a><br>
            Need help? <a href="{{telegram.url}}" target="_blank" rel="noopener">{{telegram.handle}}</a></p>
    </div>
</main>
<script src="/assets/js/app-ui.js"></script>
</body>
</html>
