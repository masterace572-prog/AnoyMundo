<div class="page-head">
    <div>
        <h1 class="page-title">Edit user</h1>
        <p class="page-sub">{{target.displayName}}</p>
    </div>
    <a href="/admin/manage-users" class="btn btn-secondary">All users</a>
</div>

{{> msgStatus}}

<form method="post" action="/admin/user/{{target.id_users}}" class="form" novalidate data-busy-form>
    <input type="hidden" name="user_id" value="{{target.id_users}}">
    <div class="field {{#if errors.username}}invalid{{/if}}">
        <label class="label" for="username">Username</label>
        <input type="text" class="input" name="username" id="username" value="{{form.username}}" required minlength="4" maxlength="25" autocomplete="off" autocapitalize="none" spellcheck="false">
        {{#if errors.username}}<div class="error">{{errors.username}}</div>{{else}}<div class="hint">Renaming keeps their keys attached.</div>{{/if}}
    </div>
    <div class="field {{#if errors.fullname}}invalid{{/if}}">
        <label class="label" for="fullname">Name</label>
        <input type="text" class="input" name="fullname" id="fullname" value="{{form.fullname}}" maxlength="155" autocomplete="off">
        {{#if errors.fullname}}<div class="error">{{errors.fullname}}</div>{{/if}}
    </div>
    <div class="field {{#if errors.level}}invalid{{/if}}">
        <label class="label" for="level">Role</label>
        {{{selects.level}}}
        {{#if errors.level}}<div class="error">{{errors.level}}</div>{{/if}}
    </div>
    <div class="field {{#if errors.status}}invalid{{/if}}">
        <label class="label" for="status">Status</label>
        {{{selects.status}}}
        {{#if errors.status}}<div class="error">{{errors.status}}</div>{{/if}}
    </div>
    <div class="field {{#if errors.saldo}}invalid{{/if}}">
        <label class="label" for="saldo">Balance (₹)</label>
        <input type="number" class="input" name="saldo" id="saldo" value="{{form.saldo}}" min="0" max="999999999" step="1" inputmode="numeric" required>
        {{#if errors.saldo}}<div class="error">{{errors.saldo}}</div>{{/if}}
    </div>
    <div class="field {{#if errors.uplink}}invalid{{/if}}">
        <label class="label" for="uplink">Invited by</label>
        <input type="text" class="input" name="uplink" id="uplink" value="{{form.uplink}}" required maxlength="25" autocomplete="off">
        {{#if errors.uplink}}<div class="error">{{errors.uplink}}</div>{{/if}}
    </div>
    <div class="field {{#if errors.expiration}}invalid{{/if}}">
        <label class="label" for="expiration">Account expires (UTC)</label>
        <input type="text" class="input mono" name="expiration" id="expiration" value="{{form.expiration}}" placeholder="Never" autocomplete="off">
        {{#if errors.expiration}}<div class="error">{{errors.expiration}}</div>{{else}}<div class="hint">YYYY-MM-DD HH:MM:SS, or empty for never.</div>{{/if}}
    </div>
    <button type="submit" class="btn btn-primary btn-block" data-busy-label="Saving…">Save</button>
</form>
