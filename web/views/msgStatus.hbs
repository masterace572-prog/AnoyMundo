{{#if flash.danger}}
<div class="ui-alert ui-alert--danger" role="alert">
    <span class="ui-alert-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    </span>
    <div class="ui-alert-body"><p>{{flash.danger}}</p></div>
    <button type="button" class="ui-alert-close" onclick="this.closest('.ui-alert').remove()" aria-label="Dismiss">&times;</button>
</div>
{{else}}{{#if flash.success}}
<div class="ui-alert ui-alert--success" role="status">
    <span class="ui-alert-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    </span>
    <div class="ui-alert-body"><p>{{flash.success}}</p></div>
    <button type="button" class="ui-alert-close" onclick="this.closest('.ui-alert').remove()" aria-label="Dismiss">&times;</button>
</div>
{{else}}{{#if flash.warning}}
<div class="ui-alert ui-alert--warning" role="alert">
    <span class="ui-alert-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.94 4h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4a2 2 0 00-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z"></path></svg>
    </span>
    <div class="ui-alert-body"><p>{{flash.warning}}</p></div>
    <button type="button" class="ui-alert-close" onclick="this.closest('.ui-alert').remove()" aria-label="Dismiss">&times;</button>
</div>
{{else}}{{#if pageMessage}}
<div class="ui-alert {{alertClass pageMessage.type}}" role="status">
    <span class="ui-alert-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    </span>
    <div class="ui-alert-body"><p>{{pageMessage.text}}</p></div>
    <button type="button" class="ui-alert-close" onclick="this.closest('.ui-alert').remove()" aria-label="Dismiss">&times;</button>
</div>
{{else}}{{#if user}}
<div class="ui-alert ui-alert--info" role="status">
    <span class="ui-alert-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 10h4.8a2 2 0 011.8 2.9l-3.5 7A2 2 0 0115.3 21h-4c-.2 0-.3 0-.5-.1L7 20m7-10V5a2 2 0 00-2-2h-.1a.9.9 0 00-.9.9c0 .7-.2 1.4-.6 2L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path></svg>
    </span>
    <div class="ui-alert-body"><p>Welcome back, <strong>{{user.displayName}}</strong>.</p></div>
    <button type="button" class="ui-alert-close" onclick="this.closest('.ui-alert').remove()" aria-label="Dismiss">&times;</button>
</div>
{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}
