<div class="page-head">
    <div>
        <h1 class="page-title">Keys</h1>
        <p class="page-sub">{{keyTotal}} {{#if user.isOwner}}keys in total{{else}}keys created by you{{/if}}</p>
    </div>
    <div class="page-actions">
        <a href="/keys/download" class="btn btn-secondary" download data-no-prefetch>{{icon "download"}}Export</a>
        <a href="/keys/generate" class="btn btn-primary hide-tab">{{icon "plus"}}Generate keys</a>
    </div>
</div>

{{> msgStatus}}

<section class="card card-flush keys-card" id="keys-card">
    <!-- Sticky search, the filter below it on a phone, and "Select". -->
    <div class="keys-bar">
        <div class="input-wrap">
            {{icon "search" "lead"}}
            <input type="search" class="input" id="keys-search" placeholder="Search keys" aria-label="Search keys" autocomplete="off" spellcheck="false">
        </div>
        <select class="input" id="keys-status" aria-label="Filter by status">
            <option value="">All keys</option>
            <option value="unused">Unused</option>
            <option value="used">Active</option>
            <option value="expired">Expired</option>
            <option value="blocked">Blocked</option>
        </select>
        <span class="spacer"></span>
        <button type="button" class="btn btn-plain select-toggle" id="keys-select">Select</button>
    </div>
    <div class="keys-select-head" aria-live="polite">
        <span id="keys-selected-count">0 selected</span>
        <button type="button" class="link-btn" id="keys-select-cancel">Cancel</button>
    </div>

    <!-- Expired / Unused filter: one quiet clean-up row (the existing bulk delete and its confirm). -->
    <div class="keys-cleanup" id="keys-cleanup-expired" hidden>
        <span class="num" data-cleanup-label>Expired keys</span><span aria-hidden="true">·</span>
        <form method="post" action="/keys/deleteexp" data-confirm="Delete all expired keys?" data-confirm-detail="Expired keys stop working anyway. This cannot be undone.">
            <button type="submit" class="btn btn-plain danger" title="Delete all">Delete all</button>
        </form>
    </div>
    <div class="keys-cleanup" id="keys-cleanup-unused" hidden>
        <span class="num" data-cleanup-label>Unused keys</span><span aria-hidden="true">·</span>
        <form method="post" action="/keys/deleteunused" data-confirm="Delete all unused keys?" data-confirm-detail="Never-used keys are refunded to their creator. This cannot be undone.">
            <button type="submit" class="btn btn-plain danger" title="Delete all">Delete all</button>
        </form>
    </div>

    <!-- Empty, no-match and error states. -->
    <div class="keys-state" id="keys-state" aria-live="polite" hidden></div>

    <!-- Phone: one 72 dp row per key. -->
    <ul class="key-list" id="keys-list" aria-label="Keys">
        <li class="key-row skeleton"><div class="kr-main"><span class="sk" style="width:62%"></span><span class="sk" style="width:80%"></span></div></li>
        <li class="key-row skeleton"><div class="kr-main"><span class="sk" style="width:56%"></span><span class="sk" style="width:74%"></span></div></li>
        <li class="key-row skeleton"><div class="kr-main"><span class="sk" style="width:60%"></span><span class="sk" style="width:78%"></span></div></li>
        <li class="key-row skeleton"><div class="kr-main"><span class="sk" style="width:52%"></span><span class="sk" style="width:70%"></span></div></li>
        <li class="key-row skeleton"><div class="kr-main"><span class="sk" style="width:64%"></span><span class="sk" style="width:76%"></span></div></li>
        <li class="key-row skeleton"><div class="kr-main"><span class="sk" style="width:58%"></span><span class="sk" style="width:72%"></span></div></li>
    </ul>

    <!-- Desktop: the table, same actions. -->
    <div class="table-wrap">
        <table id="keys-table" aria-live="polite">
            <thead>
                <tr><th class="pick-cell"><span class="sr-only">Select</span></th><th>Key</th><th>Duration</th><th>Devices</th><th>Status</th><th>Expires</th>{{#if user.isOwner}}<th>Created by</th>{{/if}}<th class="actions-cell"><span class="sr-only">Actions</span></th></tr>
            </thead>
            <tbody id="keys-body">
                <tr class="skeleton"><td colspan="8"><span class="sk" style="width:62%"></span></td></tr>
                <tr class="skeleton"><td colspan="8"><span class="sk" style="width:48%"></span></td></tr>
                <tr class="skeleton"><td colspan="8"><span class="sk" style="width:56%"></span></td></tr>
                <tr class="skeleton"><td colspan="8"><span class="sk" style="width:40%"></span></td></tr>
                <tr class="skeleton"><td colspan="8"><span class="sk" style="width:52%"></span></td></tr>
                <tr class="skeleton"><td colspan="8"><span class="sk" style="width:46%"></span></td></tr>
            </tbody>
        </table>
    </div>
    <div class="pager">
        <span id="keys-range" class="num">&nbsp;</span>
        <div class="row" style="gap:4px">
            <button type="button" class="icon-btn" id="keys-prev" aria-label="Previous page" disabled>{{icon "chevron-left"}}</button>
            <button type="button" class="icon-btn" id="keys-next" aria-label="Next page" disabled>{{icon "chevron-right"}}</button>
        </div>
    </div>
</section>
<!-- Select mode: copy or delete the picked keys (each delete is the normal per-key delete + refund). -->
<div class="select-bar" id="keys-select-bar">
    <button type="button" class="btn btn-secondary" id="keys-copy-selected" disabled>{{icon "copy"}}Copy keys</button>
    <button type="button" class="btn btn-danger" id="keys-delete-selected" disabled>{{icon "trash-2"}}Delete…</button>
</div>

<script>window.ANOY_KEYS = { owner: {{#if user.isOwner}}true{{else}}false{{/if}}, user: {{{jsonScript user.username}}} };</script>
