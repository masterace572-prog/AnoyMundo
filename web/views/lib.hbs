<div class="page-head">
    <div>
        <h1 class="page-title">Library</h1>
        <p class="page-sub">Publishing a new version makes every loader update before sign-in.</p>
    </div>
    <div class="page-actions">
        <a href="/api/lib/download" class="btn btn-secondary">{{icon "download"}}Download current</a>
    </div>
</div>

{{> msgStatus}}

<section class="card" style="margin-bottom:20px">
    <div class="hero">
        <div class="tile tile-lg purple">{{icon "package"}}</div>
        <div style="flex:1;min-width:180px">
            <div class="hero-label">Current version</div>
            <div class="hero-value mono">{{currentVersion}}</div>
        </div>
        <div class="list" style="min-width:240px;flex:0 1 380px">
            <div class="list-row"><span class="lr-label">{{icon "file-archive" "i-sm"}}File</span><span class="lr-value mono">{{#if release.file_name}}{{release.file_name}}{{else}}—{{/if}}</span></div>
            <div class="list-row"><span class="lr-label">{{icon "cloud-upload" "i-sm"}}Source</span><span class="lr-value">{{#if release.external_url}}External link{{else}}{{#if release.sha256}}Stored file{{else}}<span class="status warn">Nothing published yet</span>{{/if}}{{/if}}</span></div>
            <div class="list-row"><span class="lr-label">{{icon "user" "i-sm"}}Published by</span><span class="lr-value">{{#if release.uploaded_by}}{{release.uploaded_by}}{{else}}—{{/if}}</span></div>
        </div>
    </div>
</section>

<section class="card publish-card" id="publish-card">
    <div class="card-head">
        <div class="tile">{{icon "upload"}}</div>
        <div><h2 class="card-title">Publish a release</h2><div class="card-sub">Upload a .so library or a .zip containing it (up to {{maxUploadMb}} MB), or give an https:// link.</div></div>
    </div>
    <form id="lib-form" class="form" novalidate>
        <div class="field">
            <label class="label" for="lib-version">Version</label>
            <div class="input-wrap has-trail">
                {{icon "tag" "lead"}}
                <input type="text" class="input mono" name="version" id="lib-version" value="{{suggestedVersion}}" maxlength="32" autocomplete="off" spellcheck="false">
                <div class="trail"><button type="button" class="icon-btn accent" id="lib-bump" aria-label="Bump version" title="Bump version">{{icon "plus"}}</button></div>
            </div>
            <div class="hint">Current: <span class="mono">{{currentVersion}}</span></div>
        </div>
        <div class="field">
            <span class="label">File</span>
            <label class="dropzone" id="lib-drop">
                <input type="file" name="myfile" id="lib-file" accept=".so,.zip,application/zip,application/octet-stream" aria-label="Library file">
                <span class="tile">{{icon "upload"}}</span>
                <b><span class="touch-hide">Choose a file or drop it here</span><span class="touch-only">Choose a file</span></b>
                <span class="file-name" id="lib-file-name">.so or .zip</span>
            </label>
            <button type="button" class="btn btn-plain btn-sm" id="lib-file-clear" hidden>{{icon "x"}}Remove file</button>
        </div>
        <div class="or-divider" aria-hidden="true"><span>or</span></div>
        <div class="field">
            <label class="label" for="lib-url">External link</label>
            <div class="input-wrap">{{icon "link" "lead"}}
            <input type="url" class="input" name="external_url" id="lib-url" placeholder="https://…" autocomplete="off" spellcheck="false" inputmode="url"></div>
            <div class="hint" id="lib-url-hint">Must start with https://. If you also choose a file, the file is published and this link is ignored.</div>
        </div>
        <div class="field">
            <label class="label" for="lib-notes">Notes (optional)</label>
            <div class="input-wrap">{{icon "pencil" "lead"}}
            <input type="text" class="input" name="notes" id="lib-notes" maxlength="500" autocomplete="off"></div>
        </div>
        <button type="submit" class="btn btn-primary btn-block" id="lib-submit">{{icon "upload"}}Publish</button>
        <div class="progress" id="lib-progress" hidden>
            <div class="progress-track" role="progressbar" aria-label="Upload progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="progress-fill" id="lib-progress-fill"></div></div>
            <div class="progress-meta"><span id="lib-progress-message" aria-live="polite">Preparing…</span><span id="lib-progress-percent">0%</span></div>
        </div>
        <div id="lib-result" aria-live="polite"></div>
    </form>
</section>

<script>
(function () {
    'use strict';
    var MAX = Number('{{maxUploadMb}}') * 1024 * 1024;
    var byId = function (id) { return document.getElementById(id); };

    function say(box, text, ok) {
        box.textContent = '';
        var p = document.createElement('p');
        p.className = ok ? 'hint' : 'error';
        p.style.marginTop = '12px';
        p.textContent = text;
        box.appendChild(p);
    }
    function bytes(n) {
        n = Number(n) || 0;
        if (n < 1024) return n + ' B';
        if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1048576).toFixed(2) + ' MB';
    }
    function progress(pct, message, state) {
        var box = byId('lib-progress');
        box.hidden = false;
        box.className = 'progress' + (state ? ' ' + state : '');
        var v = Math.max(0, Math.min(100, Math.round(pct)));
        byId('lib-progress-fill').style.width = v + '%';
        box.querySelector('[role=progressbar]').setAttribute('aria-valuenow', String(v));
        byId('lib-progress-percent').textContent = v + '%';
        byId('lib-progress-message').textContent = message;
    }
    function busy(btn, on, label) {
        if (on) { btn.dataset.html = btn.innerHTML; btn.textContent = label; btn.disabled = true; }
        else { if (btn.dataset.html) btn.innerHTML = btn.dataset.html; btn.disabled = false; }
    }
    function validVersion(v) { return /^[A-Za-z0-9][A-Za-z0-9._+-]{0,31}$/.test(v); }
    function validUrl(u) {
        if (!/^https:\/\/\S+$/i.test(u)) return false;
        try { return new URL(u).protocol === 'https:'; } catch (e) { return false; }
    }

    function readBase64(file, onProgress) {
        return new Promise(function (resolve, reject) {
            var reader = new FileReader();
            reader.onprogress = function (e) { if (e.lengthComputable) onProgress(e.loaded / e.total); };
            reader.onload = function () {
                var s = String(reader.result || ''); var i = s.indexOf(',');
                resolve(i >= 0 ? s.slice(i + 1) : '');
            };
            reader.onerror = function () { reject(new Error('Could not read the selected file.')); };
            reader.readAsDataURL(file);
        });
    }
    function send(payload, onProgress) {
        return new Promise(function (resolve, reject) {
            var xhr = new XMLHttpRequest();
            xhr.open('POST', '/lib', true);
            xhr.setRequestHeader('Content-Type', 'application/json');
            xhr.timeout = 120000;
            if (xhr.upload) xhr.upload.onprogress = function (e) { if (e.lengthComputable) onProgress(e.loaded, e.total); };
            xhr.onload = function () {
                var data = null;
                try { data = JSON.parse(xhr.responseText); } catch (e) { /* not JSON */ }
                if (xhr.status >= 200 && xhr.status < 300 && data && data.ok) resolve(data);
                else if (xhr.status === 413) reject(new Error('The file is too large for the server. Use an external link.'));
                else reject(new Error((data && data.error) || ('The server answered ' + xhr.status + '. Nothing was changed.')));
            };
            xhr.onerror = function () { reject(new Error('Network error. Check your connection; nothing was changed.')); };
            xhr.ontimeout = function () { reject(new Error('The upload timed out. Nothing was changed.')); };
            xhr.send(JSON.stringify(payload));
        });
    }

    var drop = byId('lib-drop'), fileInput = byId('lib-file');
    var urlHint = byId('lib-url-hint'), clearFile = byId('lib-file-clear');
    var URL_HINT = urlHint.textContent;
    function syncFile() {
        var f = fileInput.files[0];
        byId('lib-file-name').textContent = f ? f.name + ' · ' + bytes(f.size) : '.so or .zip';
        clearFile.hidden = !f;
        drop.classList.toggle('has-file', !!f);
        // File wins: say so next to the link while a file is selected.
        urlHint.textContent = f && byId('lib-url').value.trim()
            ? 'A file is selected, so this link will be ignored.' : URL_HINT;
    }
    fileInput.addEventListener('change', syncFile);
    byId('lib-url').addEventListener('input', syncFile);
    clearFile.addEventListener('click', function () { fileInput.value = ''; syncFile(); });
    ['dragenter', 'dragover'].forEach(function (t) { drop.addEventListener(t, function () { drop.classList.add('drag'); }); });
    ['dragleave', 'drop'].forEach(function (t) { drop.addEventListener(t, function () { drop.classList.remove('drag'); }); });

    byId('lib-bump').addEventListener('click', function () {
        var el = byId('lib-version'); var m = el.value.trim().match(/^(.*?)(\d+)$/);
        el.value = m ? m[1] + (Number(m[2]) + 1) : '1.1';
    });

    var form = byId('lib-form'), button = byId('lib-submit'), result = byId('lib-result');
    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (button.disabled) return;
        var file = byId('lib-file').files[0];
        var url = byId('lib-url').value.trim();
        var version = byId('lib-version').value.trim();
        result.textContent = '';
        if (file) url = ''; // File wins: the link is ignored.
        if (!validVersion(version)) return say(result, 'Enter a version like 1.3.');
        if (!file && !url) return say(result, 'Choose a file or enter an https:// link.');
        if (url && !validUrl(url)) return say(result, 'The link must be a full https:// address (http:// is not allowed).');
        if (file && file.size > MAX) return say(result, 'The file is larger than {{maxUploadMb}} MB. Use an external link instead.');
        if (file && file.size < 4) return say(result, 'The selected file is empty.');
        busy(button, true, 'Publishing…');
        progress(1, 'Reading file…');
        var prepare = file ? readBase64(file, function (f) { progress(1 + f * 19, 'Reading file…'); }) : Promise.resolve('');
        prepare.then(function (b64) {
            progress(20, file ? 'Uploading ' + bytes(file.size) + '…' : 'Saving link…');
            return send({
                action: 'upload', version: version, notes: byId('lib-notes').value.trim(), external_url: url,
                file_name: file ? file.name : '', content_base64: b64
            }, function (loaded, total) { progress(20 + (loaded / total) * 75, 'Uploading… ' + bytes(loaded) + ' of ' + bytes(total)); });
        }).then(function (data) {
            progress(100, 'Published', 'done');
            say(result, 'Version ' + data.version + ' is live. Reloading…', true);
            setTimeout(function () { location.reload(); }, 1200);
        }).catch(function (err) {
            progress(100, 'Failed', 'error');
            say(result, (err && err.message ? err.message : 'Publishing failed.') + ' The previous version is still active.');
            busy(button, false);
        });
    });

})();
</script>
