<div class="container-fluid px-4 py-6">
    <div class="mb-6">{{> msgStatus}}</div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Current release -->
        <div class="ui-card rounded-2xl p-6 sm:p-8 animate-fade-in-up">
            <div class="flex items-center mb-6">
                <div class="ui-icon w-12 h-12 rounded-xl flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-800">Current Library</h2>
            </div>
            <div class="space-y-2 text-sm text-gray-700">
                <p><strong>File:</strong> <span class="font-mono">{{lib.file}}</span></p>
                <p><strong>Size:</strong> {{lib.file_size}}</p>
                <p><strong>ID:</strong> {{lib.id}}</p>
                <p><strong>Path:</strong> <span class="font-mono">{{lib.file_type}}</span></p>
                <p><strong>Last modified:</strong> {{lib.time}}</p>
                <p><strong>Current time:</strong> {{lib.currentTime}}</p>
                <p><strong>Version endpoint:</strong> <code>/api/lib/version</code></p>
                <p><strong>Download endpoint:</strong> <code>/api/lib/download</code></p>
            </div>
            <div class="mt-6 flex flex-wrap gap-3">
                <a href="/api/lib/download" class="px-4 py-2 text-white rounded-lg ui-btn">Download</a>
                <a href="/Server" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-lg">Online System</a>
            </div>
        </div>

        <!-- Upload -->
        <div class="ui-card rounded-2xl p-6 sm:p-8 animate-fade-in-up" style="animation-delay: 0.1s">
            <div class="flex items-center mb-6">
                <div class="ui-icon w-12 h-12 rounded-xl flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-800">Upload Library</h2>
            </div>

            <p class="text-sm text-gray-600 mb-4">
                Upload the ZIP/SO the Android loader downloads, or point it at an external URL.
                Files are stored in Supabase because Vercel's filesystem is read-only.
                Maximum size: {{maxUploadMb}} MB.
            </p>

            <form id="lib-form" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Version</label>
                    <input type="text" name="version" id="lib-version" value="1.0" class="w-full px-4 py-3 bg-white/50 border border-gray-200 rounded-xl">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">File (ZIP / SO)</label>
                    <input type="file" name="myfile" id="lib-file" class="w-full px-4 py-3 bg-white/50 border border-gray-200 rounded-xl">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Or external URL (optional)</label>
                    <input type="url" name="external_url" id="lib-url" placeholder="https://..." class="w-full px-4 py-3 bg-white/50 border border-gray-200 rounded-xl">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Notes (optional)</label>
                    <input type="text" name="notes" id="lib-notes" class="w-full px-4 py-3 bg-white/50 border border-gray-200 rounded-xl">
                </div>
                <button type="submit" id="lib-submit" class="w-full py-3 px-6 text-white font-bold rounded-xl ui-btn">Upload</button>
            </form>
            <div id="lib-result" class="mt-4 text-sm"></div>
        </div>
    </div>
</div>

<script>
document.getElementById('lib-form').addEventListener('submit', async function (e) {
    e.preventDefault();
    const button = document.getElementById('lib-submit');
    const result = document.getElementById('lib-result');
    const file = document.getElementById('lib-file').files[0];
    const externalUrl = document.getElementById('lib-url').value.trim();
    if (!file && !externalUrl) { result.textContent = 'Choose a file or enter an external URL.'; return; }
    button.disabled = true;
    result.textContent = 'Uploading, please wait...';
    try {
        let content_base64 = '';
        if (file) {
            const buffer = await file.arrayBuffer();
            let binary = '';
            const bytes = new Uint8Array(buffer);
            for (let i = 0; i < bytes.length; i += 0x8000) {
                binary += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
            }
            content_base64 = btoa(binary);
        }
        const payload = {
            version: document.getElementById('lib-version').value.trim() || '1.0',
            file_name: file ? file.name : (externalUrl.split('/').pop() || 'release.zip'),
            content_base64,
            external_url: externalUrl,
            notes: document.getElementById('lib-notes').value.trim()
        };
        const response = await fetch('/lib', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (data.ok) {
            result.innerHTML = '<span class="text-green-700">Uploaded: ' + data.file_name + ' (' + data.file_size + ' bytes)</span>';
            setTimeout(() => window.location.reload(), 1200);
        } else {
            result.innerHTML = '<span class="text-red-700">' + (data.error || 'Upload failed') + '</span>';
        }
    } catch (err) {
        result.innerHTML = '<span class="text-red-700">' + err.message + '</span>';
    } finally {
        button.disabled = false;
    }
});
</script>
