<div class="page-head" data-release-channel="{{releaseChannel}}">
    <div>
        <h1 class="page-title">Library</h1>
        <p class="page-sub">{{releaseBrand}} library. Only this channel is changed when you publish.</p>
    </div>
    <div class="page-actions">
        <a href="/api/lib/download?channel={{releaseChannel}}" class="btn btn-secondary">{{icon "download"}}Download current</a>
    </div>
</div>

{{> msgStatus}}
{{> release_channel}}
{{#if cleanupPending}}<p class="hint" role="status">Old files are queued for automatic cleanup. Current downloads have a short grace period.</p>{{/if}}

<section class="card" style="margin-bottom:20px">
    <div class="hero">
        <div class="tile tile-lg purple">{{icon "package"}}</div>
        <div style="flex:1;min-width:180px">
            <div class="hero-label">Current version</div>
            <div class="hero-value mono">{{#if currentVersion}}{{currentVersion}}{{else}}—{{/if}}</div>
            <button type="button" class="btn btn-secondary btn-sm" id="lib-reset" style="margin-top:12px">{{icon "rotate-ccw"}}Reset to 0.1</button>
            <div id="reset-result" aria-live="polite"></div>
        </div>
        <div class="list" style="min-width:240px;flex:0 1 380px">
            <div class="list-row"><span class="lr-label">{{icon "file-archive" "i-sm"}}File</span><span class="lr-value mono">{{#if release.file_name}}{{release.file_name}}{{else}}—{{/if}}</span></div>
            <div class="list-row"><span class="lr-label">{{icon "cloud-upload" "i-sm"}}Source</span><span class="lr-value">{{#if release.external_url}}External link{{else}}{{#if release.sha256}}Stored file{{else}}<span class="status warn">Nothing published yet</span>{{/if}}{{/if}}</span></div>
            <div class="list-row"><span class="lr-label">{{icon "user" "i-sm"}}Published by</span><span class="lr-value">{{#if release.uploaded_by}}{{release.uploaded_by}}{{else}}—{{/if}}</span></div>
        </div>
    </div>
</section>

<section class="card" style="margin-bottom:20px" id="game-card">
    <div class="card-head">
        <div class="tile">{{icon "gamepad-2"}}</div>
        <div><h2 class="card-title">Works with BGMI</h2><div class="card-sub">Newer BGMI shows a “wait for update” note. Empty = no note.</div></div>
    </div>
    <div id="game-form" class="form">
        <div class="field">
            <label class="label" for="game-version">BGMI version</label>
            <div class="input-wrap">{{icon "tag" "lead"}}
            <input type="text" class="input mono" name="game_version" id="game-version" value="{{release.game_version}}" placeholder="3.9.0" maxlength="32" autocomplete="off" spellcheck="false" inputmode="decimal"></div>
        </div>
        <button type="button" class="btn btn-secondary btn-block" id="game-submit">{{icon "check"}}Save</button>
        <div id="game-result" aria-live="polite"></div>
    </div>
</section>

<section class="card publish-card" id="publish-card">
    <div class="card-head">
        <div class="tile">{{icon "upload"}}</div>
        <div><h2 class="card-title">Publish a release</h2><div class="card-sub">A .so or .zip, up to {{maxUploadMb}} MB uploaded and {{maxUploadMb}} MB total unpacked, or an HTTPS link. ZIPs can include libbgmi.so and libbgmilite.so together. Old files clear automatically.</div></div>
    </div>
    <form id="lib-form" class="form" novalidate>
        <div class="field">
            <label class="label" for="lib-version">Version</label>
            <div class="input-wrap has-trail">
                {{icon "tag" "lead"}}
                <input type="text" class="input mono" name="version" id="lib-version" value="{{suggestedVersion}}" maxlength="32" autocomplete="off" spellcheck="false">
                <div class="trail"><button type="button" class="icon-btn accent" id="lib-bump" aria-label="Bump version" title="Bump version">{{icon "plus"}}</button></div>
            </div>
            <div class="hint">Current: <span class="mono">{{currentVersion}}</span>. Steps of 0.1: 1.9 is followed by 2.0.
                <button type="button" class="btn btn-plain btn-sm" id="lib-zero">{{icon "rotate-ccw"}}Use 0.1</button></div>
        </div>
        <div class="field">
            <span class="label">File</span>
            <label class="dropzone" id="lib-drop">
                <input type="file" name="myfile" id="lib-file" accept=".so,.zip,application/zip,application/octet-stream" aria-label="Library file">
                <span class="tile">{{icon "upload"}}</span>
                <b><span class="touch-hide">Choose a file or drop it here</span><span class="touch-only">Choose a file</span></b>
                <span class="file-name" id="lib-file-name">.so or .zip</span>
            </label>
            <button type="button" class="btn btn-plain btn-sm" id="lib-file-clear" hidden>{{icon "x"}}Remove file</button>
        </div>
        <div class="or-divider" aria-hidden="true"><span>or</span></div>
        <div class="field">
            <label class="label" for="lib-url">External link</label>
            <div class="input-wrap">{{icon "link" "lead"}}
            <input type="url" class="input" name="external_url" id="lib-url" placeholder="https://…" autocomplete="off" spellcheck="false" inputmode="url"></div>
            <div class="hint" id="lib-url-hint">https:// only. A chosen file wins over the link.</div>
        </div>
        <div class="field">
            <label class="label" for="lib-notes">Notes (optional)</label>
            <div class="input-wrap">{{icon "pencil" "lead"}}
            <input type="text" class="input" name="notes" id="lib-notes" maxlength="500" autocomplete="off"></div>
        </div>
        <button type="submit" class="btn btn-primary btn-block" id="lib-submit">{{icon "upload"}}Publish</button>
        <div class="progress" id="lib-progress" hidden>
            <div class="progress-track" role="progressbar" aria-label="Upload progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="progress-fill" id="lib-progress-fill"></div></div>
            <div class="progress-meta"><span id="lib-progress-message" aria-live="polite">Preparing…</span><span id="lib-progress-percent">0%</span></div>
        </div>
        <div id="lib-result" aria-live="polite"></div>
    </form>
</section>

<script>
(function () {
    'use strict';
    var MAX = Number('{{maxUploadMb}}') * 1024 * 1024;
    var channel = '{{releaseChannel}}';
    var byId = function (id) { return document.getElementById(id); };

    function say(box, text, ok) {
        box.textContent = '';
        var p = document.createElement('p');
        p.className = ok ? 'hint' : 'error';
        p.style.marginTop = '12px';
        p.textContent = text;
        box.appendChild(p);
    }
    function bytes(n) {
        n = Number(n) || 0;
        if (n < 1024) return n + ' B';
        if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1048576).toFixed(2) + ' MB';
    }
    function progress(pct, message, state) {
        var box = byId('lib-progress');
        box.hidden = false;
        box.className = 'progress' + (state ? ' ' + state : '');
        var v = Math.max(0, Math.min(100, Math.round(pct)));
        byId('lib-progress-fill').style.width = v + '%';
        box.querySelector('[role=progressbar]').setAttribute('aria-valuenow', String(v));
        byId('lib-progress-percent').textContent = v + '%';
        byId('lib-progress-message').textContent = message;
    }
    function busy(btn, on, label) {
        if (on) { btn.dataset.html = btn.innerHTML; btn.textContent = label; btn.disabled = true; }
        else { if (btn.dataset.html) btn.innerHTML = btn.dataset.html; btn.disabled = false; }
    }
    function validVersion(v) { return /^[A-Za-z0-9][A-Za-z0-9._+-]{0,31}$/.test(v); }
    function validUrl(u) {
        if (!/^https:\/\/\S+$/i.test(u)) return false;
        try { return new URL(u).protocol === 'https:'; } catch (e) { return false; }
    }

    function uploadFile(url, file) {
        return new Promise(function (resolve, reject) {
            var xhr = new XMLHttpRequest();
            xhr.open('PUT', url, true);
            xhr.setRequestHeader('Content-Type', 'application/octet-stream');
            xhr.timeout = 180000;
            xhr.upload.onprogress = function (e) {
                if (e.lengthComputable) progress(5 + 80 * e.loaded / e.total, 'Uploading… ' + bytes(e.loaded) + ' of ' + bytes(e.total));
            };
            xhr.onload = function () {
                if (xhr.status >= 200 && xhr.status < 300) resolve();
                else reject(new Error('Storage upload failed (HTTP ' + xhr.status + '). Try again.'));
            };
            xhr.onerror = function () { reject(new Error('Storage upload failed. Check your connection.')); };
            xhr.ontimeout = function () { reject(new Error('The upload timed out. Try again.')); };
            xhr.send(file);
        });
    }
    function send(payload, onProgress) {
        payload.channel = channel;
        return new Promise(function (resolve, reject) {
            var xhr = new XMLHttpRequest();
            xhr.open('POST', '/lib', true);
            xhr.setRequestHeader('Content-Type', 'application/json');
            xhr.timeout = 120000;
            if (xhr.upload) xhr.upload.onprogress = function (e) { if (e.lengthComputable) onProgress(e.loaded, e.total); };
            xhr.onload = function () {
                var data = null;
                try { data = JSON.parse(xhr.responseText); } catch (e) { /* not JSON */ }
                if (xhr.status >= 200 && xhr.status < 300 && data && data.ok) resolve(data);
                else if (xhr.status === 413) reject(new Error('The upload exceeds the supported limit. Choose a smaller .so or ZIP.'));
                else reject(new Error((data && data.error) || ('The server answered ' + xhr.status + '. Reload before retrying.')));
            };
            xhr.onerror = function () { reject(new Error('Network error. Check your channel before retrying.')); };
            xhr.ontimeout = function () { reject(new Error('Publication timed out. Reload your library page before retrying.')); };
            xhr.send(JSON.stringify(payload));
        });
    }

    var drop = byId('lib-drop'), fileInput = byId('lib-file');
    var urlHint = byId('lib-url-hint'), clearFile = byId('lib-file-clear');
    var URL_HINT = urlHint.textContent;
    function syncFile() {
        var f = fileInput.files[0];
        byId('lib-file-name').textContent = f ? f.name + ' · ' + bytes(f.size) : '.so or .zip';
        clearFile.hidden = !f;
        drop.classList.toggle('has-file', !!f);
        // File wins: say so next to the link while a file is selected.
        urlHint.textContent = f && byId('lib-url').value.trim()
            ? 'A file is selected, so this link will be ignored.' : URL_HINT;
    }
    fileInput.addEventListener('change', syncFile);
    byId('lib-url').addEventListener('input', syncFile);
    clearFile.addEventListener('click', function () { fileInput.value = ''; syncFile(); });
    ['dragenter', 'dragover'].forEach(function (t) { drop.addEventListener(t, function () { drop.classList.add('drag'); }); });
    ['dragleave', 'drop'].forEach(function (t) { drop.addEventListener(t, function () { drop.classList.remove('drag'); }); });

    // Same rule as bumpVersion() in src/app.mjs: 0.1 steps, 1.9 -> 2.0, 1.27 -> 1.3.
    function bump(v) {
        v = String(v || '').trim();
        var d = v.match(/^(\d+)\.(\d+)$/);
        if (d) { var t = Number(d[1]) * 10 + Number(d[2].charAt(0)) + 1; return Math.floor(t / 10) + '.' + (t % 10); }
        if (/^\d+$/.test(v)) return v + '.1';
        var m = v.match(/^(.*?)(\d+)$/);
        return m ? m[1] + (Number(m[2]) + 1) : '0.1';
    }
    byId('lib-bump').addEventListener('click', function () {
        var el = byId('lib-version'); el.value = bump(el.value);
    });
    byId('lib-zero').addEventListener('click', function () { byId('lib-version').value = '0.1'; });

    // Reset: the current release is renamed 0.1 (same file); phones download it once more.
    var resetButton = byId('lib-reset'), resetResult = byId('reset-result');
    resetButton.addEventListener('click', function () {
        if (resetButton.disabled) return;
        var ask = window.anoyConfirm
            ? window.anoyConfirm('Reset the version to 0.1?', 'The current library stays the same, only its number changes. Every phone downloads it once more.', 'Reset', false)
            : Promise.resolve(window.confirm('Reset the version to 0.1?'));
        ask.then(function (yes) {
            if (!yes) return;
            busy(resetButton, true, 'Resetting…');
            send({ action: 'reset' }, function () {}).then(function () {
                say(resetResult, 'Version is now 0.1. Reloading…', true);
                setTimeout(function () { location.reload(); }, 1000);
            }).catch(function (err) {
                say(resetResult, (err && err.message) || 'Could not reset.');
                busy(resetButton, false);
            });
        });
    });

    var gameButton = byId('game-submit'), gameResult = byId('game-result');
    byId('game-version').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); saveGame(); }
    });
    gameButton.addEventListener('click', saveGame);
    function saveGame() {
        if (gameButton.disabled) return;
        var value = byId('game-version').value.trim();
        gameResult.textContent = '';
        if (value && !/^\d{1,4}(\.\d{1,6}){0,3}$/.test(value)) return say(gameResult, 'Use numbers like 3.9.0, or leave it empty.');
        busy(gameButton, true, 'Saving…');
        send({ action: 'game', game_version: value }, function () {}).then(function (data) {
            say(gameResult, data.game_version ? 'Saved. Works with BGMI ' + data.game_version + '.' : 'Saved. BGMI warning is off.', true);
            busy(gameButton, false);
        }).catch(function (err) {
            say(gameResult, (err && err.message) || 'Could not save.');
            busy(gameButton, false);
        });
    }

    var form = byId('lib-form'), button = byId('lib-submit'), result = byId('lib-result');
    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (button.disabled) return;
        var file = byId('lib-file').files[0];
        var url = byId('lib-url').value.trim();
        var version = byId('lib-version').value.trim();
        result.textContent = '';
        if (file) url = ''; // File wins: the link is ignored.
        if (!validVersion(version)) return say(result, 'Enter a version like 1.3.');
        if (!file && !url) return say(result, 'Choose a file or enter an https:// link.');
        if (url && !validUrl(url)) return say(result, 'The link must be a full https:// address (http:// is not allowed).');
        if (file && file.size > MAX) return say(result, 'The file is larger than {{maxUploadMb}} MB. Choose a smaller .so or ZIP.');
        if (file && file.size < 4) return say(result, 'The selected file is empty.');
        busy(button, true, 'Publishing…');
        progress(1, file ? 'Preparing secure upload…' : 'Saving link…');
        var pendingUpload = '';
        var prepare = file
            ? send({ action: 'prepare_upload', file_size: file.size, file_name: file.name }, function () {})
                .then(function (ticket) {
                    pendingUpload = ticket.upload_path;
                    return uploadFile(ticket.upload_url, file).then(function () { return ticket.upload_path; });
                })
            : Promise.resolve('');
        prepare.then(function (uploadPath) {
            progress(90, file ? 'Verifying and publishing as libbgmi.so…' : 'Publishing link…');
            return send({
                action: 'upload', version: version, notes: byId('lib-notes').value.trim(), external_url: url,
                upload_path: uploadPath
            }, function () {});
        }).then(function (data) {
            progress(100, 'Published', 'done');
            say(result, 'Version ' + data.version + ' is live.' + (data.cleanup_pending ? ' Old files will be cleaned automatically.' : ' Old stored files cleaned.') + ' Reloading…', true);
            setTimeout(function () { location.reload(); }, 1200);
        }).catch(function (err) {
            if (pendingUpload) send({ action: 'cancel_upload', upload_path: pendingUpload }, function () {}).catch(function () {});
            progress(100, 'Failed', 'error');
            say(result, (err && err.message ? err.message : 'Could not confirm publication. Reload your library page before retrying.'));
            busy(button, false);
        });
    });

})();
</script>
