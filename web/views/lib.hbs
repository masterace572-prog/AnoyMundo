<div class="container-fluid px-4 py-6">
    <div class="mb-6">{{> msgStatus}}</div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Current release -->
        <div class="ui-card rounded-2xl p-6 sm:p-8 animate-fade-in-up">
            <div class="flex items-center mb-6">
                <div class="ui-icon w-12 h-12 rounded-xl flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-800">Current Library</h2>
            </div>
            <div class="space-y-2 text-sm text-gray-700">
                <p><strong>File:</strong> <span class="font-mono">{{lib.file}}</span></p>
                <p><strong>Size:</strong> {{lib.file_size}}</p>
                <p><strong>ID:</strong> {{lib.id}}</p>
                <p><strong>Path:</strong> <span class="font-mono">{{lib.file_type}}</span></p>
                <p><strong>Last modified:</strong> {{lib.time}}</p>
                <p><strong>Current time:</strong> {{lib.currentTime}}</p>
                <p><strong>Version endpoint:</strong> <code>/api/lib/version</code></p>
                <p><strong>Download endpoint:</strong> <code>/api/lib/download</code></p>
            </div>
            <div class="mt-6 flex flex-wrap gap-3">
                <a href="/api/lib/download" class="ui-btn">Download</a>
                <a href="/Server" class="ui-btn">Online system</a>
            </div>
        </div>

        <!-- Upload -->
        <div class="ui-card rounded-2xl p-6 sm:p-8 animate-fade-in-up" style="animation-delay: 0.1s">
            <div class="flex items-center mb-6">
                <div class="ui-icon w-12 h-12 rounded-xl flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-800">Upload Library</h2>
            </div>

            <p class="text-sm text-gray-600 mb-4">
                Upload the ZIP/SO the Android loader downloads, or point it at an external URL.
                Files are stored in Supabase because Vercel's filesystem is read-only.
                Maximum size: {{maxUploadMb}} MB.
            </p>

            <form id="lib-form" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Version</label>
                    <input type="text" name="version" id="lib-version" value="1.0" class="w-full px-4 py-3 bg-white/50 border border-gray-200 rounded-xl">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">File (ZIP / SO)</label>
                    <input type="file" name="myfile" id="lib-file" class="w-full px-4 py-3 bg-white/50 border border-gray-200 rounded-xl">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Or external URL (optional)</label>
                    <input type="url" name="external_url" id="lib-url" placeholder="https://..." class="w-full px-4 py-3 bg-white/50 border border-gray-200 rounded-xl">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Notes (optional)</label>
                    <input type="text" name="notes" id="lib-notes" class="w-full px-4 py-3 bg-white/50 border border-gray-200 rounded-xl">
                </div>
                <button type="submit" id="lib-submit" class="w-full py-3 px-6 text-white font-bold rounded-xl ui-btn ui-btn--primary" data-busy-label="Uploading…">Upload</button>
            </form>

            <div id="lib-progress" class="anoy-progress" hidden>
                <div class="anoy-progress__head">
                    <span class="anoy-progress__message" id="lib-progress-message" aria-live="polite">Preparing upload…</span>
                    <span class="anoy-progress__percent" id="lib-progress-percent">0%</span>
                </div>
                <div class="anoy-progress__track" id="lib-progress-track" role="progressbar"
                     aria-label="Library upload progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                    <span class="anoy-progress__fill" id="lib-progress-fill"></span>
                </div>
                <p class="anoy-progress__hint" id="lib-progress-detail">Keep this tab open until the release is saved.</p>
            </div>
            <div id="lib-result" class="mt-4 text-sm" aria-live="polite"></div>
        </div>
    </div>
</div>

<script>
/* Real upload progress. XHR gives byte-level upload events; fetch does not. */
(function () {
    'use strict';
    var form = document.getElementById('lib-form');
    var button = document.getElementById('lib-submit');
    var result = document.getElementById('lib-result');
    var progress = document.getElementById('lib-progress');
    if (!form || !button || !result || !progress) return;

    function ui() { return window.AnoyUI || null; }

    function setProgress(pct, message, detail, state) {
        var U = ui();
        if (U && U.setProgress) { U.setProgress(progress, pct, message, detail, state); return; }
        progress.hidden = false;
        var fill = document.getElementById('lib-progress-fill');
        var pctEl = document.getElementById('lib-progress-percent');
        var msgEl = document.getElementById('lib-progress-message');
        var p = Math.max(0, Math.min(100, Math.round(pct)));
        if (fill) fill.style.width = p + '%';
        if (pctEl) pctEl.textContent = p + '%';
        if (msgEl) msgEl.textContent = message;
    }

    function busy(on) {
        var U = ui();
        if (U && U.busyButton && U.releaseButton) {
            if (on) U.busyButton(button, 'Uploading…'); else U.releaseButton(button);
        } else {
            button.disabled = !!on;
        }
    }

    function bytes(n) {
        var U = ui();
        return (U && U.humanBytes) ? U.humanBytes(n) : (Math.round((Number(n) || 0) / 1024) + ' KB');
    }

    /* Server-provided text is always inserted as text, never as HTML. */
    function status(text, kind) {
        result.textContent = '';
        var box = document.createElement('div');
        box.className = 'ui-status' + (kind ? ' ui-status--' + kind : '');
        var dot = document.createElement('span');
        dot.className = 'ui-status__dot';
        dot.setAttribute('aria-hidden', 'true');
        var label = document.createElement('span');
        label.textContent = text;
        box.appendChild(dot);
        box.appendChild(label);
        result.appendChild(box);
    }

    function encode(file, onProgress) {
        return new Promise(function (resolve, reject) {
            var reader = new FileReader();
            reader.onprogress = function (e) {
                if (e.lengthComputable && e.total) onProgress(e.loaded / e.total);
            };
            reader.onload = function () {
                var dataUrl = String(reader.result || '');
                var comma = dataUrl.indexOf(',');
                resolve(comma >= 0 ? dataUrl.slice(comma + 1) : '');
            };
            reader.onerror = function () { reject(new Error('Could not read the selected file.')); };
            reader.onabort = function () { reject(new Error('Reading the file was cancelled.')); };
            reader.readAsDataURL(file);
        });
    }

    function send(payload, onProgress) {
        return new Promise(function (resolve, reject) {
            var xhr = new XMLHttpRequest();
            xhr.open('POST', '/lib', true);
            xhr.setRequestHeader('Content-Type', 'application/json');
            xhr.timeout = 120000;
            xhr.upload.onprogress = function (e) {
                if (e.lengthComputable) onProgress(e.loaded, e.total);
            };
            xhr.upload.onload = function () { onProgress(1, 1); };
            xhr.onload = function () {
                var data = null;
                try { data = JSON.parse(xhr.responseText); } catch (e) { /* not JSON */ }
                if (xhr.status >= 200 && xhr.status < 300 && data) resolve(data);
                else reject(new Error((data && data.error) || ('Upload failed (HTTP ' + xhr.status + ')')));
            };
            xhr.onerror = function () { reject(new Error('Network error while uploading.')); };
            xhr.ontimeout = function () { reject(new Error('The upload timed out. Try a smaller file.')); };
            xhr.send(JSON.stringify(payload));
        });
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (form.getAttribute('data-anoy-upload-busy') === '1') return;

        var file = document.getElementById('lib-file').files[0];
        var externalUrl = document.getElementById('lib-url').value.trim();
        if (!file && !externalUrl) {
            status('Choose a file or enter an external URL.', 'error');
            return;
        }

        form.setAttribute('data-anoy-upload-busy', '1');
        result.textContent = '';
        busy(true);
        setProgress(0, 'Preparing upload…', 'Keep this tab open until the release is saved.', 'working');

        var succeeded = false;
        var version = document.getElementById('lib-version').value.trim() || '1.0';
        var notes = document.getElementById('lib-notes').value.trim();
        var start = file ? 24 : 8;

        var prepare = file
            ? encode(file, function (frac) {
                  setProgress(2 + frac * (start - 2), 'Reading file…',
                      bytes(file.size) + ' selected · ' + file.name, 'working');
              })
            : Promise.resolve('');

        prepare.then(function (contentBase64) {
            setProgress(start, 'Uploading…',
                file ? ('Sending ' + bytes(file.size)) : 'Saving external URL…', 'working');
            var payload = {
                version: version,
                file_name: file ? file.name : (externalUrl.split('/').pop() || 'release.zip'),
                content_base64: contentBase64,
                external_url: externalUrl,
                notes: notes
            };
            return send(payload, function (loaded, total) {
                var frac = total ? loaded / total : 0;
                setProgress(start + frac * (94 - start), 'Uploading…',
                    bytes(loaded) + ' of ' + bytes(total) + ' sent', 'working');
            });
        }).then(function (data) {
            if (!data.ok) throw new Error(data.error || 'Upload failed');
            setProgress(96, 'Saving release…', 'Writing the new version to the panel.', 'working');
            return data;
        }).then(function (data) {
            succeeded = true;
            setProgress(100, 'Upload complete', data.file_name + ' · ' + bytes(data.file_size), 'done');
            /* The button stays locked until reload; stop calling it "Uploading". */
            var lbl = button.querySelector('.ui-btn__busy-label');
            if (lbl) lbl.textContent = 'Uploaded';
            var sp = button.querySelector('.ui-spinner');
            if (sp) sp.style.display = 'none';
            status('Uploaded ' + data.file_name + ' (' + bytes(data.file_size) + '). Refreshing…', 'success');
            window.setTimeout(function () { window.location.reload(); }, 1600);
        }).catch(function (err) {
            var message = (err && err.message) ? err.message : 'Upload failed.';
            setProgress(100, 'Upload failed', message, 'error');
            status(message, 'error');
        }).then(function () {
            /* Keep the button locked on success: the page is about to reload. */
            if (succeeded) return;
            form.removeAttribute('data-anoy-upload-busy');
            busy(false);
        });
    });
})();
</script>
