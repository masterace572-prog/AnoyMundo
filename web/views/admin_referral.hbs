<div class="page-head">
    <div>
        <h1 class="page-title">Referral codes</h1>
        <p class="page-sub">A code lets one person create a panel account.</p>
    </div>
</div>

{{> msgStatus}}

<div class="grid-2">
<form method="post" action="/admin/create-referral" class="form" novalidate data-busy-form>
    <div class="field {{#if errors.accLevel}}invalid{{/if}}">
        <label class="label" for="accLevel">Role</label>
        {{{selects.accLevel}}}
        {{#if errors.accLevel}}<div class="error">{{errors.accLevel}}</div>{{/if}}
    </div>
    <div class="field {{#if errors.accExpire}}invalid{{/if}}">
        <label class="label" for="accExpire">Account lasts</label>
        {{{selects.accExpire}}}
        {{#if errors.accExpire}}<div class="error">{{errors.accExpire}}</div>{{/if}}
    </div>
    <div class="field {{#if errors.set_saldo}}invalid{{/if}}">
        <label class="label" for="set_saldo">Starting balance (₹)</label>
        <input type="number" class="input" name="set_saldo" id="set_saldo" min="0" max="99999" step="1" inputmode="numeric" required value="{{#if old.set_saldo}}{{old.set_saldo}}{{else}}0{{/if}}">
        {{#if errors.set_saldo}}<div class="error">{{errors.set_saldo}}</div>{{else}}<div class="hint">{{#if unlimited}}Taken from your unlimited balance.{{else}}Taken from your balance (₹{{user.saldoLabel}}).{{/if}}</div>{{/if}}
    </div>
    <button type="submit" class="btn btn-primary btn-block" data-busy-label="Creating…">Create code</button>
</form>

<section class="section" style="border-top:0;padding-top:0">
    <h2 class="section-title">Recent codes</h2>
    <p class="section-sub">{{totalCodes}} in total</p>
    <div class="table-wrap">
        <table class="responsive">
            <thead><tr><th>Code</th><th>Role</th><th>Balance</th><th>Used by</th></tr></thead>
            <tbody>
                {{#each codes}}
                <tr>
                    <td class="key" data-label="Code">{{this.referral}}</td>
                    <td data-label="Role">{{this.levelName}}</td>
                    <td data-label="Balance">{{this.saldoLabel}}</td>
                    <td data-label="Used by">{{#if this.used_by}}{{this.used_by}}{{else}}<span class="status unused">Available</span>{{/if}}</td>
                </tr>
                {{else}}
                <tr class="is-empty"><td colspan="4">No codes yet.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</section>
</div>
