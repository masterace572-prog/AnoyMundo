



<div class="container-fluid px-4 py-6">
    <!-- Message Status -->
    <div class="mb-6">
        {{> msgStatus}}
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Server Maintenance Card -->
        {{#if (neq user.level 2)}}
        <div class="ui-card rounded-2xl p-6 sm:p-8 animate-fade-in-up">
            <div class="flex items-center mb-6">
                <div class="ui-icon w-12 h-12 rounded-xl flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
                    </svg>
                </div>
                <h2 class="ui-section-title">Maintenance</h2>
            </div>
            
            <form method="post" action="" class="space-y-6">
                <input type="hidden" name="status_form" value="1">
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Status: <span class="text-purple-600 font-semibold">{{onoff.status}}</span>
                    </label>
                    
                    <label class="ui-switch">
                            <input type="checkbox" name="radios" value="on" {{#if (eq onoff.status "on")}} checked {{/if}}>
                            <span class="ui-switch__track" aria-hidden="true"><span class="ui-switch__thumb"></span></span>
                            <span class="ui-switch__label">Maintenance mode</span>
                        </label>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Offline message
                    </label>
                    <textarea 
                        name="myInput" 
                        rows="3" 
                        class="w-full px-4 py-3 bg-white/50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 transition-all"
                        placeholder="Server is Under Maintenance"
                    ></textarea>
                </div>
                
                <button type="submit" class="w-full py-3 px-6 text-white font-bold rounded-xl transition-all duration-300 shadow-lg ui-btn ui-btn--primary">
                    Save
                </button>
            </form>
        </div>
        {{/if}}
        
        <!-- Mod Features Card -->
        <div class="ui-card rounded-2xl p-6 sm:p-8 animate-fade-in-up" style="animation-delay: 0.1s">
            <div class="flex items-center mb-6">
                <div class="ui-icon ui-icon w-12 h-12 rounded-xl flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
                    </svg>
                </div>
                <h2 class="ui-section-title">Features</h2>
            </div>
            
            <form method="post" action="" class="space-y-4">
                <input type="hidden" name="feature_form" value="1">
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <!-- ESP -->
                    <label class="ui-switch">
                            <input type="checkbox" name="ESP" value="on" {{#if (eq feature.esp "on")}} checked {{/if}}>
                            <span class="ui-switch__track" aria-hidden="true"><span class="ui-switch__thumb"></span></span>
                            <span class="ui-switch__label">ESP</span>
                        </label>
                    
                    <!-- Items -->
                    <label class="ui-switch">
                            <input type="checkbox" name="Item" value="on" {{#if (eq feature.item "on")}} checked {{/if}}>
                            <span class="ui-switch__track" aria-hidden="true"><span class="ui-switch__thumb"></span></span>
                            <span class="ui-switch__label">Items</span>
                        </label>
                    
                    <!-- AIM Bot -->
                    <label class="ui-switch">
                            <input type="checkbox" name="AIM" value="on" {{#if (eq feature.aim "on")}} checked {{/if}}>
                            <span class="ui-switch__track" aria-hidden="true"><span class="ui-switch__thumb"></span></span>
                            <span class="ui-switch__label">Aim-Bot</span>
                        </label>
                    
                    <!-- Silent Aim -->
                    <label class="ui-switch">
                            <input type="checkbox" name="SilentAim" value="on" {{#if (eq feature.silentaim "on")}} checked {{/if}}>
                            <span class="ui-switch__track" aria-hidden="true"><span class="ui-switch__thumb"></span></span>
                            <span class="ui-switch__label">Silent Aim</span>
                        </label>
                    
                    <!-- Bullet Track -->
                    <label class="ui-switch">
                            <input type="checkbox" name="BulletTrack" value="on" {{#if (eq feature.bullettrack "on")}} checked {{/if}}>
                            <span class="ui-switch__track" aria-hidden="true"><span class="ui-switch__thumb"></span></span>
                            <span class="ui-switch__label">Bullet Track</span>
                        </label>
                    
                    <!-- Memory -->
                    <label class="ui-switch">
                            <input type="checkbox" name="Memory" value="on" {{#if (eq feature.memory "on")}} checked {{/if}}>
                            <span class="ui-switch__track" aria-hidden="true"><span class="ui-switch__thumb"></span></span>
                            <span class="ui-switch__label">Memory</span>
                        </label>
                    
                    <!-- Floating Texts -->
                    <label class="ui-switch">
                            <input type="checkbox" name="Floating" value="on" {{#if (eq feature.floating "on")}} checked {{/if}}>
                            <span class="ui-switch__track" aria-hidden="true"><span class="ui-switch__thumb"></span></span>
                            <span class="ui-switch__label">Floating text</span>
                        </label>
                    
                    <!-- Settings -->
                    <label class="ui-switch">
                            <input type="checkbox" name="Setting" value="on" {{#if (eq feature.setting "on")}} checked {{/if}}>
                            <span class="ui-switch__track" aria-hidden="true"><span class="ui-switch__thumb"></span></span>
                            <span class="ui-switch__label">In-app settings</span>
                        </label>
                </div>
                
                <button type="submit" class="w-full py-3 px-6 text-white font-bold rounded-xl transition-all duration-300 shadow-lg mt-6 ui-btn ui-btn--primary">
                    Save features
                </button>
            </form>
        </div>
        
        <!-- Change Mod Name Card -->
        <div class="ui-card rounded-2xl p-6 sm:p-8 animate-fade-in-up" style="animation-delay: 0.2s">
            <div class="flex items-center mb-6">
                <div class="ui-icon ui-icon w-12 h-12 rounded-xl flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                </div>
                <h2 class="ui-section-title">Mod name</h2>
            </div>
            
            <form method="post" action="" class="space-y-6">
                <input type="hidden" name="modname_form" value="1">
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Current: <span class="text-pink-600 font-semibold">{{server.modname}}</span>
                    </label>
                    <input 
                        type="text" 
                        name="modname" 
                        required
                        class="w-full px-4 py-3 bg-white/50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-pink-500 transition-all"
                        placeholder="Enter Your New Mod Name"
                    >
                </div>
                
                <button type="submit" class="w-full py-3 px-6 text-white font-bold rounded-xl transition-all duration-300 shadow-lg ui-btn ui-btn--primary">
                    Save name
                </button>
            </form>
        </div>
        
        <!-- Change Floating Text Card -->
        <div class="ui-card rounded-2xl p-6 sm:p-8 animate-fade-in-up" style="animation-delay: 0.3s">
            <div class="flex items-center mb-6">
                <div class="ui-icon ui-icon w-12 h-12 rounded-xl flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
                    </svg>
                </div>
                <h2 class="ui-section-title">Mod status</h2>
            </div>
            
            <form method="post" action="" class="space-y-5">
                <input type="hidden" name="floating_form" value="1">

                <div class="ui-summary ui-summary--compact">
                    <div class="ui-summary__row"><span>Mod status</span><strong>{{ftext._status}}</strong></div>
                </div>

                <label class="ui-switch" for="mod-safe">
                    <input type="checkbox" name="_ftextr" id="mod-safe" value="Safe" {{#if (eq ftext._status "Safe")}} checked {{/if}}>
                    <span class="ui-switch__track" aria-hidden="true"><span class="ui-switch__thumb"></span></span>
                    <span class="ui-switch__label">Safe mode</span>
                </label>
                <p class="field-hint">Off shows a high-risk warning in the loader.</p>

                <div>
                    <label for="floating-text" class="field-label">Floating text</label>
                    <input type="text" name="_ftext" id="floating-text" required maxlength="100"
                           value="{{ftext._ftext}}"
                           class="w-full px-4 py-3 bg-white/50 border border-gray-200 rounded-xl"
                           placeholder="Short status line">
                </div>

                <button type="submit" class="w-full py-3 px-6 text-white font-bold rounded-xl ui-btn ui-btn--primary" data-busy-label="Saving…">
                    Save status
                </button>
            </form>
        </div>
    </div>
</div>

