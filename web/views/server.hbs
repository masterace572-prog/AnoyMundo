<div class="page-head">
    <div>
        <h1 class="page-title">Server</h1>
        <p class="page-sub">What the loader shows after a successful sign-in.</p>
    </div>
</div>

{{> msgStatus}}

<div class="grid-2">
    <div class="stack">
        <section class="card">
            <div class="card-head">
                <div class="tile orange">{{icon "power"}}</div>
                <div><h2 class="card-title">Maintenance</h2><div class="card-sub">While on, every licence check is refused with your message.</div></div>
            </div>
            <form method="post" action="/server" class="form" data-busy-form data-dirty-form>
                <input type="hidden" name="status_form" value="1">
                <div class="switch-list">
                    <label class="switch"><span>Maintenance mode</span><input type="checkbox" name="radios" value="on" data-confirm-on="Turn on maintenance?" data-confirm-on-detail="While on, every licence check is refused with your message." {{#if (eq onoff.status "on")}}checked{{/if}}><span class="track"></span></label>
                </div>
                <div class="field">
                    <label class="label" for="myInput">Message</label>
                    <textarea class="input" name="myInput" id="myInput" rows="3" maxlength="500" placeholder="Server is under maintenance. Please try again later.">{{onoff.myinput}}</textarea>
                </div>
                <div class="save-bar" data-save-bar><button type="submit" class="btn btn-primary" data-busy-label="Saving…">{{icon "check"}}Save changes</button></div>
            </form>
        </section>

        <section class="card">
            <div class="card-head">
                <div class="tile">{{icon "gamepad-2"}}</div>
                <div><h2 class="card-title">Mod name</h2><div class="card-sub">Shown at the top of the mod menu</div></div>
            </div>
            <form method="post" action="/server" class="form" data-busy-form data-dirty-form>
                <input type="hidden" name="modname_form" value="1">
                <div class="field">
                    <label class="label" for="modname">Name</label>
                    <div class="input-wrap">{{icon "pencil" "lead"}}
                    <input type="text" class="input" name="modname" id="modname" value="{{server.modname}}" required maxlength="100" placeholder="Mod name"></div>
                </div>
                <div class="save-bar" data-save-bar><button type="submit" class="btn btn-primary" data-busy-label="Saving…">{{icon "check"}}Save changes</button></div>
            </form>
        </section>
    </div>

    <div class="stack">
        <section class="card">
            <div class="card-head">
                <div class="tile green">{{icon "shield-check"}}</div>
                <div><h2 class="card-title">Mod status</h2><div class="card-sub">Off shows a high-risk warning in the loader.</div></div>
            </div>
            <form method="post" action="/server" class="form" data-busy-form data-dirty-form>
                <input type="hidden" name="floating_form" value="1">
                <div class="switch-list">
                    <label class="switch"><span>Safe</span><input type="checkbox" name="_ftextr" value="Safe" {{#if (eq ftext._status "Safe")}}checked{{/if}}><span class="track"></span></label>
                </div>
                <div class="field">
                    <label class="label" for="_ftext">Floating text</label>
                    <div class="input-wrap">{{icon "sparkles" "lead"}}
                    <input type="text" class="input" name="_ftext" id="_ftext" value="{{ftext._ftext}}" required maxlength="100" placeholder="Short status line"></div>
                </div>
                <div class="save-bar" data-save-bar><button type="submit" class="btn btn-primary" data-busy-label="Saving…">{{icon "check"}}Save changes</button></div>
            </form>
        </section>

        <section class="card">
            <div class="card-head">
                <div class="tile red">{{icon "gamepad-2"}}</div>
                <div><h2 class="card-title">Game availability</h2><div class="card-sub">Unavailable or Maintenance disables that game's Launch in the loader.</div></div>
            </div>
            <form method="post" action="/server" class="form" data-busy-form data-dirty-form>
                <input type="hidden" name="gamestatus_form" value="1">
                <div class="field">
                    <label class="label" for="status_bgmi">BGMI</label>
                    <select class="input" name="status_bgmi" id="status_bgmi">
                        <option value="available" {{#if (eq gameStatus.bgmi.status "available")}}selected{{/if}}>Available</option>
                        <option value="unavailable" {{#if (eq gameStatus.bgmi.status "unavailable")}}selected{{/if}}>Unavailable</option>
                        <option value="maintenance" {{#if (eq gameStatus.bgmi.status "maintenance")}}selected{{/if}}>Maintenance</option>
                    </select>
                </div>
                <div class="field">
                    <label class="label" for="message_bgmi">BGMI message <span class="label-hint">optional</span></label>
                    <input type="text" class="input" name="message_bgmi" id="message_bgmi" value="{{gameStatus.bgmi.message}}" maxlength="200" placeholder="Shown on the BGMI card while it is not available">
                </div>
                <div class="field">
                    <label class="label" for="status_bgmi_air">BGMI Air</label>
                    <select class="input" name="status_bgmi_air" id="status_bgmi_air">
                        <option value="available" {{#if (eq gameStatus.bgmi_air.status "available")}}selected{{/if}}>Available</option>
                        <option value="unavailable" {{#if (eq gameStatus.bgmi_air.status "unavailable")}}selected{{/if}}>Unavailable</option>
                        <option value="maintenance" {{#if (eq gameStatus.bgmi_air.status "maintenance")}}selected{{/if}}>Maintenance</option>
                    </select>
                </div>
                <div class="field">
                    <label class="label" for="message_bgmi_air">BGMI Air message <span class="label-hint">optional</span></label>
                    <input type="text" class="input" name="message_bgmi_air" id="message_bgmi_air" value="{{gameStatus.bgmi_air.message}}" maxlength="200" placeholder="Shown on the BGMI Air card while it is not available">
                </div>
                <div class="save-bar" data-save-bar><button type="submit" class="btn btn-primary" data-busy-label="Saving…">{{icon "check"}}Save changes</button></div>
            </form>
        </section>
    </div>
</div>
