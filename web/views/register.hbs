<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#ffffff">
    <title>{{brand}} · Create account</title>
    <link rel="stylesheet" href="/assets/css/tailwind.css">
    <link rel="stylesheet" href="/assets/css/natacode.css">
    <link rel="stylesheet" href="/assets/css/app.css">
</head>
<body class="app-body auth-body">
    <main class="auth-shell">
        <div class="auth-card auth-card-wide">
            <div class="auth-header">
                <span class="brand-mark brand-mark-lg" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                </span>
                <p class="auth-eyebrow">{{brand}}</p>
                <h1 class="auth-title">Create your account</h1>
                <p class="auth-subtitle">You need a valid referral code to register.</p>
            </div>

            {{> msgStatus}}

            <form method="post" action="" class="auth-form auth-form-grid">
                <div class="field">
                    <label for="email">Email address</label>
                    <input type="email" name="email" id="email" required minlength="5" maxlength="40"
                           autocomplete="email" placeholder="you@example.com" value="{{old.email}}"
                           {{#if errors.email}}aria-invalid="true"{{/if}}>
                    {{#if errors.email}}<p class="field-error">{{errors.email}}</p>{{/if}}
                </div>

                <div class="field">
                    <label for="username">Username</label>
                    <input type="text" name="username" id="username" required minlength="4" maxlength="25"
                           autocomplete="username" placeholder="Choose a username" value="{{old.username}}"
                           {{#if errors.username}}aria-invalid="true"{{/if}}>
                    {{#if errors.username}}<p class="field-error">{{errors.username}}</p>{{/if}}
                </div>

                <div class="field">
                    <label for="fullname">Full name</label>
                    <input type="text" name="fullname" id="fullname" required minlength="4" maxlength="25"
                           autocomplete="name" placeholder="Your display name" value="{{old.fullname}}"
                           {{#if errors.fullname}}aria-invalid="true"{{/if}}>
                    {{#if errors.fullname}}<p class="field-error">{{errors.fullname}}</p>{{/if}}
                </div>

                <div class="field">
                    <label for="referral">Referral code</label>
                    <input type="text" name="referral" id="referral" required maxlength="25"
                           placeholder="Enter referral code" value="{{old.referral}}"
                           {{#if errors.referral}}aria-invalid="true"{{/if}}>
                    {{#if errors.referral}}<p class="field-error">{{errors.referral}}</p>{{/if}}
                </div>

                <div class="field">
                    <label for="password">Password</label>
                    <div class="password-field">
                        <input type="password" name="password" id="password" required minlength="6" maxlength="45"
                               autocomplete="new-password" placeholder="At least 6 characters"
                               {{#if errors.password}}aria-invalid="true"{{/if}}>
                        <button type="button" class="password-toggle" onclick="togglePassword('password', 'toggleIcon1')" aria-label="Show password">
                            <svg id="toggleIcon1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12C3.7 7.9 7.5 5 12 5s8.3 2.9 9.5 7c-1.2 4.1-5 7-9.5 7s-8.3-2.9-9.5-7z"></path></svg>
                        </button>
                    </div>
                    {{#if errors.password}}<p class="field-error">{{errors.password}}</p>{{/if}}
                </div>

                <div class="field">
                    <label for="password2">Confirm password</label>
                    <div class="password-field">
                        <input type="password" name="password2" id="password2" required minlength="6" maxlength="45"
                               autocomplete="new-password" placeholder="Repeat your password"
                               {{#if errors.password2}}aria-invalid="true"{{/if}}>
                        <button type="button" class="password-toggle" onclick="togglePassword('password2', 'toggleIcon2')" aria-label="Show password">
                            <svg id="toggleIcon2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12C3.7 7.9 7.5 5 12 5s8.3 2.9 9.5 7c-1.2 4.1-5 7-9.5 7s-8.3-2.9-9.5-7z"></path></svg>
                        </button>
                    </div>
                    {{#if errors.password2}}<p class="field-error">{{errors.password2}}</p>{{/if}}
                </div>

                <div class="field field-full">
                    <label for="ip">IP address</label>
                    <input type="text" id="ip" value="{{clientIp}}" readonly tabindex="-1" aria-label="Your IP address">
                </div>

                <div class="field-full">
                    <button type="submit" class="ui-btn auth-submit">Create Account</button>
                </div>
            </form>

            <div class="auth-footer">
                <span>Already have an account?</span>
                <a href="/login" class="auth-link">Sign in</a>
            </div>
        </div>

        <p class="auth-legal">
            TO BUY PANEL DM HERE :- <a href="https://telegram.me/AloneBoy_Boss" target="_blank" rel="noopener">@AloneBoy_Boss</a>
        </p>
    </main>

    <script>
        function togglePassword(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (!input || !icon) return;
            var showing = input.type === 'password';
            input.type = showing ? 'text' : 'password';
            icon.innerHTML = showing
                ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.9 18.8A10 10 0 0112 19c-4.5 0-8.3-2.9-9.5-7a10 10 0 011.6-3m5.8.9a3 3 0 014.2 4.2M9.9 9.9l4.2 4.2M9.9 9.9l-3.3-3.3m7.6 7.6l3.3 3.3M3 3l3.6 3.6m0 0A10 10 0 0112 5c4.5 0 8.3 2.9 9.5 7a10 10 0 01-4.1 5.4m0 0L21 21"></path>'
                : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.5 12C3.7 7.9 7.5 5 12 5s8.3 2.9 9.5 7c-1.2 4.1-5 7-9.5 7s-8.3-2.9-9.5-7z"></path>';
        }
    </script>
</body>
</html>
