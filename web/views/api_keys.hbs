<div class="container-fluid px-4 py-6">
    <div class="mb-6">{{> msgStatus}}</div>

    {{#if flash.apiKeyPlain}}
    <div class="ui-card mb-6">
        <div class="card-head"><h2>Copy your new API key now</h2></div>
        <p class="doc-section">Shown once. Only a hash is stored, so if you lose it you must create a new key.</p>
        <div class="ui-tint" style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;padding:16px;margin-bottom:16px">
            <code id="new-api-key" class="key-token" style="flex:1 1 240px;min-width:0">{{flash.apiKeyPlain}}</code>
            <button type="button" id="copy-api-key" class="ui-btn">Copy</button>
        </div>
        <p class="doc-section" style="margin-bottom:0">Send it as <span class="doc-inline">X-API-Key</span> on every request to
        <span class="doc-inline">/api/v1/…</span>. See <a href="/api-docs">API docs</a>.</p>
    </div>
    {{/if}}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="ui-card">
            <div class="card-head"><h2>Create API key</h2></div>
            <p class="doc-section">One key per project (site, bot, script) so you can revoke it independently.</p>
            <form method="post" action="/api-keys" class="space-y-4">
                <input type="hidden" name="action" value="create">
                <div>
                    <label for="api-key-name" class="block text-sm font-semibold mb-2">Key name</label>
                    <input type="text" id="api-key-name" name="name" maxlength="80" required
                           placeholder="my-telegram-bot">
                </div>
                <button type="submit" class="ui-btn ui-btn--primary w-full">Create API key</button>
            </form>
            <div class="doc-note" style="margin-top:24px">
                API keys can <strong>only</strong> create, list, update, reset and delete licence keys.
                They cannot change the mod name, status text, floating text, features or maintenance mode.
                Creating a key via the API deducts saldo with the same pricing as this panel.
            </div>
        </div>

        <div class="lg:col-span-2 ui-card" style="min-width:0">
            <div class="card-head" style="flex-wrap:wrap;justify-content:space-between">
                <div style="min-width:0">
                    <h2>Your API keys</h2>
                    <p class="field-hint">Available balance: <span data-saldo="{{user.saldo}}">₹{{user.saldo}}</span></p>
                </div>
                <a href="/api-docs" class="ui-btn">View API docs</a>
            </div>

            {{#if apiKeys}}
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr><th>Name</th><th>Key</th><th>Status</th><th>Created</th><th>Last used</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        {{#each apiKeys}}
                        <tr>
                            <td class="cell-nowrap"><strong>{{this.name}}</strong></td>
                            <td><code class="key-token">{{this.key_prefix}}…{{this.key_last4}}</code></td>
                            <td class="cell-nowrap">
                                {{#if (eq this.status 1)}}
                                <span class="status-pill">Active</span>
                                {{else}}
                                <span class="status-pill status-pill--danger">Revoked</span>
                                {{/if}}
                            </td>
                            <td class="cell-nowrap">{{this.createdLabel}}</td>
                            <td class="cell-nowrap">{{this.usedLabel}}</td>
                            <td>
                                <div class="row-actions">
                                    {{#if (eq this.status 1)}}
                                    <form method="post" action="/api-keys">
                                        <input type="hidden" name="action" value="revoke">
                                        <input type="hidden" name="id" value="{{this.id}}">
                                        <button type="submit" class="row-action row-action--danger">Revoke</button>
                                    </form>
                                    {{/if}}
                                    <form method="post" action="/api-keys">
                                        <input type="hidden" name="action" value="delete">
                                        <input type="hidden" name="id" value="{{this.id}}">
                                        <button type="submit" class="row-action row-action--danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{else}}
            <div class="ui-tint" style="text-align:center;color:var(--muted);padding:32px">
                No API keys yet. Create one with the form on the left.
            </div>
            {{/if}}
        </div>
    </div>
</div>

<script>
(function () {
    var button = document.getElementById('copy-api-key');
    var code = document.getElementById('new-api-key');
    if (!button || !code) return;
    button.addEventListener('click', function () {
        var value = code.textContent.trim();
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(value).then(function () { button.textContent = 'Copied'; });
        } else {
            var input = document.createElement('textarea');
            input.value = value; document.body.appendChild(input); input.select();
            try { document.execCommand('copy'); button.textContent = 'Copied'; } catch (e) { /* ignore */ }
            document.body.removeChild(input);
        }
    });
})();
</script>
