<div class="page-head">
    <div>
        <h1 class="page-title">API keys</h1>
        <p class="page-sub">Let your website or bot create and manage licence keys.</p>
    </div>
    <div class="page-actions">
        <a href="/api-docs" class="btn btn-secondary">{{icon "book-open"}}Read the docs</a>
    </div>
</div>

{{> msgStatus}}

{{#if flash.apiKeyPlain}}
<section class="card highlight keys-out" style="margin-bottom:20px">
    <div class="card-head">
        <div class="tile green">{{icon "circle-check"}}</div>
        <div><h2 class="card-title">Your new API key</h2><div class="card-sub">Shown once. Anyone with it can spend your balance.</div></div>
        <span class="spacer"></span>
        <button type="button" class="btn btn-primary btn-sm" data-copy-target="new-api-key">{{icon "copy"}}Copy</button>
    </div>
    <input type="text" class="input mono" id="new-api-key" value="{{flash.apiKeyPlain}}" readonly aria-label="New API key">
</section>
{{/if}}

<div class="grid-split wide-list">
<section class="card">
    <div class="card-head">
        <div class="tile purple">{{icon "key-square"}}</div>
        <div><h2 class="card-title">New API key</h2><div class="card-sub">Uses your balance and keys</div></div>
    </div>
    <form method="post" action="/api-keys" class="form" data-busy-form>
        <input type="hidden" name="action" value="create">
        <div class="field">
            <label class="label" for="api-key-name">Name</label>
            <div class="input-wrap">{{icon "tag" "lead"}}
            <input type="text" class="input" name="name" id="api-key-name" required maxlength="80" placeholder="my-telegram-bot" autocomplete="off"></div>
            <div class="hint">Only for you, to recognise the key later.</div>
        </div>
        <button type="submit" class="btn btn-primary btn-block" data-busy-label="Creating…">{{icon "plus"}}Create API key</button>
    </form>
</section>

<section class="card card-flush">
    <div class="card-head" style="padding-bottom:16px;margin-bottom:0;border-bottom:1px solid var(--border)">
        <div class="tile teal">{{icon "code-xml"}}</div>
        <div><h2 class="card-title">Your keys</h2><div class="card-sub">Send as the X-API-Key header</div></div>
    </div>
    <div class="table-wrap">
        <table class="responsive">
            <thead><tr><th>Name</th><th>Key</th><th>Status</th><th>Last used</th><th class="actions-cell"><span class="sr-only">Actions</span></th></tr></thead>
            <tbody>
                {{#each apiKeys}}
                <tr>
                    <td class="primary-cell" data-label="Name">{{this.name}}</td>
                    <td data-label="Key"><span class="keytext">{{this.key_prefix}}…{{this.key_last4}}</span></td>
                    <td data-label="Status"><span class="status {{#if (eq this.status 1)}}ok{{else}}bad{{/if}}">{{this.statusLabel}}</span></td>
                    <td data-label="Last used">{{this.usedLabel}}</td>
                    <td class="actions-cell"><span class="row-actions">
                        {{#if (eq this.status 1)}}
                        <form method="post" action="/api-keys" style="display:inline" data-confirm="Revoke {{this.name}}?" data-confirm-detail="Apps using it stop working immediately.">
                            <input type="hidden" name="action" value="revoke"><input type="hidden" name="id" value="{{this.id}}">
                            <button type="submit" class="icon-btn" aria-label="Revoke {{this.name}}" title="Revoke">{{icon "ban"}}</button>
                        </form>
                        {{/if}}
                        <form method="post" action="/api-keys" style="display:inline" data-confirm="Delete {{this.name}}?" data-confirm-detail="This cannot be undone.">
                            <input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="{{this.id}}">
                            <button type="submit" class="icon-btn danger" aria-label="Delete {{this.name}}" title="Delete">{{icon "trash-2"}}</button>
                        </form>
                    </span></td>
                </tr>
                {{else}}
                <tr class="is-empty"><td colspan="5"><div class="empty">{{icon "key-square"}}<b>No API keys yet</b>Create one to connect a bot or website.<a href="#api-key-name" class="btn btn-secondary" data-focus="api-key-name">Create an API key</a></div></td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</section>
</div>
