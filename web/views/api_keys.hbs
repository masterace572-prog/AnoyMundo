<div class="page-head">
    <div>
        <h1 class="page-title">API keys</h1>
        <p class="page-sub">Let your website or bot create and manage licence keys. <a href="/api-docs">Read the docs</a></p>
    </div>
</div>

{{> msgStatus}}

{{#if flash.apiKeyPlain}}
<section class="section keys-out" style="border-top:0;padding-top:0">
    <div class="row-between">
        <h2 class="section-title">Your new API key</h2>
        <button type="button" class="btn btn-primary btn-sm" data-copy-target="new-api-key">Copy</button>
    </div>
    <input type="text" class="input mono" id="new-api-key" value="{{flash.apiKeyPlain}}" readonly aria-label="New API key">
    <p class="hint">Shown once. Store it somewhere safe; anyone with it can spend your balance.</p>
</section>
{{/if}}

<div class="grid-2">
<form method="post" action="/api-keys" class="form" data-busy-form>
    <input type="hidden" name="action" value="create">
    <div class="field">
        <label class="label" for="api-key-name">Name</label>
        <input type="text" class="input" name="name" id="api-key-name" required maxlength="80" placeholder="my-telegram-bot" autocomplete="off">
        <div class="hint">Only for you, to recognise the key later.</div>
    </div>
    <button type="submit" class="btn btn-primary" data-busy-label="Creating…">Create API key</button>
</form>

<section class="section" style="border-top:0;padding-top:0">
    <h2 class="section-title">Your keys</h2>
    <div class="table-wrap" style="margin-top:14px">
        <table class="responsive">
            <thead><tr><th>Name</th><th>Key</th><th>Status</th><th>Last used</th><th class="actions-cell"><span class="sr-only">Actions</span></th></tr></thead>
            <tbody>
                {{#each apiKeys}}
                <tr>
                    <td data-label="Name">{{this.name}}</td>
                    <td class="key" data-label="Key">{{this.key_prefix}}…{{this.key_last4}}</td>
                    <td data-label="Status"><span class="status {{#if (eq this.status 1)}}ok{{else}}bad{{/if}}">{{this.statusLabel}}</span></td>
                    <td data-label="Last used">{{this.usedLabel}}</td>
                    <td class="actions-cell">
                        {{#if (eq this.status 1)}}
                        <form method="post" action="/api-keys" style="display:inline" data-confirm="Revoke {{this.name}}?" data-confirm-detail="Apps using it stop working immediately.">
                            <input type="hidden" name="action" value="revoke"><input type="hidden" name="id" value="{{this.id}}">
                            <button type="submit" class="btn btn-secondary btn-sm">Revoke</button>
                        </form>
                        {{/if}}
                        <form method="post" action="/api-keys" style="display:inline" data-confirm="Delete {{this.name}}?" data-confirm-detail="This cannot be undone.">
                            <input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="{{this.id}}">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
                {{else}}
                <tr class="is-empty"><td colspan="5">No API keys yet.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</section>
</div>
