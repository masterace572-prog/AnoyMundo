<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#000000">
    <meta name="color-scheme" content="dark">
    <meta name="description" content="{{brand}} licence panel">
    <meta name="robots" content="noindex">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <title>{{title}} · {{brand}}</title>
    <link rel="stylesheet" href="/assets/css/ui.css">
</head>
<body>
    <div class="shell">
        {{> header}}
        <div class="scrim" data-nav-close></div>
        <div class="main">
            <header class="topbar">
                <button type="button" class="icon-btn" data-nav-open aria-label="Open menu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                </button>
                <a href="/dashboard" class="brand">{{brand}}</a>
                <span style="width:34px" aria-hidden="true"></span>
            </header>
            <main class="content" id="main-content">
                {{{content}}}
            </main>
            <footer class="footer">
                <span>&copy; {{year}} {{brand}}</span>
                <span>Panel v{{appVersion}}</span>
            </footer>
        </div>
    </div>
    <script src="/assets/js/app-ui.js"></script>
</body>
</html>
