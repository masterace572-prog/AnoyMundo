<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#ffffff">
    <meta name="description" content="{{brand}} licence panel">
    <title>{{brand}} · {{title}}</title>

    <!-- Bootstrap + DataTables + SweetAlert2 (used by the legacy DataTables views) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="/assets/css/tailwind.css">
    <link rel="stylesheet" href="/assets/css/natacode.css">
    <link rel="stylesheet" href="/assets/css/app.css">
    {{{pageCss}}}

    <!-- jQuery must load before the inline DataTables scripts in the views -->
    <script src="https://code.jquery.com/jquery-3.6.0.js" integrity="sha256-H+K7U5CnXl1h5ywQfKtSj8PCmoN9aaq30gDh27Xc0jk=" crossorigin="anonymous"></script>
</head>
<body class="app-body">
    <div class="app-layout">
        {{> header}}

        <div class="app-main">
            <main class="app-content" id="main-content">
                {{{content}}}
            </main>

            <footer class="app-footer">
                <span>&copy; {{year}} {{brand}} · All rights reserved</span>
                <span class="app-footer-meta">Panel v1.0</span>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/limonte-sweetalert2/11.1.0/sweetalert2.all.min.js" integrity="sha512-0UUEaq/z58JSHpPgPv8bvdhHFRswZzxJUT9y+Kld5janc9EWgGEVGfWV1hXvIvAJ8MmsR5d4XV9lsuA90xXqUQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="/assets/js/natacode.js"></script>
    <script src="/assets/js/app-ui.js"></script>
    {{{pageJs}}}
</body>
</html>
