<div class="page-head">
    <div>
        <h1 class="page-title">Settings</h1>
        <p class="page-sub">Your account and sign-in details.</p>
    </div>
</div>

{{> msgStatus}}

<div class="grid-2">
    <section class="section" style="border-top:0;padding-top:0">
        <h2 class="section-title">Account</h2>
        <div class="list" style="margin-top:14px">
            <div class="list-row"><span>Username</span><span>{{user.username}}</span></div>
            <div class="list-row"><span>Email</span><span>{{user.email}}</span></div>
            <div class="list-row"><span>Role</span><span>{{user.levelName}}</span></div>
            <div class="list-row"><span>Balance</span><span>{{#if unlimited}}Unlimited{{else}}₹{{user.saldoLabel}}{{/if}}</span></div>
            <div class="list-row"><span>Signed in</span><span>{{sessionSince}}</span></div>
            <div class="list-row"><span>Session ends</span><span>{{sessionRemaining}}</span></div>
        </div>

        <h2 class="section-title" style="margin-top:28px">Name</h2>
        <form method="post" action="/settings" class="form" style="margin-top:14px" novalidate data-busy-form>
            <input type="hidden" name="fullname_form" value="1">
            <div class="field {{#if errors.fullname}}invalid{{/if}}">
                <label class="label" for="fullname">Display name</label>
                <input type="text" class="input" name="fullname" id="fullname" value="{{form.fullname}}" required maxlength="155" autocomplete="name">
                {{#if errors.fullname}}<div class="error">{{errors.fullname}}</div>{{/if}}
            </div>
            <button type="submit" class="btn btn-primary" data-busy-label="Saving…">Save name</button>
        </form>
    </section>

    <section class="section" style="border-top:0;padding-top:0">
        <h2 class="section-title">Password</h2>
        <p class="section-sub">Changing it signs out every other session.</p>
        <form method="post" action="/settings" class="form" novalidate data-busy-form>
            <input type="hidden" name="password_form" value="1">
            <div class="field {{#if errors.current}}invalid{{/if}}">
                <label class="label" for="current">Current password</label>
                <input type="password" class="input" name="current" id="current" required autocomplete="current-password" maxlength="45">
                {{#if errors.current}}<div class="error">{{errors.current}}</div>{{/if}}
            </div>
            <div class="field {{#if errors.password}}invalid{{/if}}">
                <label class="label" for="password">New password</label>
                <input type="password" class="input" name="password" id="password" required minlength="6" maxlength="45" autocomplete="new-password">
                {{#if errors.password}}<div class="error">{{errors.password}}</div>{{/if}}
            </div>
            <div class="field {{#if errors.password2}}invalid{{/if}}">
                <label class="label" for="password2">Confirm new password</label>
                <input type="password" class="input" name="password2" id="password2" required minlength="6" maxlength="45" autocomplete="new-password">
                {{#if errors.password2}}<div class="error">{{errors.password2}}</div>{{/if}}
            </div>
            <button type="submit" class="btn btn-primary" data-busy-label="Saving…">Change password</button>
        </form>
    </section>
</div>
