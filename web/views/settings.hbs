



<!-- Tailwind CSS (compiled at build time) -->

<!-- Google Fonts -->
<div class="container-fluid px-4 py-6">
    <!-- Page Header -->
    <div class="mb-8 animate-fade-in-up">
        <h1 class="text-4xl font-bold text-gray-800 mb-2">Account Settings</h1>
        <p class="text-gray-600">Account &amp; security</p>
    </div>

    <!-- Message Status -->
    <div class="mb-6 animate-fade-in-up" style="animation-delay: 0.1s">
        {{> msgStatus}}
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Appearance: iOS segmented selector, affects the whole site. -->
        <div class="ui-card ios-appearance-card">
            <div class="card-head"><h2>Appearance</h2></div>
            <div class="ui-segmented" role="radiogroup" aria-label="Appearance">
                <input type="radio" name="appearance" id="appearance-system" value="system">
                <label for="appearance-system">System</label>
                <input type="radio" name="appearance" id="appearance-light" value="light">
                <label for="appearance-light">Light</label>
                <input type="radio" name="appearance" id="appearance-dark" value="dark">
                <label for="appearance-dark">Dark</label>
            </div>
        </div>


        <!-- Change Password Card -->
        <div class="ui-card rounded-2xl p-8 animate-fade-in-left" style="animation-delay: 0.2s">
            <div class="flex items-center mb-6">
                <div class="ui-icon w-14 h-14 rounded-xl flex items-center justify-center mr-4">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                    </svg>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-gray-800">Change Password</h2>
                    <p class="text-sm text-gray-600">Change your password</p>
                </div>
            </div>
            
            <form method="post" action="">
            <input type="hidden" name="password_form" value="1">
            
            <div class="space-y-5">
                <!-- Current Password -->
                <div>
                    <label for="current" class="block text-sm font-semibold text-gray-700 mb-2">
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                            </svg>
                            Current Password
                        </div>
                    </label>
                    <input type="password" name="current" id="current" 
                           class="input-field w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-purple-500" 
                           placeholder="Enter your current password">
                    {{#if errors.current}}
                        <small class="text-red-500 text-xs mt-1 block">{{errors.current}}</small>
                    {{/if}}
                </div>
                
                <!-- New Password -->
                <div>
                    <label for="password" class="block text-sm font-semibold text-gray-700 mb-2">
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                            </svg>
                            New Password
                        </div>
                    </label>
                    <input type="password" name="password" id="password" 
                           class="input-field w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-purple-500" 
                           placeholder="Enter your new password">
                    {{#if errors.password}}
                        <small class="text-red-500 text-xs mt-1 block">{{errors.password}}</small>
                    {{/if}}
                </div>
                
                <!-- Confirm Password -->
                <div>
                    <label for="password2" class="block text-sm font-semibold text-gray-700 mb-2">
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            Confirm Password
                        </div>
                    </label>
                    <input type="password" name="password2" id="password2" 
                           class="input-field w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-purple-500" 
                           placeholder="Confirm your new password">
                    {{#if errors.password2}}
                        <small class="text-red-500 text-xs mt-1 block">{{errors.password2}}</small>
                    {{/if}}
                </div>
                
                <!-- Submit Button -->
                <div class="pt-2">
                    <button type="submit" class="ui-btn ui-btn--primary w-full text-white font-semibold py-3 px-6 rounded-xl flex items-center justify-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        Update Password
                    </button>
                </div>
            </div>
            </form>
        </div>
        
        <!-- Account Information Card -->
        <div class="ui-card rounded-2xl p-8 animate-fade-in-right" style="animation-delay: 0.3s">
            <div class="flex items-center mb-6">
                <div class="ui-icon ui-icon w-14 h-14 rounded-xl flex items-center justify-center mr-4">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-gray-800">Account Information</h2>
                    <p class="text-sm text-gray-600">Your details</p>
                </div>
            </div>
            
            <form method="post" action="">
            <input type="hidden" name="fullname_form" value="1">
            
            <div class="space-y-5">
                <!-- Full Name -->
                <div>
                    <label for="fullname" class="block text-sm font-semibold text-gray-700 mb-2">
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            Full Name
                        </div>
                    </label>
                    <input type="text" name="fullname" id="fullname" 
                           class="input-field w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500" 
                           placeholder="Enter your full name" 
                           value="{{form.fullname}}">
                    {{#if errors.fullname}}
                        <small class="text-red-500 text-xs mt-1 block">{{errors.fullname}}</small>
                    {{/if}}
                </div>
                
                <!-- User Info Display -->
                <div class="rounded-xl p-5 space-y-3 ui-tint">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium text-gray-700 flex items-center">
                            <svg class="w-4 h-4 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                            Email
                        </span>
                        <span class="text-sm font-semibold text-gray-800">{{user.email}}</span>
                    </div>
                    
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium text-gray-700 flex items-center">
                            <svg class="w-4 h-4 mr-2 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            Username
                        </span>
                        <span class="text-sm font-semibold text-gray-800">{{user.username}}</span>
                    </div>
                </div>
                
                <!-- Submit Button -->
                <div class="pt-2">
                    <button type="submit" class="ui-btn ui-btn--primary w-full text-white font-semibold py-3 px-6 rounded-xl flex items-center justify-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                        Update Account
                    </button>
                </div>
            </div>
            </form>
        </div>
    </div>
    
    <!-- Additional Settings Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
        <!-- Security Tips Card -->
        <div class="ui-card rounded-2xl p-6 animate-fade-in-up" style="animation-delay: 0.4s">
            <div class="flex items-center mb-4">
                <div class="ui-icon ui-icon w-10 h-10 rounded-lg flex items-center justify-center mr-3">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-gray-800">Security Tips</h3>
            </div>
            <p class="text-sm text-gray-600">Use a strong password. Never share it.</p>
        </div>
        
        <!-- Account Stats Card -->
        <div class="ui-card rounded-2xl p-6 animate-fade-in-up" style="animation-delay: 0.5s">
            <div class="flex items-center mb-4">
                <div class="ui-icon ui-icon w-10 h-10 rounded-lg flex items-center justify-center mr-3">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-gray-800">Account Stats</h3>
            </div>
            <div class="space-y-3">
                <div class="flex justify-between items-center">
                    <span class="text-sm text-gray-600">Account Level</span>
                    <span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-lg text-xs font-semibold">{{user.levelName}}</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-sm text-gray-600">Balance</span>
                    <span class="status-pill cell-mono" data-saldo="{{user.saldo}}">₹{{user.saldo}}</span>
                </div>
            </div>
        </div>
        
        <!-- Quick Actions Card -->
        <div class="ui-card rounded-2xl p-6 animate-fade-in-up" style="animation-delay: 0.6s">
            <div class="flex items-center mb-4">
                <div class="ui-icon w-10 h-10 rounded-lg flex items-center justify-center mr-3">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-gray-800">Quick Actions</h3>
            </div>
            <div class="space-y-2">
                <a href="/dashboard" class="quick-action">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                    Go to Dashboard
                </a>
                <a href="/keys" class="quick-action">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                    </svg>
                    Manage Keys
                </a>
            </div>
        </div>
    </div>
</div>

