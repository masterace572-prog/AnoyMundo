<aside class="sidebar" id="sidebar" aria-label="Main navigation">
    <a href="/dashboard" class="brand">{{brand}} <small>Panel</small></a>
    <nav class="nav">
        <a href="/dashboard" class="{{#if navDashboard}}active{{/if}}">Dashboard</a>
        <a href="/keys" class="{{#if navKeys}}active{{/if}}">Keys</a>
        <a href="/keys/generate" class="{{#if navGenerate}}active{{/if}}">Generate keys</a>
        {{#if user.isAdmin}}
        <div class="nav-label">Manage</div>
        <a href="/server" class="{{#if navServer}}active{{/if}}">Server</a>
        <a href="/admin/create-referral" class="{{#if navReferral}}active{{/if}}">Referral codes</a>
        {{/if}}
        {{#if user.isOwner}}
        <a href="/admin/manage-users" class="{{#if navUsers}}active{{/if}}">Users</a>
        <a href="/lib" class="{{#if navLib}}active{{/if}}">Library</a>
        {{/if}}
        <div class="nav-label">Developers</div>
        <a href="/api-keys" class="{{#if navApiKeys}}active{{/if}}">API keys</a>
        <a href="/api-docs" class="{{#if navApiDocs}}active{{/if}}">API docs</a>
        <a href="/docs" class="{{#if navIntegration}}active{{/if}}">Integration</a>
        <div class="nav-label">Account</div>
        <a href="/settings" class="{{#if navSettings}}active{{/if}}">Settings</a>
        <a href="/logout">Sign out</a>
    </nav>
    {{#if user}}
    <div class="sidebar-foot">
        <div class="who">{{user.displayName}}</div>
        <div class="who-sub">{{user.levelName}} · {{#if user.unlimited}}Unlimited balance{{else}}₹{{user.saldoLabel}}{{/if}}</div>
    </div>
    {{/if}}
</aside>
