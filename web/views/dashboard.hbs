<div class="page-head">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-sub">Signed in as {{user.displayName}} · {{user.levelName}}</p>
    </div>
    <a href="/keys/generate" class="btn btn-primary">Generate keys</a>
</div>

{{> msgStatus}}

<div class="stats" aria-label="Key statistics">
    <div class="stat"><div class="stat-label">Total keys</div><div class="stat-value" data-stat="keys">{{stats.keys}}</div></div>
    <div class="stat"><div class="stat-label">In use</div><div class="stat-value" data-stat="active">{{stats.active}}</div></div>
    <div class="stat"><div class="stat-label">Unused</div><div class="stat-value" data-stat="unused">{{stats.inactive}}</div></div>
    <div class="stat"><div class="stat-label">Expired</div><div class="stat-value" data-stat="expired">{{stats.expired}}</div></div>
</div>

<div class="grid-2">
    <section class="section">
        <h2 class="section-title">Account</h2>
        <div class="list" style="margin-top:14px">
            <div class="list-row"><span>Username</span><span>{{user.username}}</span></div>
            <div class="list-row"><span>Role</span><span>{{user.levelName}}</span></div>
            <div class="list-row"><span>Balance</span><span>{{#if unlimited}}Unlimited{{else}}₹{{user.saldoLabel}}{{/if}}</span></div>
            <div class="list-row"><span>Account expires</span><span>{{#if stats.expiryFormatted}}{{stats.expiryFormatted}}{{else}}Never{{/if}}</span></div>
            {{#if user.isAdmin}}<div class="list-row"><span>{{#if user.isOwner}}Users{{else}}Users you invited{{/if}}</span><span>{{stats.users}}</span></div>{{/if}}
        </div>
    </section>
    <section class="section">
        <h2 class="section-title">Shortcuts</h2>
        <div class="list" style="margin-top:14px">
            <a class="list-row" href="/keys"><span>All keys</span><span class="chev">›</span></a>
            <a class="list-row" href="/keys/generate"><span>Generate keys</span><span class="chev">›</span></a>
            {{#if user.isAdmin}}<a class="list-row" href="/server"><span>Server settings</span><span class="chev">›</span></a>{{/if}}
            {{#if user.isOwner}}<a class="list-row" href="/lib"><span>Publish library update</span><span class="chev">›</span></a>{{/if}}
            <a class="list-row" href="/settings"><span>Account settings</span><span class="chev">›</span></a>
        </div>
    </section>
</div>
