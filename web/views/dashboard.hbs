<div class="container-fluid px-4 py-6">
    <div class="mb-6">{{> msgStatus}}</div>

    <h1 class="page-title">Dashboard</h1>

    <!-- The same four numbers, one tile style, tabular figures. -->
    <div class="stat-grid">
        <div class="stat-tile"><span>Total keys</span><strong>{{stats.keys}}</strong></div>
        <div class="stat-tile"><span>Used keys</span><strong>{{stats.active}}</strong></div>
        <div class="stat-tile"><span>Unused keys</span><strong>{{stats.inactive}}</strong></div>
        <div class="stat-tile"><span>Total users</span><strong>{{stats.users}}</strong></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 stack">
            {{#if stats.expiryFormatted}}
            <section class="ui-card">
                <div class="card-head"><h2>Subscription expiration</h2></div>
                <p class="field-hint">Your account is active until</p>
                <time id="expiry-date" class="expiry-value" datetime="{{user.expiration_date}}">{{stats.expiryFormatted}}</time>
            </section>
            {{/if}}

            <!-- The old unlabelled bar chart is replaced by the same three
                 numbers shown on the tiles, with real labels. -->
            <section class="ui-card">
                <div class="card-head"><h2>Keys overview</h2></div>
                <ul class="stat-list">
                    <li><span>Total keys</span><strong>{{stats.keys}}</strong></li>
                    <li><span>Used keys</span><strong>{{stats.active}}</strong></li>
                    <li><span>Unused keys</span><strong>{{stats.inactive}}</strong></li>
                </ul>
            </section>

            <section class="ui-card">
                <div class="card-head"><h2>Recent history</h2></div>
                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Type</th>
                                <th>Code</th>
                                <th>Duration</th>
                                <th>Devices</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each history}}
                            <tr>
                                <td class="cell-mono">#3812{{this.id_history}}</td>
                                <td>{{this.parts.[0]}}</td>
                                <td><span class="key-token">{{this.parts.[1]}}**</span></td>
                                <td>{{this.durationLabel}}</td>
                                <td>{{this.parts.[3]}} Devices</td>
                                <td class="cell-nowrap">{{this.createdHuman}}</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <section class="ui-card stack-start">
            <div class="card-head"><h2>User info</h2></div>
            <ul class="stat-list">
                <li><span>Role</span><strong class="stat-value-text">{{user.levelName}}</strong></li>
                <li><span>Balance</span><strong class="stat-value-text" data-saldo="{{user.saldo}}">₹{{user.saldo}}</strong></li>
                <li><span>Login time</span><strong class="stat-value-text">{{sessionSince}}</strong></li>
                <li><span>Auto logout</span><strong class="stat-value-text">{{sessionRemaining}}</strong></li>
            </ul>
        </section>
    </div>
</div>
