<div class="page-head">
    <div>
        <h1 class="page-title">Users</h1>
        <p class="page-sub">{{userList.length}} accounts</p>
    </div>
    <a href="/admin/create-referral" class="btn btn-primary">Invite with a code</a>
</div>

{{> msgStatus}}

<div class="toolbar">
    <input type="search" class="input" placeholder="Search users" aria-label="Search users" data-filter-table="users-table" autocomplete="off">
</div>
<div class="table-wrap">
    <table class="responsive" id="users-table">
        <thead><tr><th>Username</th><th>Role</th><th>Balance</th><th>Status</th><th>Expires</th><th>Invited by</th><th class="actions-cell"><span class="sr-only">Actions</span></th></tr></thead>
        <tbody>
            {{#each userList}}
            <tr>
                <td data-label="Username"><strong>{{this.username}}</strong><div class="faint" style="font-size:13px">{{this.email}}</div></td>
                <td data-label="Role">{{this.levelName}}</td>
                <td data-label="Balance">{{this.saldoLabel}}</td>
                <td data-label="Status"><span class="status {{#if (eq this.status 1)}}ok{{else}}bad{{/if}}">{{this.statusName}}</span></td>
                <td data-label="Expires">{{this.expiresLabel}}</td>
                <td data-label="Invited by">{{this.uplink}}</td>
                <td class="actions-cell">
                    {{#if this.isOwnerRow}}<span class="faint">Owner</span>{{else}}
                    <a class="btn btn-secondary btn-sm" href="/admin/user/{{this.id_users}}">Edit</a>
                    <form method="post" action="/admin/user/delete/{{this.id_users}}" style="display:inline" data-confirm="Delete {{this.username}}?" data-confirm-detail="Their keys are deleted too; never-used keys are refunded. This cannot be undone.">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                    {{/if}}
                </td>
            </tr>
            {{else}}
            <tr class="is-empty"><td colspan="7">No users.</td></tr>
            {{/each}}
        </tbody>
    </table>
</div>
