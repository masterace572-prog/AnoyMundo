<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/icon_face"/><corners android:radius="@dimen/button_radius"/><stroke android:width="@dimen/focus_stroke" android:color="@color/focus_ring"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/icon_face_pressed"/><corners android:radius="@dimen/button_radius"/><stroke android:width="@dimen/hairline" android:color="@color/icon_edge"/></shape></item>
    <item><shape><gradient android:angle="270" android:startColor="@color/icon_face" android:endColor="@color/surface_1"/><corners android:radius="@dimen/button_radius"/><stroke android:width="@dimen/hairline" android:color="@color/icon_edge"/></shape></item>
</selector>
