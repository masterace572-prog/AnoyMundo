<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true"><shape><solid android:color="@color/field_bg"/><corners android:radius="@dimen/radius_control"/><stroke android:width="@dimen/focus_stroke" android:color="@color/danger"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/field_bg_focus"/><corners android:radius="@dimen/radius_control"/><stroke android:width="@dimen/focus_stroke" android:color="@color/focus_ring"/></shape></item>
    <item><shape><solid android:color="@color/field_bg"/><corners android:radius="@dimen/radius_control"/><stroke android:width="@dimen/hairline" android:color="@color/field_outline"/></shape></item>
</selector>
