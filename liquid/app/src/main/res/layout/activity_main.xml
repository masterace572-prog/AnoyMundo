<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <ScrollView
        android:id="@+id/mainScroll"
        style="@style/Scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/screen_padding">
            <LinearLayout
                android:id="@+id/mainHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_28"
                android:gravity="center_vertical"
                android:minHeight="@dimen/space_72"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_12">
                <LinearLayout
                    android:id="@+id/homeHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/homeKicker"
                        style="@style/Text.Kicker.Tertiary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_name" />
                    <TextView
                        android:id="@+id/homeTitle"
                        style="@style/Text.TitleL"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:accessibilityHeading="true"
                        android:text="@string/home_title" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/homeUtilities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageButton
                        android:id="@+id/helpButton"
                        style="@style/IconButton"
                        android:layout_marginStart="@dimen/space_12"
                        android:contentDescription="@string/help_open"
                        app:srcCompat="@drawable/ic_help" />
                    <ImageButton
                        android:id="@+id/settingsButton"
                        style="@style/IconButton"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_marginEnd="@dimen/icon_button_edge"
                        android:contentDescription="@string/settings_open"
                        app:srcCompat="@drawable/ic_settings" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/licenceCard"
                style="@style/Widget.Anoy.Card.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20"
                    android:background="@drawable/bg_hero">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/licenceLabel"
                            style="@style/Text.Kicker"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/licence_expires_in" />
                        <TextView
                            android:id="@+id/statusValue"
                            style="@style/Text.Caption.Medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:drawablePadding="@dimen/space_8"
                            android:gravity="center_vertical"
                            android:text="@string/dash"
                            android:background="@drawable/bg_status"
                            android:paddingStart="@dimen/space_12"
                            android:paddingEnd="@dimen/space_12"
                            android:paddingTop="@dimen/space_8"
                            android:paddingBottom="@dimen/space_8" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/timeLeftValue"
                        style="@style/Text.Countdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="@string/dash" />
                    <TextView
                        android:id="@+id/expiresValue"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFeatureSettings="tnum" />
                    <TextView
                        android:id="@+id/licenceChecked"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textColor="@color/text_tertiary"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelNoteCard"
                style="@style/Widget.Anoy.Card.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:focusable="true"
                android:visibility="gone"
                android:layout_marginTop="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">
                    <ImageView
                        android:layout_width="@dimen/icon_inline"
                        android:layout_height="@dimen/icon_inline"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_megaphone"
                        app:tint="@color/notice_icon" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/panelNoteKicker"
                            style="@style/Text.Kicker.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/announcement" />
                        <TextView
                            android:id="@+id/panelNote"
                            style="@style/Text.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/gameUpdateCard"
                style="@style/Widget.Anoy.Card.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:focusable="true"
                android:visibility="gone"
                android:layout_marginTop="@dimen/space_16">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">
                    <ImageView
                        android:layout_width="@dimen/icon_inline"
                        android:layout_height="@dimen/icon_inline"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_triangle_alert"
                        app:tint="@color/notice_icon" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.Kicker.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/game_update_kicker" />
                        <TextView
                            android:id="@+id/gameUpdateText"
                            style="@style/Text.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/Text.Kicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_28"
                android:layout_marginStart="@dimen/space_4"
                android:accessibilityHeading="true"
                android:text="@string/section_game" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/gameCard"
                style="@style/Widget.Anoy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">
                    <LinearLayout
                        android:id="@+id/gameHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/gameTile"
                            android:layout_width="@dimen/game_tile"
                            android:layout_height="@dimen/game_tile"
                            android:contentDescription="@string/game_icon_description"
                            android:padding="@dimen/game_icon_inset"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Anoy.GameTile"
                            app:srcCompat="@drawable/ic_game_bgmi"
                            app:strokeColor="@color/hairline"
                            app:strokeWidth="@dimen/hairline" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/gameValue"
                                    style="@style/Text.TitleM"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:text="@string/game_name" />
                                <TextView
                                    android:id="@+id/gameVersion"
                                    style="@style/Text.Mono"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:fontFeatureSettings="tnum"
                                    android:maxLines="1"
                                    android:visibility="gone" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/libraryValue"
                                style="@style/Text.Mono"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/text_tertiary" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/stateCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_20"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_state_well"
                        android:padding="@dimen/space_16">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Text.Micro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/row_state" />
                            <TextView
                                android:id="@+id/gameStateValue"
                                style="@style/Text.BodyL.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:drawablePadding="@dimen/space_8"
                                android:gravity="center_vertical"
                                android:text="@string/dash" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Text.Micro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/row_server" />
                            <TextView
                                android:id="@+id/serverValue"
                                style="@style/Text.BodyL.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:drawablePadding="@dimen/space_8"
                                android:gravity="center_vertical"
                                android:text="@string/dash" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@null"
        android:orientation="vertical"
        android:tag="snackbar_anchor"
        android:paddingBottom="@dimen/space_12"
        android:paddingTop="@dimen/space_8">
        <View
            android:id="@+id/actionDivider"
            style="@style/Divider"
            android:visibility="invisible"
            android:layout_marginStart="@dimen/space_32"
            android:layout_marginEnd="@dimen/space_32"
            android:background="@color/transparent" />
        <com.xlox.ui.GlassLayout
            android:id="@+id/actionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="@dimen/space_12"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding">
            <TextView
                android:id="@+id/statusMessage"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:visibility="gone" />
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/taskProgress"
                style="@style/Widget.Anoy.Progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:importantForAccessibility="no"
                android:visibility="gone" />
            <com.xlox.ui.GlassButton
                android:id="@+id/primaryAction"
                style="@style/Widget.Anoy.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launch" />
        </com.xlox.ui.GlassLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/settingsPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">
        <ScrollView
            android:id="@+id/settingsScroll"
            style="@style/Scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/settingsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/space_12"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/space_32">
                <LinearLayout
                    android:id="@+id/settingsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="@dimen/space_8">
                    <ImageButton
                        android:id="@+id/settingsBack"
                        style="@style/IconButton"
                        android:contentDescription="@string/settings_back"
                        app:srcCompat="@drawable/ic_chevron_left" />
                    <TextView
                        android:id="@+id/settingsTitle"
                        style="@style/Text.TitleL"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_16"
                        android:accessibilityHeading="true"
                        android:text="@string/settings" />
                </LinearLayout>
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_licence" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/licenceGroup"
                    style="@style/Widget.Anoy.Group">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/licenceKeyRow"
                            style="@style/Row"
                            android:paddingEnd="@dimen/space_4"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView style="@style/RowIcon" app:srcCompat="@drawable/ic_key_round" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/Text.RowMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/licence_key" />
                                <TextView
                                    android:id="@+id/licenceKeyValue"
                                    style="@style/Text.Mono.Key"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:gravity="start"
                                    android:singleLine="true"
                                    android:text="@string/dash" />
                            </LinearLayout>
                            <ImageButton
                                android:id="@+id/licenceKeyEye"
                                style="@style/IconButton.Inline"
                                android:contentDescription="@string/licence_key_show"
                                app:srcCompat="@drawable/ic_eye" />
                        </LinearLayout>
                        <View style="@style/RowDivider" />
                        <LinearLayout style="@style/Row" android:background="@null" android:focusable="true">
                            <ImageView style="@style/RowIcon" app:srcCompat="@drawable/ic_shield_check" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/Text.RowMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_licence_status" />
                                <TextView
                                    android:id="@+id/licenceStatusValue"
                                    style="@style/Text.RowDetail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:gravity="start"
                                    android:text="@string/dash" />
                            </LinearLayout>
                        </LinearLayout>
                        <View style="@style/RowDivider" />
                        <LinearLayout style="@style/Row" android:background="@null" android:focusable="true">
                            <ImageView style="@style/RowIcon" app:srcCompat="@drawable/ic_calendar_days" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/Text.RowMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_licence_expires" />
                                <TextView
                                    android:id="@+id/licenceExpiresValue"
                                    style="@style/Text.RowDetail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:gravity="start"
                                    android:text="@string/dash" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_updates" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/updatesGroup"
                    style="@style/Widget.Anoy.Group">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/checkUpdateRow"
                            style="@style/Row"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView style="@style/RowIcon" app:srcCompat="@drawable/ic_refresh_cw" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/Text.RowLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_check_updates" />
                                <TextView
                                    android:id="@+id/checkUpdateCaption"
                                    style="@style/Text.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:accessibilityLiveRegion="polite"
                                    android:text="@string/settings_not_checked" />
                                <TextView
                                    android:id="@+id/checkUpdateValue"
                                    style="@style/Text.Caption.Medium"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:accessibilityLiveRegion="polite"
                                    android:visibility="gone" />
                            </LinearLayout>
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/checkUpdateSpinner"
                                style="@style/Widget.Anoy.StatusSpinner"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:importantForAccessibility="no"
                                android:indeterminate="true"
                                android:visibility="gone" />
                            <ImageView
                                android:id="@+id/checkUpdateIcon"
                                style="@style/RowGlyph"
                                app:srcCompat="@drawable/ic_check"
                                app:tint="@color/success"
                                android:visibility="gone" />
                            <ImageView
                                android:id="@+id/checkUpdateGlyph"
                                style="@style/RowGlyph"
                                app:srcCompat="@drawable/ic_chevron_right" />
                        </LinearLayout>
                        <View style="@style/RowDivider" />
                        <LinearLayout
                            android:id="@+id/redownloadRow"
                            style="@style/Row"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView style="@style/RowIcon" app:srcCompat="@drawable/ic_download" />
                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_redownload" />
                            <ImageView style="@style/RowGlyph" app:srcCompat="@drawable/ic_chevron_right" />
                        </LinearLayout>
                        <View style="@style/RowDivider" />
                        <LinearLayout style="@style/Row" android:background="@null" android:focusable="true">
                            <ImageView style="@style/RowIcon" app:srcCompat="@drawable/ic_layers" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/Text.RowMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_library_version" />
                                <TextView
                                    android:id="@+id/libraryVersionValue"
                                    style="@style/Text.Mono"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:gravity="start"
                                    android:text="@string/dash" />
                            </LinearLayout>
                        </LinearLayout>
                        <View style="@style/RowDivider" />
                        <LinearLayout style="@style/Row" android:background="@null" android:focusable="true">
                            <ImageView style="@style/RowIcon" app:srcCompat="@drawable/ic_info" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/Text.RowMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_version" />
                                <TextView
                                    android:id="@+id/appVersionValue"
                                    style="@style/Text.Mono"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:gravity="start"
                                    android:text="@string/dash" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_appearance" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/appearanceGroup"
                    style="@style/Widget.Anoy.Group">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout style="@style/Row" android:background="@null">
                            <ImageView style="@style/RowIcon" app:srcCompat="@drawable/ic_sparkles" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/glassEffectsLabel"
                                    style="@style/Text.RowLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:labelFor="@id/glassEffects"
                                    android:text="@string/glass_effects" />
                                <TextView
                                    style="@style/Text.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:text="@string/glass_effects_summary" />
                            </LinearLayout>
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/glassEffects"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:minHeight="@dimen/touch_target"
                                android:contentDescription="@string/glass_effects" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_device" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/deviceCard"
                    style="@style/Widget.Anoy.Group">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout style="@style/Row" android:background="@null" android:focusable="true">
                            <ImageView style="@style/RowIcon" app:srcCompat="@drawable/ic_smartphone" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/Text.RowMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_model" />
                                <TextView
                                    android:id="@+id/modelValue"
                                    style="@style/Text.RowDetail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:gravity="start"
                                    android:text="@string/dash" />
                            </LinearLayout>
                        </LinearLayout>
                        <View style="@style/RowDivider" />
                        <LinearLayout style="@style/Row" android:background="@null" android:focusable="true">
                            <ImageView style="@style/RowIcon" app:srcCompat="@drawable/ic_info" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/Text.RowMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_android" />
                                <TextView
                                    android:id="@+id/androidValue"
                                    style="@style/Text.RowDetail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:gravity="start"
                                    android:text="@string/dash" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_report" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/reportCard"
                    style="@style/Widget.Anoy.Group">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/settingsTelegram"
                            style="@style/Row"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView style="@style/RowIcon" app:srcCompat="@drawable/ic_send" />
                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_telegram" />
                            <ImageView style="@style/RowGlyph" app:srcCompat="@drawable/ic_arrow_up_right" />
                        </LinearLayout>
                        <View style="@style/RowDivider" />
                        <LinearLayout
                            android:id="@+id/settingsCopySupport"
                            style="@style/Row"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView style="@style/RowIcon" app:srcCompat="@drawable/ic_clipboard" />
                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_copy_support" />
                            <ImageView style="@style/RowGlyph" app:srcCompat="@drawable/ic_chevron_right" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_account" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/accountCard"
                    style="@style/Widget.Anoy.Group">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/signOut"
                            style="@style/Row.Danger"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                style="@style/RowIcon"
                                app:srcCompat="@drawable/ic_log_out"
                                app:tint="@color/danger" />
                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/sign_out"
                                android:textColor="@color/danger" />
                            <ImageView style="@style/RowGlyph" app:srcCompat="@drawable/ic_chevron_right" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
