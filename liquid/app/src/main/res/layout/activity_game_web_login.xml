<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameWebRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter_wide"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/gutter_wide"
        android:paddingBottom="@dimen/space_12">
        <TextView
            style="@style/Text.BodyS.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/game_web_title" />
        <TextView
            android:id="@+id/gameWebOrigin"
            style="@style/Text.Mono.Footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:ellipsize="middle"
            android:singleLine="true" />
        <TextView
            android:id="@+id/gameWebError"
            style="@style/Text.BodyS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/danger"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/gameWebClose"
            style="@style/Widget.Anoy.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/game_web_close" />
    </LinearLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/gameWebProgress"
        style="@style/Widget.Anoy.Progress.Sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="false" />
    <android.webkit.WebView
        android:id="@+id/gameWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
