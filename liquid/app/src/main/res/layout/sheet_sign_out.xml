<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/signOutRoot"
    style="@style/Sheet.Draggable">
    <View style="@style/SheetHandle" />
    <ImageView style="@style/SheetSymbol" app:srcCompat="@drawable/ic_log_out" />
    <TextView
        style="@style/Text.Kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_section_account" />
    <TextView
        android:id="@+id/signOutTitle"
        style="@style/Text.TitleM"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kicker_gap"
        android:accessibilityHeading="true"
        android:text="@string/sign_out_title" />
    <TextView
        style="@style/Text.BodyS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/sign_out_message" />
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Anoy.Group.InSheet"
        android:layout_marginTop="@dimen/space_20">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/signOutConfirm"
                style="@style/Row.InSheet"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:gravity="start|center_vertical">
                <TextView
                    style="@style/Text.BodyL.Medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_out" />
                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/sign_out_keep_caption" />
            </LinearLayout>
            <View style="@style/RowDivider" />
            <LinearLayout
                android:id="@+id/signOutForget"
                style="@style/Row.Danger.InSheet"
                android:clickable="true"
                android:contentDescription="@string/forget_key_description"
                android:focusable="true"
                android:orientation="vertical"
                android:gravity="start|center_vertical">
                <TextView
                    style="@style/Text.BodyL.Medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/forget_key"
                    android:textColor="@color/danger" />
                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/forget_key_caption" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.xlox.ui.GlassButton
        android:id="@+id/signOutCancel"
        style="@style/Widget.Anoy.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/cancel" />
</LinearLayout>
