<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only light/dark preview of every B.6 component. Not shipped in release. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/previewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Widget.Ds.TopAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12">

        <TextView
            style="@style/TextAppearance.Ds.HeadlineSmall"
            android:layout_width="@dimen/space_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ds_preview_title" />

        <ImageButton
            android:id="@+id/previewThemeToggle"
            style="@style/Widget.Ds.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/theme_toggle"
            android:src="@drawable/ds_ic_dark_mode" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_0"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_24"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_48">

            <!-- Type scale -->
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_section_type" />
            <TextView style="@style/TextAppearance.Ds.DisplayLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="@string/ds_display" />
            <TextView style="@style/TextAppearance.Ds.HeadlineLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_headline" />
            <TextView style="@style/TextAppearance.Ds.TitleLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_title" />
            <TextView style="@style/TextAppearance.Ds.BodyLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_body" />
            <TextView style="@style/TextAppearance.Ds.LabelMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_label" />
            <TextView style="@style/TextAppearance.Ds.Code" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_code" />

            <!-- Buttons -->
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/ds_section_buttons" />
            <com.xlox.ui.designsystem.PrimaryButton
                android:id="@+id/previewPrimary"
                style="@style/Widget.Ds.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/ds_primary" />
            <com.xlox.ui.designsystem.PrimaryButton
                android:id="@+id/previewLoadingButton"
                style="@style/Widget.Ds.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/ds_primary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatButton style="@style/Widget.Ds.Button.Secondary" android:layout_width="wrap_content" android:layout_height="@dimen/button_height" android:minWidth="@dimen/touch_target" android:text="@string/ds_secondary" />
                <androidx.appcompat.widget.AppCompatButton style="@style/Widget.Ds.Button.Text" android:layout_width="wrap_content" android:layout_height="@dimen/button_height" android:minWidth="@dimen/touch_target" android:text="@string/ds_text" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton style="@style/Widget.Ds.Button.Secondary" android:layout_width="wrap_content" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/space_8" android:enabled="false" android:minWidth="@dimen/touch_target" android:text="@string/ds_secondary" />

            <!-- Text fields -->
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/ds_section_field" />
            <TextView style="@style/TextAppearance.Ds.LabelMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:text="@string/ds_field_label" android:textColor="@color/text_secondary" />
            <EditText style="@style/Widget.Ds.TextField" android:layout_width="match_parent" android:layout_height="@dimen/field_height" android:layout_marginTop="@dimen/space_8" android:background="@drawable/ds_field" android:inputType="text" />
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="@string/ds_field_helper" />
            <EditText style="@style/Widget.Ds.TextField" android:layout_width="match_parent" android:layout_height="@dimen/field_height" android:layout_marginTop="@dimen/space_16" android:background="@drawable/ds_field_error" android:inputType="text" />
            <TextView style="@style/TextAppearance.Ds.BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="@string/ds_field_error" android:textColor="@color/error" />

            <!-- Cards and list rows -->
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/ds_section_cards" />
            <LinearLayout style="@style/Widget.Ds.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:orientation="vertical">
                <TextView style="@style/TextAppearance.Ds.HeadlineSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_card_headline" />
                <TextView style="@style/TextAppearance.Ds.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="@string/ds_card_body" />
            </LinearLayout>
            <LinearLayout style="@style/Widget.Ds.ListRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <ImageView android:layout_width="@dimen/icon_bar" android:layout_height="@dimen/icon_bar" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ds_ic_link" />
                <TextView style="@style/TextAppearance.Ds.BodyMedium" android:layout_width="@dimen/space_0" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:layout_weight="1" android:text="@string/ds_row_single" />
                <TextView style="@style/TextAppearance.Ds.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_row_value" />
                <ImageView android:layout_width="@dimen/icon_inline" android:layout_height="@dimen/icon_inline" android:layout_marginStart="@dimen/space_8" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ds_ic_chevron_right" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/divider" android:background="@drawable/ds_divider" />
            <LinearLayout style="@style/Widget.Ds.ListRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/list_item_double" android:orientation="horizontal">
                <FrameLayout android:layout_width="@dimen/avatar_size" android:layout_height="@dimen/avatar_size" android:background="@drawable/ds_avatar">
                    <ImageView android:layout_width="@dimen/icon_inline" android:layout_height="@dimen/icon_inline" android:layout_gravity="center" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/ds_ic_person" />
                </FrameLayout>
                <LinearLayout android:layout_width="@dimen/space_0" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.Ds.BodyLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_row_double" />
                    <TextView style="@style/TextAppearance.Ds.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_row_supporting" />
                </LinearLayout>
                <TextView style="@style/TextAppearance.Ds.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_row_value" />
            </LinearLayout>

            <!-- Chips -->
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/ds_section_chips" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:orientation="horizontal">
                <com.google.android.material.chip.Chip style="@style/Widget.Ds.Chip" android:layout_width="wrap_content" android:layout_height="@dimen/chip_height" android:checked="true" android:text="@string/ds_chip_selected" />
                <com.google.android.material.chip.Chip style="@style/Widget.Ds.Chip" android:layout_width="wrap_content" android:layout_height="@dimen/chip_height" android:layout_marginStart="@dimen/space_8" android:text="@string/ds_chip_other" />
            </LinearLayout>

            <!-- Tabs -->
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/ds_section_tabs" />
            <com.google.android.material.tabs.TabLayout
                style="@style/Widget.Ds.Tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_tab_one" />
                <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_tab_two" />
                <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_tab_three" />
            </com.google.android.material.tabs.TabLayout>

            <!-- Progress -->
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/ds_section_progress" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:gravity="center_vertical" android:orientation="horizontal">
                <ProgressBar style="@style/Widget.Ds.Progress.Linear" android:layout_width="@dimen/space_0" android:layout_height="@dimen/progress_linear" android:layout_weight="1" android:max="100" android:progress="42" />
                <ProgressBar android:layout_width="@dimen/progress_circular" android:layout_height="@dimen/progress_circular" android:layout_marginStart="@dimen/space_16" android:contentDescription="@string/state_loading" android:indeterminate="true" android:indeterminateTint="@color/text_secondary" />
            </LinearLayout>
            <com.xlox.ui.designsystem.StateView
                android:id="@+id/previewLoadingState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/ds_card"
                android:padding="@dimen/card_padding" />

            <!-- Status -->
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/ds_section_status" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:layout_width="@dimen/status_rule" android:layout_height="@dimen/list_item_single" android:background="@color/success" />
                <TextView style="@style/Widget.Ds.StatusText.Success" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:text="@string/ds_status_ok" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:layout_width="@dimen/status_rule" android:layout_height="@dimen/list_item_single" android:background="@color/error" />
                <TextView style="@style/Widget.Ds.StatusText.Error" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:text="@string/ds_status_error" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:layout_width="@dimen/status_rule" android:layout_height="@dimen/list_item_single" android:background="@color/warning" />
                <TextView style="@style/Widget.Ds.StatusText.Warning" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:text="@string/ds_status_warning" />
            </LinearLayout>

            <!-- Dialogs and snackbars -->
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/ds_section_dialog" />
            <LinearLayout style="@style/Widget.Ds.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:background="@drawable/ds_dialog" android:orientation="vertical">
                <TextView style="@style/TextAppearance.Ds.HeadlineSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_dialog_headline" />
                <TextView style="@style/TextAppearance.Ds.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="@string/ds_dialog_body" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:gravity="end" android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatButton style="@style/Widget.Ds.Button.Text" android:layout_width="wrap_content" android:layout_height="@dimen/button_height" android:minWidth="@dimen/touch_target" android:text="@string/ds_dialog_cancel" />
                    <androidx.appcompat.widget.AppCompatButton style="@style/Widget.Ds.Button.Text" android:layout_width="wrap_content" android:layout_height="@dimen/button_height" android:minWidth="@dimen/touch_target" android:text="@string/ds_dialog_confirm" android:textColor="@color/error" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:background="@drawable/ds_snackbar" android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/space_12">
                <TextView style="@style/TextAppearance.Ds.BodyMedium" android:layout_width="@dimen/space_0" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ds_snackbar_text" />
                <androidx.appcompat.widget.AppCompatButton style="@style/Widget.Ds.Button.Text" android:layout_width="wrap_content" android:layout_height="@dimen/button_height" android:minWidth="@dimen/touch_target" android:text="@string/dismiss" />
            </LinearLayout>
            <com.xlox.ui.designsystem.StateView
                android:id="@+id/previewErrorState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/ds_card"
                android:padding="@dimen/card_padding" />

            <!-- Empty state -->
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/ds_section_empty" />
            <com.xlox.ui.designsystem.StateView
                android:id="@+id/previewEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/ds_card"
                android:padding="@dimen/card_padding" />

            <!-- Selection controls -->
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/ds_section_controls" />
            <androidx.appcompat.widget.SwitchCompat style="@style/Widget.Ds.Switch" android:layout_width="wrap_content" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_12" android:checked="true" android:text="@string/ds_switch" />
            <androidx.appcompat.widget.AppCompatCheckBox style="@style/Widget.Ds.CheckBox" android:layout_width="wrap_content" android:layout_height="@dimen/touch_target" android:checked="true" android:text="@string/ds_checkbox" />
            <androidx.appcompat.widget.AppCompatRadioButton style="@style/Widget.Ds.RadioButton" android:layout_width="wrap_content" android:layout_height="@dimen/touch_target" android:checked="true" android:text="@string/ds_radio" />


            <!-- Bottom sheet surface -->
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/ds_section_sheet" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/ds_sheet"
                android:orientation="vertical"
                android:padding="@dimen/space_24">
                <TextView style="@style/TextAppearance.Ds.HeadlineSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ds_sheet_headline" />
                <TextView style="@style/TextAppearance.Ds.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="@string/ds_sheet_body" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:layout_marginTop="@dimen/space_20"
                    android:background="@drawable/ds_chip"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="@string/ds_chip_selected"
                    android:textAppearance="@style/TextAppearance.Ds.LabelMedium"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
            <!-- Icons -->
            <TextView style="@style/TextAppearance.Ds.Tertiary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/ds_section_icons" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_arrow_back" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_calendar_month" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_check_circle" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_chevron_right" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_close" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_code" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_content_paste" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_credit_card" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_dark_mode" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_devices" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_download" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_error" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_info" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_light_mode" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_link" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_person" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_play_arrow" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_refresh" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_schedule" />
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ds_ic_settings" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="@dimen/icon_bar"
                android:layout_height="@dimen/icon_bar"
