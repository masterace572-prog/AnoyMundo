<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_disabled" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <layer-list xmlns:android="http://schemas.android.com/apk/res/android">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_pressed" />
                    <corners android:radius="@dimen/radius_button" />
                </shape>
            </item>
            <item android:left="@dimen/divider" android:top="@dimen/divider"
                  android:right="@dimen/divider" android:bottom="@dimen/divider">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_button" />
                    <gradient android:angle="270"
                        android:startColor="@color/top_light"
                        android:centerColor="@color/top_light_soft"
                        android:endColor="@color/transparent"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list xmlns:android="http://schemas.android.com/apk/res/android">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent" />
                    <corners android:radius="@dimen/radius_button" />
                </shape>
            </item>
            <item android:left="@dimen/divider" android:top="@dimen/divider"
                  android:right="@dimen/divider" android:bottom="@dimen/divider">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_button" />
                    <gradient android:angle="270"
                        android:startColor="@color/top_light"
                        android:centerColor="@color/top_light_soft"
                        android:endColor="@color/transparent"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
