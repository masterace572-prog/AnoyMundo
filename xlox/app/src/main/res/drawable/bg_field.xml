<?xml version="1.0" encoding="utf-8"?>
<!-- 56 dp field, 14 dp radius: hairline at rest, 1.5 dp blue focus, red on error. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="150">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/danger" />
            <corners android:radius="@dimen/field_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/blue" />
            <corners android:radius="@dimen/field_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/hairline" android:color="@color/hairline" />
            <corners android:radius="@dimen/field_radius" />
        </shape>
    </item>
</selector>
