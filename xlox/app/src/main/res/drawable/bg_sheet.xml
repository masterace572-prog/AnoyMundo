<?xml version="1.0" encoding="utf-8"?>
<!-- Sheet surface: surface-2, 28 dp top corners, a 1 dp hairline on the top edge only. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hairline" />
            <corners android:topLeftRadius="@dimen/sheet_radius" android:topRightRadius="@dimen/sheet_radius" />
        </shape>
    </item>
    <item android:top="@dimen/hairline">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:topLeftRadius="@dimen/sheet_radius" android:topRightRadius="@dimen/sheet_radius" />
        </shape>
    </item>
</layer-list>
