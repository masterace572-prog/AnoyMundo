<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_recessed" />
            <corners android:radius="@dimen/radius_splash" />
            <stroke android:width="@dimen/divider" android:color="@color/hairline" />
        </shape>
    </item>
    <item android:top="@dimen/divider" android:bottom="@dimen/divider">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_splash" />
            <gradient android:angle="270" android:startColor="@color/top_light"
                android:endColor="@color/transparent" android:type="linear" />
        </shape>
    </item>
</layer-list>
