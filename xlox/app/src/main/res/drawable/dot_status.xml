<?xml version="1.0" encoding="utf-8"?>
<!-- 6 dp dot centred in a 14 dp box (the status-line glyph size): the splash
     failure mark, tinted amber. Inset (not layer-list item sizes, API 23+). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="4dp">
    <shape android:shape="oval">
        <solid android:color="@color/white" />
    </shape>
</inset>
