<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_wash" />
            <corners android:radius="@dimen/radius_pill" />
            <stroke android:width="@dimen/divider" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_recessed" />
            <corners android:radius="@dimen/radius_pill" />
            <stroke android:width="@dimen/divider" android:color="@color/hairline_strong" />
        </shape>
    </item>
</selector>
