<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same appearance, dark system bars. All palette entries resolve from
         values-night/colors.xml, so layouts and drawables need no changes. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/anoyBlue</item>
        <item name="colorPrimaryDark">@color/anoyBluePress</item>
        <item name="colorAccent">@color/anoyBlue</item>
        <item name="android:colorBackground">@color/anoyBg</item>
        <item name="android:windowBackground">@color/anoyBg</item>
        <item name="android:statusBarColor">@color/anoyBg</item>
        <item name="android:navigationBarColor">@color/anoyBg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:editTextColor">@color/anoyText</item>
        <item name="android:textColorHint">@color/anoyTextTertiary</item>
        <item name="android:textColorPrimary">@color/anoyText</item>
        <item name="android:textColorSecondary">@color/anoyTextSecondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
