<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ always draws a system splash. Keep it plain black with no icon,
     so the custom splash (text only) follows without any logo or flash. -->
<resources>
    <style name="AppTheme.Splash">
        <item name="android:windowSplashScreenBackground">@color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/black</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
