    <string name="help_launch_title">Launching the game</string>
    <string name="help_launch_body">Sign in, allow the three access items if Anoy asks (All files access, Files, Install unknown apps), then tap Launch. The first time, Anoy copies the game files before the game opens.</string>
    <string name="help_access_title">Files missing or access needed</string>
    <string name="help_access_body">Turn on All files access, Files and Install unknown apps for Anoy, then come back and tap Launch. Settings shows whether anything is still off.</string>
    <string name="help_renew_title">Renewing your licence</string>
    <string name="help_renew_body">Tap Renew on the licence card, or Help on Telegram, and message support. The new time shows when you come back to Anoy.</string>
