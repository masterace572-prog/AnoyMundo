<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Kept for compatibility with the original source; AppTheme (styles.xml)
         is the theme actually applied by the manifest. -->
    <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/anoyBlue</item>
        <item name="colorOnPrimary">@color/anoyOnBlue</item>
        <item name="colorSecondary">@color/anoyBlue</item>
        <item name="android:colorBackground">@color/anoyBg</item>
        <item name="android:statusBarColor">@color/anoyBg</item>
        <item name="android:navigationBarColor">@color/anoyBg</item>
    </style>
    <style name="ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/anoyBlue</item>
    </style>
    <style name="CustomCheckbox02" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:button">@drawable/checkbox_selector</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:buttonTint">@color/anoyBlue</item>
    </style>
</resources>
