<?xml version="1.0" encoding="utf-8"?>
<!-- One dark theme: black background, white text, blue actions. -->
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/blue</item>
        <item name="colorControlActivated">@color/blue</item>
        <item name="colorControlNormal">@color/text_tertiary</item>
        <item name="colorControlHighlight">@color/ripple_light</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textColorHighlight">@color/blue_disabled</item>
        <item name="android:textColorLink">@color/blue</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:windowAnimationStyle">@style/Anim.Fade</item>
    </style>

    <!-- Launcher entry: identical black window, nothing else, so there is no flash. -->
    <style name="AppTheme.Splash">
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Anim.Fade" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>

    <style name="AnoyDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="colorAccent">@color/blue</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <!-- Scroll containers: never tint the black page grey when focused. -->
    <style name="Scroll" parent="">
        <item name="android:overScrollMode">never</item>
        <item name="android:scrollbars">none</item>
    </style>

    <!-- ============================== text ============================== -->
    <!-- No text style sets a background: text always sits on the black page. -->
    <style name="Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.LargeTitle">
        <item name="android:textSize">@dimen/text_large_title</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>

    <style name="Text.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Secondary">
        <item name="android:textSize">@dimen/text_callout</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Text.Footnote">
        <item name="android:textSize">@dimen/text_footnote</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Text.SectionHeader">
        <item name="android:textSize">@dimen/text_footnote</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Text.RowLabel">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.RowValue">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Text.Error">
        <item name="android:textSize">@dimen/text_footnote</item>
        <item name="android:textColor">@color/red</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <!-- ============================= buttons ============================ -->
    <style name="Button.Primary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Button.Text" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:background">@drawable/bg_text_button</item>
        <item name="android:textColor">@color/link_text</item>
        <item name="android:textSize">@dimen/text_callout</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Spinner">
        <item name="android:layout_width">@dimen/spinner_size</item>
        <item name="android:layout_height">@dimen/spinner_size</item>
        <item name="android:indeterminate">true</item>
        <item name="android:indeterminateTint">@color/white</item>
        <item name="android:indeterminateTintMode">src_in</item>
    </style>
</resources>
