<?xml version="1.0" encoding="utf-8"?>
<!-- Countdown cell used by the hidden legacy controls. No placeholder text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="@dimen/list_item_double"
    android:layout_weight="1"
    android:background="@drawable/ds_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_8">

    <TextView
        android:id="@+id/timeValue"
        style="@style/TextAppearance.Ds.TitleMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/timeLabel"
        style="@style/TextAppearance.Ds.Tertiary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4" />
</LinearLayout>
