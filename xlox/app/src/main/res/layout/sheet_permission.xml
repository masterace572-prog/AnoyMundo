<?xml version="1.0" encoding="utf-8"?>
<!-- Explains a special-access settings page before Anoy opens it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/permExplainRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_32"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_24">

    <TextView
        android:id="@+id/permExplainTitle"
        style="@style/Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        tools:text="@string/perm_explain_all_files_title" />

    <TextView
        android:id="@+id/permExplainMessage"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        tools:text="@string/perm_explain_all_files_message" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/permExplainContinue"
        style="@style/Widget.Anoy.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/perm_explain_continue" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/permExplainNotNow"
        style="@style/Widget.Anoy.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/not_now" />
</LinearLayout>
