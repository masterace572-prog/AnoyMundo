<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash (spec 3.1), true black, 24 dp gutters. The story is unchanged:
    splashMark    the system-splash wordmark in the same place (window centre);
                  it cross-fades out as the film starts, so the hand-off is seamless
    splashLockup  kicker "WELCOME TO", 12 dp, "Anoy Loader" (Wordmark), centred
                  at ~42 % of the height; "Loader" dissolves into "Hax" in the slot
    splashVersion "v2.3.4", Mono 12 tertiary, top right, 24 dp from the edges
    status        bottom centre, 32 dp above the navigation inset: a 14 dp spinner
                  (or a check / amber dot) + 8 dp + Caption; below it a reserved
                  detail line (slow connection, or the failure reason) and, only
                  after a failure, Try again
  Insets are added in code (SplashActivity).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/splashMark"
        android:layout_width="@dimen/splash_mark"
        android:layout_height="@dimen/splash_mark"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_mark" />

    <!-- 42 : 58 split puts the lockup's centre at ~42 % of the height. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="42" />

        <LinearLayout
            android:id="@+id/splashLockup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:alpha="0"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter_wide"
            android:paddingEnd="@dimen/gutter_wide">

            <TextView
                android:id="@+id/splashGreeting"
                style="@style/Text.Kicker.Splash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_greeting" />

            <LinearLayout
                android:id="@+id/splashName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/splashAnoy"
                    style="@style/Text.Wordmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <FrameLayout
                    android:id="@+id/splashSlot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8">

                    <TextView
                        android:id="@+id/splashLoader"
                        style="@style/Text.Wordmark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/splash_loader" />

                    <TextView
                        android:id="@+id/splashHax"
                        style="@style/Text.Wordmark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        android:text="@string/splash_hax" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="58" />
    </LinearLayout>

    <TextView
        android:id="@+id/splashVersion"
        style="@style/Text.Mono.Footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/gutter_wide"
        android:layout_marginEnd="@dimen/gutter_wide"
        android:alpha="0" />

    <LinearLayout
        android:id="@+id/splashStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/space_32"
        android:alpha="0"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter_wide"
        android:paddingEnd="@dimen/gutter_wide">

        <!-- 2.3.1: spinner / glyph + text form one wrap-content group, centred in
             the bar, so a longer or shorter status grows from the centre. -->
        <LinearLayout
            android:id="@+id/splashStatusRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/status_row_min_height"
            android:orientation="horizontal">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/splashStatusSpinner"
                style="@style/Widget.Anoy.StatusSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_8"
                android:importantForAccessibility="no"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/splashStatus"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:drawablePadding="@dimen/space_8"
                android:gravity="center_vertical"
                android:text="@string/splash_status_init" />
        </LinearLayout>

        <TextView
            android:id="@+id/splashStatusDetail"
            style="@style/Text.BodyS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_horizontal"
            android:maxWidth="@dimen/max_content_width"
            android:textAlignment="center"
            android:visibility="invisible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/splashRetry"
            style="@style/Widget.Anoy.Button.Tonal.OnBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:minWidth="@dimen/retry_min_width"
            android:text="@string/splash_retry"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
