<?xml version="1.0" encoding="utf-8"?>
<!-- Same black / Manrope / blue language as Home. The system launch mark
     stays matched; the reserved word slot changes without relayout per frame. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/splashMark"
        android:layout_width="@dimen/splash_mark"
        android:layout_height="@dimen/splash_mark"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_mark" />

    <!-- 42 : 58 split puts the lockup's centre at ~42 % of the height. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="42" />

        <LinearLayout
            android:id="@+id/splashLockup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:alpha="0"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <TextView
                android:id="@+id/splashGreeting"
                style="@style/Text.Splash.Kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_greeting" />

            <LinearLayout
                android:id="@+id/splashName"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/splashAnoy"
                    style="@style/Text.Splash.Wordmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <FrameLayout
                    android:id="@+id/splashSlot"
                    android:clipChildren="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8">

                    <TextView
                        android:id="@+id/splashLoader"
                        style="@style/Text.Splash.Wordmark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/splash_loader" />

                    <TextView
                        android:id="@+id/splashHax"
                        style="@style/Text.Splash.Wordmark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        android:textColor="@color/accent"
                        android:text="@string/splash_hax" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="58" />
    </LinearLayout>

    <TextView
        android:id="@+id/splashVersion"
        style="@style/Text.Dashboard.Footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:alpha="0" />

    <LinearLayout
        android:id="@+id/splashStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/space_32"
        android:alpha="0"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <!-- 2.3.1: spinner / glyph + text form one wrap-content group, centred in
             the bar, so a longer or shorter status grows from the centre. -->
        <LinearLayout
            android:id="@+id/splashStatusRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/status_row_min_height"
            android:orientation="horizontal">

            <!-- 2.3.7: quiet Lottie (anoy_arc loop / anoy_check one-shot), 24 dp.
                 The arc is 15 dp across inside it, like the old 14 dp spinner;
                 4 dp + its inset keep the old ~8 dp gap to the text. -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/splashStatusMark"
                android:layout_width="@dimen/lottie_status"
                android:layout_height="@dimen/lottie_status"
                android:layout_marginEnd="@dimen/space_4"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/splashStatus"
                style="@style/Text.Dashboard.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:drawablePadding="@dimen/space_8"
                android:gravity="center_vertical"
                android:text="@string/splash_status_init" />
        </LinearLayout>

        <TextView
            android:id="@+id/splashStatusDetail"
            style="@style/Text.Dashboard.Notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_horizontal"
            android:maxWidth="@dimen/max_content_width"
            android:textAlignment="center"
            android:visibility="invisible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/splashRetry"
            style="@style/Widget.Anoy.Button.Auth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:minWidth="@dimen/retry_min_width"
            android:text="@string/splash_retry"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
