<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash: the Lottie monogram sits exactly where the system splash icon sits
  (centred in the full window, 288 dp canvas), so the hand-off is invisible.
  The mark lifts 36 dp inside its canvas; the wordmark is real text (Inter)
  that fades in 24 dp under the lifted mark. The version footer sits 24 dp
  above the navigation bar (inset added in SplashActivity).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/splashMark"
        android:layout_width="@dimen/splash_mark"
        android:layout_height="@dimen/splash_mark"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        app:lottie_renderMode="hardware" />

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="132dp"
        android:alpha="0"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/splashTitle"
            style="@style/Text.Splash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            style="@style/Text.SplashCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/splash_caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/splashVersion"
        style="@style/Text.Mono.Footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/space_24"
        android:alpha="0" />
</FrameLayout>
