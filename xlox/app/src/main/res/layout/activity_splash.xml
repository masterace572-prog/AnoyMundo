<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash film (SplashActivity, ~3 s): real TextViews on true black.
    splashMark    the static Anoy wordmark exactly where the system splash icon
                  sits (288 dp, centred in the full window); it cross-fades out
                  as the film starts, so the hand-off has no jump
    splashLockup  "Welcome To" / "Anoy Loader", centred as a group
    splashName    "Anoy" + a slot where "Loader" turns into "Hax"; ends on the
                  true screen centre
  2.2.0: the version sits top right (status-bar inset added in code) and a
  status line at the bottom reports the real app update check:
  Initializing... / Checking for updates... / Up to date / Update available /
  Proceeding... / Can't check for updates + reason + Retry.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/splashMark"
        android:layout_width="@dimen/splash_mark"
        android:layout_height="@dimen/splash_mark"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_mark" />

    <LinearLayout
        android:id="@+id/splashLockup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/splashGreeting"
            style="@style/Text.SplashGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_greeting" />

        <LinearLayout
            android:id="@+id/splashName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/splash_line_gap"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/splashAnoy"
                style="@style/Text.Splash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <FrameLayout
                android:id="@+id/splashSlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8">

                <TextView
                    android:id="@+id/splashLoader"
                    style="@style/Text.Splash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/splash_loader" />

                <TextView
                    android:id="@+id/splashHax"
                    style="@style/Text.Splash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0"
                    android:text="@string/splash_hax" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/splashVersion"
        style="@style/Text.Mono.Footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginEnd="@dimen/screen_padding"
        android:alpha="0" />

    <!-- Bottom status: spinner or glyph + one line, then the reason and Retry on failure. -->
    <LinearLayout
        android:id="@+id/splashStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/space_24"
        android:alpha="0"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="20dp"
            android:orientation="horizontal">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/splashStatusSpinner"
                style="@style/Widget.Anoy.ButtonProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_8"
                android:importantForAccessibility="no"
                android:indeterminate="true"
                app:indicatorColor="@color/text_tertiary"
                app:indicatorSize="12dp"
                app:trackThickness="1.5dp" />

            <TextView
                android:id="@+id/splashStatus"
                style="@style/Text.Mono.Footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/splash_status_init" />
        </LinearLayout>

        <TextView
            android:id="@+id/splashStatusDetail"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:maxWidth="360dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/splashRetry"
            style="@style/Widget.Anoy.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:minWidth="160dp"
            android:text="@string/splash_retry"
            android:visibility="gone"
            app:icon="@drawable/ic_rotate_cw" />
    </LinearLayout>
</FrameLayout>
