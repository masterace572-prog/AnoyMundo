<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen branded Lottie splash on true black. The selected Techpost motion
  has been recoloured and rebranded in res/raw/anoy_splash.json, so the screen
  contains no hand-built wordmark choreography. The Android 12 system splash
  hands over to this view; app-update status and retry behaviour are unchanged.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipChildren="false">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/splashAnimation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/splashVersion"
        style="@style/Text.Mono.Footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/gutter_wide"
        android:layout_marginEnd="@dimen/gutter_wide"
        android:alpha="0" />

    <LinearLayout
        android:id="@+id/splashStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/space_32"
        android:alpha="0"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter_wide"
        android:paddingEnd="@dimen/gutter_wide">

        <!-- The update status uses the small original Anoy Lottie icons. -->
        <LinearLayout
            android:id="@+id/splashStatusRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/status_row_min_height"
            android:orientation="horizontal">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/splashStatusMark"
                android:layout_width="@dimen/lottie_status"
                android:layout_height="@dimen/lottie_status"
                android:layout_marginEnd="@dimen/space_4"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/splashStatus"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:drawablePadding="@dimen/space_8"
                android:gravity="center_vertical"
                android:text="@string/splash_status_init" />
        </LinearLayout>

        <TextView
            android:id="@+id/splashStatusDetail"
            style="@style/Text.BodyS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_horizontal"
            android:maxWidth="@dimen/max_content_width"
            android:textAlignment="center"
            android:visibility="invisible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/splashRetry"
            style="@style/Widget.Anoy.Button.Tonal.OnBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:minWidth="@dimen/retry_min_width"
            android:text="@string/splash_retry"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
