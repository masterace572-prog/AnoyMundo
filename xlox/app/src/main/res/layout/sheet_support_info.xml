<?xml version="1.0" encoding="utf-8"?>
<!--
  Support info (spec 3.9): the shared sheet with a handle. Kicker HELP +
  Title M, Body S "Includes your licence key. Only share it with Anoy
  support." (2.3.1), the exact text that is
  copied in a #0E0E10 hairline block (Mono 12.5 / 20, keys secondary; at most
  ~45 % of the height, scrolls inside), then Copy (48) and Cancel. After Copy
  the button reads "Copied" with a check for ~800 ms, then the sheet closes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/supportInfoRoot"
    style="@style/Sheet.Draggable">

    <View style="@style/SheetHandle" />

    <TextView
        style="@style/Text.Kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/help_title" />

    <TextView
        style="@style/Text.TitleM"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kicker_gap"
        android:accessibilityHeading="true"
        android:text="@string/support_info_title" />

    <TextView
        style="@style/Text.BodyS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/support_info_includes_key" />

    <ScrollView
        android:id="@+id/supportInfoScroll"
        style="@style/Scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_well"
        android:fillViewport="false">

        <TextView
            android:id="@+id/supportInfoText"
            style="@style/Text.MonoBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_16"
            android:textIsSelectable="true" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/supportInfoCopy"
        style="@style/Widget.Anoy.Button.Sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:text="@string/support_info_copy" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/supportInfoCancel"
        style="@style/Widget.Anoy.Button.Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/cancel" />
</LinearLayout>
