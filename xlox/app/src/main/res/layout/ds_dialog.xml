<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog: elevated matte surface, tight serif-free headline, right-aligned Text actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ds_dialog"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <TextView
        android:id="@+id/dialogHeadline"
        style="@style/TextAppearance.Ds.HeadlineSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/dialogBody"
        style="@style/TextAppearance.Ds.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:gravity="end"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dialogNegative"
            style="@style/Widget.Ds.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:minWidth="@dimen/touch_target"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dialogPositive"
            style="@style/Widget.Ds.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:minWidth="@dimen/touch_target" />
    </LinearLayout>
</LinearLayout>
