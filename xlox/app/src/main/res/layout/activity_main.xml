<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 2: bento telemetry dashboard. Every value is bound to the live sources. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <!-- Top bar: brand, monospace version pill, appearance switch -->
    <LinearLayout
        android:id="@+id/mainTopBar"
        style="@style/Widget.Ds.TopAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:id="@+id/dashboardTitle"
            style="@style/TextAppearance.Ds.HeadlineSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/appVersionText"
            style="@style/TextAppearance.Ds.Mono.Small"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/version_pill_height"
            android:background="@drawable/ds_version_pill"
            android:gravity="center"
            android:paddingStart="@dimen/space_8"
            android:paddingEnd="@dimen/space_8"
            android:textColor="@color/text_secondary" />

        <com.xlox.ui.designsystem.ThemeToggleView
            android:id="@+id/themeToggle"
            android:layout_width="@dimen/toggle_width"
            android:layout_height="@dimen/toggle_height"
            android:layout_marginStart="@dimen/space_12"
            android:contentDescription="@string/theme_toggle" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_32">

            <!-- Hero telemetry card -->
            <com.xlox.ui.designsystem.DsSurface
                android:id="@+id/mainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/card_padding"
                app:dsVariant="card">

                <View
                    android:id="@+id/subscriptionRule"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/status_rule"
                    android:background="@color/success" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/timeLeftLabel"
                        style="@style/TextAppearance.Ds.Micro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/time_left" />

                    <LinearLayout
                        android:id="@+id/statusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ds_status_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_12"
                        android:paddingTop="@dimen/space_4"
                        android:paddingEnd="@dimen/space_12"
                        android:paddingBottom="@dimen/space_4">

                        <com.xlox.ui.designsystem.LiveDotView
                            android:id="@+id/liveDot"
                            android:layout_width="@dimen/space_12"
                            android:layout_height="@dimen/space_12"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/subscriptionStatus"
                            style="@style/TextAppearance.Ds.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/active"
                            android:textColor="@color/success_ink" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/timeRemaining"
                    style="@style/TextAppearance.Ds.Mono.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/not_available_short" />

                <!-- Four tabular cells, all bound to the existing countdown -->
                <LinearLayout
                    android:id="@+id/timeBoxes"
                    android:baselineAligned="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/daysBox"
                        layout="@layout/item_time_box"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/hoursBox"
                        layout="@layout/item_time_box"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/minutesBox"
                        layout="@layout/item_time_box"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/secondsBox"
                        layout="@layout/item_time_box"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@drawable/ds_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/calendarIcon"
                        android:layout_width="@dimen/icon_inline"
                        android:layout_height="@dimen/icon_inline"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ds_ic_calendar"
                        app:tint="@color/icon" />

                    <TextView
                        android:id="@+id/expiresLabel"
                        style="@style/TextAppearance.Ds.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="@string/expires" />

                    <TextView
                        android:id="@+id/expiryValue"
                        style="@style/TextAppearance.Ds.Mono.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="@string/not_available"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.xlox.ui.designsystem.DsSurface>

            <!-- Bento grid: device + security status -->
            <LinearLayout
                android:id="@+id/bentoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <com.xlox.ui.designsystem.DsSurface
                    android:id="@+id/deviceTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="@dimen/tile_padding"
                    app:dsVariant="tile">

                    <ImageView
                        android:id="@+id/deviceIcon"
                        android:layout_width="@dimen/icon_bar"
                        android:layout_height="@dimen/icon_bar"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ds_ic_device"
                        app:tint="@color/icon" />

                    <TextView
                        android:id="@+id/deviceLabel"
                        style="@style/TextAppearance.Ds.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/device" />

                    <TextView
                        android:id="@+id/deviceValue"
                        style="@style/TextAppearance.Ds.Mono.Medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/not_available" />
                </com.xlox.ui.designsystem.DsSurface>

                <View
                    android:layout_width="@dimen/space_12"
                    android:layout_height="@dimen/divider" />

                <com.xlox.ui.designsystem.DsSurface
                    android:id="@+id/statusTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="@dimen/tile_padding"
                    app:dsVariant="tile">

                    <ImageView
                        android:id="@+id/statusIcon"
                        android:layout_width="@dimen/icon_bar"
                        android:layout_height="@dimen/icon_bar"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ds_ic_shield_check"
                        app:tint="@color/success_ink" />

                    <TextView
                        android:id="@+id/statusLabel"
                        style="@style/TextAppearance.Ds.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/status" />

                    <TextView
                        android:id="@+id/deviceStatus"
                        style="@style/TextAppearance.Ds.Mono.Medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/not_available"
                        android:textColor="@color/success_ink" />
                </com.xlox.ui.designsystem.DsSurface>
            </LinearLayout>

            <!-- Safety banner: bound to the live panel "safe text" -->
            <com.xlox.ui.designsystem.DsSurface
                android:id="@+id/safetyBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/tile_padding"
                android:visibility="gone"
                app:dsVariant="banner">

                <ImageView
                    android:id="@+id/warningIcon"
                    android:layout_width="@dimen/icon_bar"
                    android:layout_height="@dimen/icon_bar"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ds_ic_warning"
                    app:tint="@color/warning_ink" />

                <TextView
                    android:id="@+id/creditText"
                    style="@style/TextAppearance.Ds.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:textColor="@color/warning_ink" />
            </com.xlox.ui.designsystem.DsSurface>

            <!-- Fixed-height state area: zero layout shift during loading -->
            <FrameLayout
                android:id="@+id/statusArea"
                android:layout_width="match_parent"
                android:layout_height="@dimen/state_height"
                android:layout_marginTop="@dimen/space_12">

                <com.xlox.ui.designsystem.StateView
                    android:id="@+id/downloadBox"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <com.xlox.ui.designsystem.StateView
                    android:id="@+id/statusToggle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Bottom action -->
            <com.xlox.ui.designsystem.PrimaryButton
                android:id="@+id/startBgmi"
                style="@style/Widget.Ds.Button.Launch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/launch_button_height"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/launch" />

            <!-- Footer signature -->
            <TextView
                android:id="@+id/systemReady"
                style="@style/TextAppearance.Ds.Mono.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/ds_badge"
                android:paddingStart="@dimen/space_12"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/space_12"
                android:paddingBottom="@dimen/space_8"
                android:text="@string/telegram_handle"
                android:textColor="@color/text_tertiary" />

            <!-- Legacy IDs kept intact: existing Java binds these on startup.
                 Hidden, zero-sized, and never drawn. -->
            <LinearLayout
                android:id="@+id/legacyControls"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView android:id="@+id/startText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:id="@+id/actionIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@null" android:importantForAccessibility="no" />
                <TextView android:id="@+id/gameName" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/packageName" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/gameStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/telegramCaption" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/keyTimeRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
                <LinearLayout android:id="@+id/fbCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/startFB" android:layout_width="0dp" android:layout_height="@dimen/divider" android:layout_weight="1" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/obbButton" android:layout_width="0dp" android:layout_height="@dimen/divider" android:layout_weight="1" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/restartButton" android:layout_width="@dimen/divider" android:layout_height="@dimen/divider" android:text="@string/clear_data" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
