<?xml version="1.0" encoding="utf-8"?>
<!-- Persistent capsule below two full, opaque, horizontally sliding pages. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <com.xlox.ui.HomeSettingsPager
        android:id="@+id/homeSettingsPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never" />

    <FrameLayout
        android:id="@+id/bottomNavigationHost"
        android:tag="snackbar_anchor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_16">

        <com.xlox.ui.CapsuleNavigation
            android:id="@+id/bottomCapsule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_nav_capsule"
            android:layoutDirection="ltr"
            android:minHeight="@dimen/button_height"
            android:padding="@dimen/space_4">

            <View
                android:id="@+id/navigationIndicator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_nav_indicator"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/navigationHome"
                    style="@style/Text.BodyL.Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nav_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_target"
                    android:paddingStart="@dimen/space_8"
                    android:paddingTop="@dimen/space_8"
                    android:paddingEnd="@dimen/space_8"
                    android:paddingBottom="@dimen/space_8"
                    android:text="@string/navigation_home" />

                <TextView
                    android:id="@+id/navigationSettings"
                    style="@style/Text.BodyL.Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_nav_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_target"
                    android:paddingStart="@dimen/space_8"
                    android:paddingTop="@dimen/space_8"
                    android:paddingEnd="@dimen/space_8"
                    android:paddingBottom="@dimen/space_8"
                    android:text="@string/settings" />
            </LinearLayout>
        </com.xlox.ui.CapsuleNavigation>
    </FrameLayout>
</LinearLayout>
