<?xml version="1.0" encoding="utf-8"?>
<!--
  Home. Content scrolls under a pinned action bar that sits over a 24 dp fade.
  mainRoot gets the status-bar inset on top; the action bar gets the
  navigation-bar inset at the bottom; mainContent's bottom padding follows the
  action bar height (MAct.onActionBarLayout).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ScrollView
        android:id="@+id/mainScroll"
        style="@style/Scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="120dp">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/mainHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_4">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_kicker" />

                    <TextView
                        style="@style/Text.LargeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:accessibilityHeading="true"
                        android:text="@string/home_title" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/signOut"
                    style="@style/IconButton"
                    android:background="@drawable/bg_icon_button_filled"
                    android:contentDescription="@string/sign_out"
                    app:srcCompat="@drawable/ic_log_out" />
            </LinearLayout>

            <!-- Panel note: amber notice (12 % fill, 24 % border). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelNoteCard"
                style="@style/Widget.Anoy.Card.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:layout_marginTop="1dp"
                        android:layout_marginEnd="@dimen/space_12"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_triangle_alert"
                        app:tint="@color/warning" />

                    <TextView
                        android:id="@+id/panelNote"
                        style="@style/Text.Callout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Licence card: read by TalkBack as one sentence. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/licenceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/licenceLabel"
                            style="@style/Text.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_8"
                            android:layout_weight="1"
                            android:text="@string/row_time_left" />

                        <TextView
                            android:id="@+id/statusValue"
                            style="@style/Chip"
                            android:textColor="@color/text_secondary"
                            tools:text="@string/active" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/timeLeftValue"
                        style="@style/Text.Hero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:maxLines="1"
                        android:text="@string/dash"
                        app:autoSizeMaxTextSize="@dimen/text_hero"
                        app:autoSizeMinTextSize="@dimen/text_hero_min"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <View
                        android:id="@+id/heroSkeleton"
                        style="@style/Skeleton"
                        android:layout_width="200dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="@dimen/space_12" />

                    <TextView
                        android:id="@+id/licenceExpiredText"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/licence_expired_message"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/expiresValue"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/licenceProgress"
                        style="@style/Widget.Anoy.Progress.Thin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:max="1000"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- GAME -->
            <TextView
                style="@style/Text.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/group_gap"
                android:accessibilityHeading="true"
                android:text="@string/section_game" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/gameCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/ListRow">

                        <ImageView
                            style="@style/Tile"
                            app:srcCompat="@drawable/ic_gamepad" />

                        <TextView
                            style="@style/Text.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/row_game" />

                        <TextView
                            android:id="@+id/gameValue"
                            style="@style/Text.RowValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <View style="@style/Separator" />

                    <LinearLayout style="@style/ListRow">

                        <ImageView
                            style="@style/Tile"
                            app:srcCompat="@drawable/ic_activity" />

                        <TextView
                            style="@style/Text.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/row_state" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1">

                            <TextView
                                android:id="@+id/gameStateValue"
                                style="@style/Chip"
                                android:layout_gravity="end|center_vertical"
                                android:ellipsize="end"
                                android:textColor="@color/text_secondary" />
                        </FrameLayout>
                    </LinearLayout>

                    <View style="@style/Separator" />

                    <LinearLayout style="@style/ListRow">

                        <ImageView
                            style="@style/Tile"
                            app:srcCompat="@drawable/ic_package" />

                        <TextView
                            style="@style/Text.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/row_library" />

                        <TextView
                            android:id="@+id/libraryValue"
                            style="@style/Text.RowValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:fontFamily="@font/jetbrains_mono_regular"
                            android:fontFeatureSettings="tnum"
                            android:textSize="@dimen/text_callout" />
                    </LinearLayout>

                    <View style="@style/Separator" />

                    <LinearLayout style="@style/ListRow">

                        <ImageView
                            style="@style/Tile"
                            app:srcCompat="@drawable/ic_server" />

                        <TextView
                            style="@style/Text.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/row_server" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1">

                            <TextView
                                android:id="@+id/serverValue"
                                style="@style/Chip"
                                android:layout_gravity="end|center_vertical"
                                android:ellipsize="end"
                                android:textColor="@color/text_secondary" />

                            <View
                                android:id="@+id/serverSkeleton"
                                style="@style/Skeleton"
                                android:layout_width="72dp"
                                android:layout_gravity="end|center_vertical" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DEVICE -->
            <TextView
                style="@style/Text.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/group_gap"
                android:accessibilityHeading="true"
                android:text="@string/section_device" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/deviceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/ListRow">

                        <ImageView
                            style="@style/Tile"
                            app:srcCompat="@drawable/ic_smartphone" />

                        <TextView
                            style="@style/Text.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/row_model" />

                        <TextView
                            android:id="@+id/modelValue"
                            style="@style/Text.RowValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <View style="@style/Separator" />

                    <LinearLayout style="@style/ListRow">

                        <ImageView
                            style="@style/Tile"
                            app:srcCompat="@drawable/ic_cpu" />

                        <TextView
                            style="@style/Text.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/row_android" />

                        <TextView
                            android:id="@+id/androidValue"
                            style="@style/Text.RowValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/help"
                style="@style/Widget.Anoy.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:text="@string/help"
                app:icon="@drawable/ic_help" />
        </LinearLayout>
    </ScrollView>

    <!-- Pinned action bar over a 24 dp fade. -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:tag="snackbar_anchor">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fade_height"
            android:background="@drawable/bg_fade"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/actionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_16">

            <TextView
                android:id="@+id/statusMessage"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/taskProgress"
                style="@style/Widget.Anoy.Progress.Thin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primaryAction"
                style="@style/Widget.Anoy.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launch" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
