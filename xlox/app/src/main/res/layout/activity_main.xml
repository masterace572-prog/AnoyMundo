<?xml version="1.0" encoding="utf-8"?>
<!-- Home and Settings host. The visual sections live in included layouts; the
     root and section IDs stay unchanged for the existing Activity bindings. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ScrollView
        android:id="@+id/mainScroll"
        style="@style/Scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/screen_padding">

            <include layout="@layout/home_header" />

            <include layout="@layout/home_notices" />

            <include layout="@layout/home_licence_card" />

            <include layout="@layout/home_game_card" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/home_action_bar" />

    <include layout="@layout/home_settings_page" />
</FrameLayout>
