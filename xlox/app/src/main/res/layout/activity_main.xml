<?xml version="1.0" encoding="utf-8"?>
<!--
  Home (spec 3.5) and Settings (spec 3.6), 20 dp gutters, true black.

  Home
    header      kicker ANOY HAX (tertiary) over "Welcome back" (Title L); on the
                right a "?" in a 32 dp hairline circle and the 24 dp gear (48 dp
                targets)
    Every card (2.3.4): r20, 16 dp padding.
    notice      megaphone + ANNOUNCEMENT kicker over the panel's note, verbatim
                (gone when empty)
    time card   EXPIRES IN + status dot; one countdown line (Title M numerals);
                the IST expiry date; "Offline · last checked …" when stale
    game card   56 dp bundled BGMI icon, BGMI + version, library; divider;
                State and Server (Micro label over dot + Body L 500)
    action bar  pinned; status line (its space is kept while a task runs), task
                bar, Launch (56 dp); a hairline only while content runs underneath

  Settings      an inset grouped list (rows from @style/Row) over home: Licence,
                Updates (incl. App version), Device, Report a problem, Account
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ScrollView
        android:id="@+id/mainScroll"
        style="@style/Scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/screen_padding">

            <!-- ======================================================= header -->
            <LinearLayout
                android:id="@+id/mainHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_20"
                android:gravity="center_vertical"
                android:minHeight="@dimen/space_56"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/homeKicker"
                        style="@style/Text.Kicker.Tertiary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_name" />

                    <TextView
                        android:id="@+id/homeTitle"
                        style="@style/Text.TitleL"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:accessibilityHeading="true"
                        android:text="@string/home_title" />
                </LinearLayout>

                <!-- "?" : 32 dp hairline circle centred in a 48 dp target. -->
                <FrameLayout
                    android:id="@+id/helpButton"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:clickable="true"
                    android:contentDescription="@string/help_open"
                    android:focusable="true">

                    <TextView
                        style="@style/Text.HelpGlyph"
                        android:layout_width="@dimen/help_circle"
                        android:layout_height="@dimen/help_circle"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_help_circle"
                        android:duplicateParentState="true"
                        android:importantForAccessibility="no"
                        android:text="@string/help_glyph" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/settingsButton"
                    style="@style/IconButton"
                    android:layout_marginStart="@dimen/icon_button_pair"
                    android:layout_marginEnd="@dimen/icon_button_edge"
                    android:contentDescription="@string/settings_open"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>

            <!-- ======================================================= notice -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelNoteCard"
                style="@style/Widget.Anoy.Card.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon_inline"
                        android:layout_height="@dimen/icon_inline"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_megaphone"
                        app:tint="@color/notice_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/panelNoteKicker"
                            style="@style/Text.Kicker.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/announcement" />

                        <TextView
                            android:id="@+id/panelNote"
                            style="@style/Text.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================================================== time card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/licenceCard"
                style="@style/Widget.Anoy.Card.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/licenceLabel"
                            style="@style/Text.Kicker"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/licence_expires_in" />

                        <TextView
                            android:id="@+id/statusValue"
                            style="@style/Text.Caption.Medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:drawablePadding="@dimen/space_8"
                            android:gravity="center_vertical"
                            android:text="@string/dash" />
                    </LinearLayout>

                    <!-- One line: "29d 23h 59m 58s" (under a day "23h 59m 58s"), "Expired" or "—". -->
                    <TextView
                        android:id="@+id/timeLeftValue"
                        style="@style/Text.Countdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/dash" />

                    <TextView
                        android:id="@+id/expiresValue"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:id="@+id/licenceChecked"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textColor="@color/text_tertiary"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================================================== game card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/gameCard"
                style="@style/Widget.Anoy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <LinearLayout
                        android:id="@+id/gameHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- The BGMI icon, bundled (res/drawable-nodpi); never loaded at runtime. -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/gameTile"
                            android:layout_width="@dimen/game_tile"
                            android:layout_height="@dimen/game_tile"
                            android:contentDescription="@string/game_icon_description"
                            android:padding="@dimen/game_icon_inset"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Anoy.GameTile"
                            app:srcCompat="@drawable/ic_game_bgmi"
                            app:strokeColor="@color/hairline"
                            app:strokeWidth="@dimen/hairline" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="true"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/gameValue"
                                    style="@style/Text.TitleM"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:text="@string/game_name" />

                                <TextView
                                    android:id="@+id/gameVersion"
                                    style="@style/Text.Mono"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_8"
                                    android:fontFeatureSettings="tnum"
                                    android:maxLines="1"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/libraryValue"
                                style="@style/Text.Mono"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/text_tertiary" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        style="@style/Divider"
                        android:layout_marginTop="@dimen/space_20" />

                    <LinearLayout
                        android:id="@+id/stateCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Micro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/row_state" />

                            <TextView
                                android:id="@+id/gameStateValue"
                                style="@style/Text.BodyL.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:drawablePadding="@dimen/space_8"
                                android:gravity="center_vertical"
                                android:text="@string/dash" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Micro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/row_server" />

                            <TextView
                                android:id="@+id/serverValue"
                                style="@style/Text.BodyL.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:drawablePadding="@dimen/space_8"
                                android:gravity="center_vertical"
                                android:text="@string/dash" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- ===================================================== pinned action bar -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/black"
        android:orientation="vertical"
        android:tag="snackbar_anchor">

        <View
            android:id="@+id/actionDivider"
            style="@style/Divider"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/actionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_16">

            <TextView
                android:id="@+id/statusMessage"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/taskProgress"
                style="@style/Widget.Anoy.Progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primaryAction"
                style="@style/Widget.Anoy.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launch" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================================= settings -->
    <FrameLayout
        android:id="@+id/settingsPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/settingsScroll"
            style="@style/Scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/settingsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/space_24">

                <LinearLayout
                    android:id="@+id/settingsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/settingsBack"
                        style="@style/IconButton"
                        android:layout_marginStart="@dimen/icon_button_edge"
                        android:contentDescription="@string/settings_back"
                        android:src="@drawable/ic_chevron_left" />

                    <TextView
                        android:id="@+id/settingsTitle"
                        style="@style/Text.TitleL"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:accessibilityHeading="true"
                        android:text="@string/settings" />
                </LinearLayout>

                <!-- Licence (2.3.1): key (masked, eye reveals, tap copies), status, expiry -->
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/space_24"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_licence" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/licenceGroup"
                    style="@style/Widget.Anoy.Group">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/licenceKeyRow"
                            style="@style/Row"
                            android:paddingTop="@dimen/space_4"
                            android:paddingEnd="@dimen/space_4"
                            android:paddingBottom="@dimen/space_4"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/licence_key" />

                            <TextView
                                android:id="@+id/licenceKeyValue"
                                style="@style/Text.Mono.Key"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:layout_weight="1"
                                android:text="@string/dash" />

                            <ImageButton
                                android:id="@+id/licenceKeyEye"
                                style="@style/IconButton.Inline"
                                android:contentDescription="@string/licence_key_show"
                                android:src="@drawable/ic_eye" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            style="@style/Row"
                            android:background="@null"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_licence_status" />

                            <!-- wrap_content: the dot sits right before the word, at the end. -->
                            <TextView
                                android:id="@+id/licenceStatusValue"
                                style="@style/Text.RowValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:drawablePadding="@dimen/space_8"
                                android:text="@string/dash" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            style="@style/Row"
                            android:background="@null"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_licence_expires" />

                            <TextView
                                android:id="@+id/licenceExpiresValue"
                                style="@style/Text.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:layout_weight="1"
                                android:fontFeatureSettings="tnum"
                                android:text="@string/dash" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Updates: the app check (with "Last checked"), library re-download and
                     version, and the app version -->
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_updates" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/updatesGroup"
                    style="@style/Widget.Anoy.Group">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/checkUpdateRow"
                            style="@style/Row"
                            android:clickable="true"
                            android:focusable="true">

                            <!-- 2.3.4: two lines - the label over "Last checked …" (IST). -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Text.RowLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_check_updates" />

                                <TextView
                                    android:id="@+id/checkUpdateCaption"
                                    style="@style/Text.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:accessibilityLiveRegion="polite"
                                    android:text="@string/settings_not_checked" />
                            </LinearLayout>

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/checkUpdateSpinner"
                                style="@style/Widget.Anoy.StatusSpinner"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:importantForAccessibility="no"
                                android:indeterminate="true"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/checkUpdateIcon"
                                android:layout_width="@dimen/icon_small"
                                android:layout_height="@dimen/icon_small"
                                android:layout_marginStart="@dimen/space_16"
                                android:importantForAccessibility="no"
                                android:visibility="gone"
                                app:srcCompat="@drawable/ic_check"
                                app:tint="@color/success" />

                            <TextView
                                android:id="@+id/checkUpdateValue"
                                style="@style/Text.RowValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:accessibilityLiveRegion="polite"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/checkUpdateGlyph"
                                style="@style/RowGlyph"
                                app:srcCompat="@drawable/ic_chevron_right" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            android:id="@+id/redownloadRow"
                            style="@style/Row"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_redownload" />

                            <ImageView
                                style="@style/RowGlyph"
                                app:srcCompat="@drawable/ic_chevron_right" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            style="@style/Row"
                            android:background="@null"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_library_version" />

                            <TextView
                                android:id="@+id/libraryVersionValue"
                                style="@style/Text.Mono"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:layout_weight="1"
                                android:fontFeatureSettings="tnum"
                                android:gravity="end"
                                android:text="@string/dash" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <!-- 2.3.4: App version lives here now (the About group is gone). -->
                        <LinearLayout
                            style="@style/Row"
                            android:background="@null"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_version" />

                            <TextView
                                android:id="@+id/appVersionValue"
                                style="@style/Text.Mono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:fontFeatureSettings="tnum" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Device -->
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_device" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/deviceCard"
                    style="@style/Widget.Anoy.Group">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            style="@style/Row"
                            android:background="@null"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_model" />

                            <TextView
                                android:id="@+id/modelValue"
                                style="@style/Text.RowValue.SingleLine"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            style="@style/Row"
                            android:background="@null"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_android" />

                            <TextView
                                android:id="@+id/androidValue"
                                style="@style/Text.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_16"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Report a problem -->
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_report" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/reportCard"
                    style="@style/Widget.Anoy.Group">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/settingsTelegram"
                            style="@style/Row"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_telegram" />

                            <ImageView
                                style="@style/RowGlyph"
                                app:srcCompat="@drawable/ic_arrow_up_right" />
                        </LinearLayout>

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            android:id="@+id/settingsCopySupport"
                            style="@style/Row"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_copy_support" />

                            <ImageView
                                style="@style/RowGlyph"
                                app:srcCompat="@drawable/ic_chevron_right" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Account -->
                <TextView
                    style="@style/Text.Kicker.Group"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_account" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/accountCard"
                    style="@style/Widget.Anoy.Group">

                    <LinearLayout
                        android:id="@+id/signOut"
                        style="@style/Row"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            style="@style/Text.RowLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sign_out" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
