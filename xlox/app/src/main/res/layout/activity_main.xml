<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 2: dashboard. One serif headline (top app bar), one accent-filled control. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mainTopBar"
        style="@style/Widget.Ds.TopAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12">

        <TextView
            android:id="@+id/dashboardTitle"
            style="@style/TextAppearance.Ds.HeadlineSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <View
            android:layout_width="@dimen/space_0"
            android:layout_height="@dimen/divider"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/themeToggle"
            style="@style/Widget.Ds.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/theme_toggle"
            android:src="@drawable/ds_ic_dark_mode" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_0"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_24"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_32">

            <!-- Subscription card -->
            <LinearLayout
                android:id="@+id/mainCard"
                style="@style/Widget.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/brandHeader"
                        style="@style/TextAppearance.Ds.TitleMedium"
                        android:layout_width="@dimen/space_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/subscription" />

                    <View
                        android:id="@+id/subscriptionRule"
                        android:layout_width="@dimen/status_rule"
                        android:layout_height="@dimen/list_item_single"
                        android:background="@color/success" />

                    <TextView
                        android:id="@+id/subscriptionStatus"
                        style="@style/Widget.Ds.StatusText.Success"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="@string/ready" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="@dimen/space_8"
                    android:background="@drawable/ds_divider" />

                <!-- Single-line list rows: leading icon + label + trailing value -->
                <LinearLayout
                    style="@style/Widget.Ds.ListRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_bar"
                        android:layout_height="@dimen/icon_bar"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ds_ic_calendar_month" />

                    <TextView
                        style="@style/TextAppearance.Ds.Secondary"
                        android:layout_width="@dimen/space_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/expires" />

                    <TextView
                        android:id="@+id/expiryValue"
                        style="@style/TextAppearance.Ds.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/not_available" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.Ds.ListRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_bar"
                        android:layout_height="@dimen/icon_bar"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ds_ic_schedule" />

                    <TextView
                        style="@style/TextAppearance.Ds.Secondary"
                        android:layout_width="@dimen/space_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/time_left" />

                    <TextView
                        android:id="@+id/timeRemaining"
                        style="@style/TextAppearance.Ds.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/not_available" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/deviceStatusRow"
                    style="@style/Widget.Ds.ListRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_bar"
                        android:layout_height="@dimen/icon_bar"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ds_ic_devices" />

                    <TextView
                        style="@style/TextAppearance.Ds.Secondary"
                        android:layout_width="@dimen/space_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/device" />

                    <TextView
                        android:id="@+id/deviceValue"
                        style="@style/TextAppearance.Ds.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/not_available" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.Ds.ListRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_bar"
                        android:layout_height="@dimen/icon_bar"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ds_ic_verified_user" />

                    <TextView
                        style="@style/TextAppearance.Ds.Secondary"
                        android:layout_width="@dimen/space_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/status" />

                    <TextView
                        android:id="@+id/deviceStatus"
                        style="@style/Widget.Ds.StatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/not_available" />
                </LinearLayout>

                <TextView
                    android:id="@+id/appVersionText"
                    style="@style/TextAppearance.Ds.Tertiary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8" />
            </LinearLayout>

            <TextView
                android:id="@+id/creditText"
                style="@style/TextAppearance.Ds.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:visibility="gone" />

            <com.xlox.ui.designsystem.PrimaryButton
                android:id="@+id/startBgmi"
                style="@style/Widget.Ds.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/launch" />

            <com.xlox.ui.designsystem.StateView
                android:id="@+id/downloadBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/ds_card"
                android:padding="@dimen/card_padding"
                android:visibility="gone" />

            <com.xlox.ui.designsystem.StateView
                android:id="@+id/statusToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/ds_card"
                android:padding="@dimen/card_padding"
                android:visibility="gone" />

            <TextView
                android:id="@+id/systemReady"
                style="@style/TextAppearance.Ds.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/section_gap"
                android:background="@drawable/ds_button_text"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/touch_target"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:text="@string/telegram_handle" />

            <!-- Legacy IDs kept intact: existing Java binds these on startup.
                 Hidden, zero-sized, and never drawn. -->
            <LinearLayout
                android:id="@+id/legacyControls"
                android:layout_width="@dimen/space_0"
                android:layout_height="@dimen/space_0"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView android:id="@+id/startText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:id="@+id/actionIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/gameName" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/packageName" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/gameStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/keyTimeRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <include android:id="@+id/daysBox" layout="@layout/item_time_box" />
                    <include android:id="@+id/hoursBox" layout="@layout/item_time_box" />
                    <include android:id="@+id/minutesBox" layout="@layout/item_time_box" />
                    <include android:id="@+id/secondsBox" layout="@layout/item_time_box" />
                </LinearLayout>
                <LinearLayout android:id="@+id/fbCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/startFB" android:layout_width="@dimen/space_0" android:layout_height="@dimen/divider" android:layout_weight="1" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/obbButton" android:layout_width="@dimen/space_0" android:layout_height="@dimen/divider" android:layout_weight="1" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/restartButton" android:layout_width="@dimen/divider" android:layout_height="@dimen/divider" android:text="@string/clear_data" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
