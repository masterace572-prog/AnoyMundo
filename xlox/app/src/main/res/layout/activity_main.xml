<?xml version="1.0" encoding="utf-8"?>
<!-- Home: status hero card, inset grouped rows with icon tiles, one blue action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        style="@style/Scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_kicker" />

                <TextView
                    style="@style/Text.LargeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityHeading="true"
                    android:text="@string/home_title" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/signOut"
                style="@style/IconButton.Filled"
                android:contentDescription="@string/sign_out"
                app:srcCompat="@drawable/ic_log_out" />
        </LinearLayout>

        <TextView
            android:id="@+id/panelNote"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone" />

        <!-- Licence hero card -->
        <LinearLayout
            android:id="@+id/licenceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/statusTile"
                    style="@style/Tile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:background="@drawable/bg_tile_green"
                    app:srcCompat="@drawable/ic_shield_check"
                    app:tint="@color/green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_licence" />

                    <TextView
                        android:id="@+id/statusValue"
                        style="@style/Text.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/dash" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/row_time_left" />

            <TextView
                android:id="@+id/timeLeftValue"
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/dash" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp"
                android:background="@color/card_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_small"
                    android:layout_height="@dimen/icon_small"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_calendar"
                    app:tint="@color/text_secondary" />

                <TextView
                    style="@style/Text.Footnote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/row_expires" />

                <TextView
                    android:id="@+id/expiresValue"
                    style="@style/Text.Footnote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:text="@string/dash" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Text.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:accessibilityHeading="true"
            android:text="@string/section_game" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <LinearLayout style="@style/ListRow">

                <ImageView
                    style="@style/Tile"
                    android:background="@drawable/bg_tile_blue"
                    app:srcCompat="@drawable/ic_gamepad"
                    app:tint="@color/blue" />

                <TextView
                    style="@style/Text.RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/row_game" />

                <TextView
                    android:id="@+id/gameValue"
                    style="@style/Text.RowValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/dash" />
            </LinearLayout>

            <View style="@style/ListDivider" />

            <LinearLayout style="@style/ListRow">

                <ImageView
                    style="@style/Tile"
                    android:background="@drawable/bg_tile_green"
                    app:srcCompat="@drawable/ic_activity"
                    app:tint="@color/green" />

                <TextView
                    style="@style/Text.RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/row_state" />

                <TextView
                    android:id="@+id/gameStateValue"
                    style="@style/Text.RowValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/dash" />
            </LinearLayout>

            <View style="@style/ListDivider" />

            <LinearLayout style="@style/ListRow">

                <ImageView
                    style="@style/Tile"
                    android:background="@drawable/bg_tile_purple"
                    app:srcCompat="@drawable/ic_package"
                    app:tint="@color/purple" />

                <TextView
                    style="@style/Text.RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/row_library" />

                <TextView
                    android:id="@+id/libraryValue"
                    style="@style/Text.RowValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/dash" />
            </LinearLayout>

            <View style="@style/ListDivider" />

            <LinearLayout style="@style/ListRow">

                <ImageView
                    style="@style/Tile"
                    android:background="@drawable/bg_tile_teal"
                    app:srcCompat="@drawable/ic_server"
                    app:tint="@color/teal" />

                <TextView
                    style="@style/Text.RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/row_server" />

                <TextView
                    android:id="@+id/serverValue"
                    style="@style/Text.RowValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/dash" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Text.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:accessibilityHeading="true"
            android:text="@string/section_device" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <LinearLayout style="@style/ListRow">

                <ImageView
                    style="@style/Tile"
                    android:background="@drawable/bg_tile_gray"
                    app:srcCompat="@drawable/ic_smartphone"
                    app:tint="@color/text_secondary" />

                <TextView
                    style="@style/Text.RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/row_model" />

                <TextView
                    android:id="@+id/modelValue"
                    style="@style/Text.RowValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/dash" />
            </LinearLayout>

            <View style="@style/ListDivider" />

            <LinearLayout style="@style/ListRow">

                <ImageView
                    style="@style/Tile"
                    android:background="@drawable/bg_tile_gray"
                    app:srcCompat="@drawable/ic_cpu"
                    app:tint="@color/text_secondary" />

                <TextView
                    style="@style/Text.RowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/row_android" />

                <TextView
                    android:id="@+id/androidValue"
                    style="@style/Text.RowValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/dash" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/statusMessage"
            style="@style/Text.Footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/taskProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_height"
            android:layout_marginBottom="14dp"
            android:indeterminateTint="@color/blue"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/primaryAction"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:text="@string/launch" />

            <ProgressBar
                android:id="@+id/actionSpinner"
                style="@style/Spinner"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <Button
            android:id="@+id/help"
            style="@style/Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:drawablePadding="8dp"
            android:text="@string/help"
            app:drawableStartCompat="@drawable/ic_help_blue" />
    </LinearLayout>
</LinearLayout>
