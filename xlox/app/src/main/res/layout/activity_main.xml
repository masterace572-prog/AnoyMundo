<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/anoyBg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="30dp"
            android:paddingEnd="20dp"
            android:paddingBottom="96dp">

            <!-- MARK -->
            <LinearLayout
                android:id="@+id/brandHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/logoFrame"
                    android:layout_width="56dp"
                    android:layout_height="56dp">
                    <ImageView
                        android:id="@+id/logoGlow"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:alpha="0"
                        android:contentDescription="@string/app_name" />
                    <ImageView
                        android:id="@+id/mainLogo"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_anoy" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/dashboardTitle"
                        style="@style/IosTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name" />
                    <TextView
                        style="@style/IosFootnote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/brand_subtitle" />
                </LinearLayout>
            </LinearLayout>

            <!-- SUBSCRIPTION -->
            <LinearLayout
                android:id="@+id/mainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_ios_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/IosHeadline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/subscription" />
                    <TextView
                        android:id="@+id/subscriptionStatus"
                        style="@style/IosFootnote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_badge"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:text="@string/ready"
                        android:textColor="@color/anoyGreen" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/anoySeparator" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/IosFootnote"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/expires" />
                    <TextView
                        android:id="@+id/expiryValue"
                        style="@style/IosBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="--" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/IosFootnote"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/time_left" />
                    <TextView
                        android:id="@+id/timeRemaining"
                        style="@style/IosBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="--" />
                </LinearLayout>
            </LinearLayout>

            <!-- DEVICE / REAL PANEL STATUS -->
            <LinearLayout
                android:id="@+id/deviceStatusRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_card"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        style="@style/IosCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device" />
                    <TextView
                        android:id="@+id/deviceValue"
                        style="@style/IosBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="--" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_card"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        style="@style/IosCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status" />
                    <TextView
                        android:id="@+id/deviceStatus"
                        style="@style/IosBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="--" />
                </LinearLayout>
            </LinearLayout>

            <!-- Admin panel /Server "safe text". Hidden when the panel has none. -->
            <TextView
                android:id="@+id/creditText"
                style="@style/IosCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:visibility="gone" />

            <!-- PRIMARY ACTION: shows dots on tap and progress inside the button -->
            <com.xlox.ui.AnoyButton
                android:id="@+id/startBgmi"
                style="@style/IosButtonLabel"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_ios_button"
                android:stateListAnimator="@null"
                android:text="@string/launch"
                android:textAllCaps="false" />

            <!-- Compact one-line status (diagnostics / errors) -->
            <LinearLayout
                android:id="@+id/statusToggle"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ios_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:visibility="gone">
                <ProgressBar
                    android:id="@+id/statusLoader"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminateTint="@color/anoyBlue"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/statusErrorIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:visibility="gone" />
                <TextView
                    style="@style/IosFootnote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/status" />
                <TextView
                    android:id="@+id/statusToggleText"
                    style="@style/IosFootnote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/ready" />
            </LinearLayout>

            <!-- Minimal fallback info; progress itself lives in the button. -->
            <LinearLayout
                android:id="@+id/downloadBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ios_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">
                <ProgressBar
                    android:id="@+id/downloadProgressBar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/anoyBlue" />
                <TextView
                    android:id="@+id/downloadStatusText"
                    style="@style/IosFootnote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/ready" />
                <TextView
                    android:id="@+id/percentText"
                    style="@style/IosFootnote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%" />
                <ProgressBar
                    android:id="@+id/loadingCursor"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Legacy IDs kept intact: existing Java binds these on startup.
                 Hidden, zero-sized, and never drawn. -->
            <LinearLayout
                android:id="@+id/legacyControls"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView android:id="@+id/startText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:id="@+id/actionIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/gameName" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/packageName" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/gameStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/appVersionText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/keyTimeRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <include android:id="@+id/daysBox" layout="@layout/item_time_box" />
                    <include android:id="@+id/hoursBox" layout="@layout/item_time_box" />
                    <include android:id="@+id/minutesBox" layout="@layout/item_time_box" />
                    <include android:id="@+id/secondsBox" layout="@layout/item_time_box" />
                </LinearLayout>
                <LinearLayout android:id="@+id/fbCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/startFB" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/obbButton" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/restartButton" android:layout_width="1dp" android:layout_height="1dp" android:text="CLEAR DATA" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/systemReady"
        style="@style/IosLink"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/telegram_handle" />

    <ImageButton
        android:id="@+id/themeToggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/theme_toggle"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_theme"
        android:tint="@color/anoyBlue" />

</FrameLayout>
