<?xml version="1.0" encoding="utf-8"?>
<!--
  Home. Content scrolls under a pinned action bar that sits over a 24 dp fade.
  mainRoot gets the status-bar inset on top; the action bar gets the
  navigation-bar inset at the bottom; mainContent's bottom padding follows the
  action bar height (MAct.onActionBarLayout).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ScrollView
        android:id="@+id/mainScroll"
        style="@style/Scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="120dp">

            <!-- Header: kicker + title ("Welcome back" unless the panel sends a name), Help, Settings. -->
            <LinearLayout
                android:id="@+id/mainHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_4">

                    <TextView
                        android:id="@+id/homeKicker"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_4"
                        android:text="@string/home_kicker"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/homeTitle"
                        style="@style/Text.LargeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/home_title" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/helpButton"
                    style="@style/IconButton"
                    android:layout_marginEnd="@dimen/space_8"
                    android:background="@drawable/bg_icon_button_filled"
                    android:contentDescription="@string/help_open"
                    app:srcCompat="@drawable/ic_help" />

                <ImageButton
                    android:id="@+id/settingsButton"
                    style="@style/IconButton"
                    android:background="@drawable/bg_icon_button_filled"
                    android:contentDescription="@string/settings_open"
                    app:srcCompat="@drawable/ic_settings" />
            </LinearLayout>

            <!-- Panel note: amber notice (12 % fill, 24 % border). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelNoteCard"
                style="@style/Widget.Anoy.Card.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/space_12">

                    <ImageView
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:layout_marginTop="1dp"
                        android:layout_marginEnd="@dimen/space_12"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_triangle_alert"
                        app:tint="@color/warning" />

                    <TextView
                        android:id="@+id/panelNote"
                        style="@style/Text.Callout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Licence card: read by TalkBack as one sentence. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/licenceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="20dp"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/licenceLabel"
                                style="@style/Text.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/space_8"
                                android:layout_weight="1"
                                android:text="@string/row_time_left" />

                            <TextView
                                android:id="@+id/statusValue"
                                style="@style/Chip"
                                android:textColor="@color/text_secondary"
                                tools:text="@string/active" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/timeLeftValue"
                            style="@style/Text.Hero"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:maxLines="1"
                            android:text="@string/dash"
                            app:autoSizeMaxTextSize="@dimen/text_countdown"
                            app:autoSizeMinTextSize="@dimen/text_countdown_min"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <View
                            android:id="@+id/heroSkeleton"
                            style="@style/Skeleton"
                            android:layout_width="200dp"
                            android:layout_height="28dp"
                            android:layout_marginTop="@dimen/space_8" />

                        <TextView
                            android:id="@+id/licenceExpiredText"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="@string/licence_expired_message"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/expiresValue"
                            style="@style/Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" />

                        <!-- Quiet line after a refresh could not reach the panel. -->
                        <TextView
                            android:id="@+id/licenceChecked"
                            style="@style/Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:textColor="@color/text_tertiary"
                            android:visibility="gone" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/licenceProgress"
                            style="@style/Widget.Anoy.Progress.Thin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:max="1000"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Low time: nudge + Renew (Telegram), outside the card's one-sentence description. -->
                    <LinearLayout
                        android:id="@+id/licenceSoonRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingEnd="4dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/licenceSoonText"
                            style="@style/Text.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_8"
                            android:layout_weight="1"
                            android:text="@string/licence_soon_message"
                            android:textColor="@color/warning" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/licenceRenew"
                            style="@style/Widget.Anoy.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/renew_description"
                            android:text="@string/renew" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- GAME: icon (GAME_ICON_URL in MAct, cached; vector placeholder), BGMI version,
                 library version, then the honest State and the panel's Server word. -->
            <TextView
                style="@style/Text.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/group_gap"
                android:accessibilityHeading="true"
                android:text="@string/section_game" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/gameCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/gameHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/card_padding">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/gameIcon"
                            android:layout_width="@dimen/game_icon"
                            android:layout_height="@dimen/game_icon"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            app:shapeAppearance="@style/ShapeAppearance.Anoy.GameIcon"
                            app:srcCompat="@drawable/game_icon_placeholder"
                            app:strokeColor="@color/hairline"
                            app:strokeWidth="@dimen/hairline" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/gameValue"
                                style="@style/Text.Headline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="@string/game_name" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/Text.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/row_library" />

                                <TextView
                                    android:id="@+id/libraryValue"
                                    style="@style/Text.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/jetbrains_mono_regular"
                                    android:fontFeatureSettings="tnum"
                                    android:maxLines="1" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/Separator" />

                    <LinearLayout style="@style/ListRow">

                        <ImageView
                            style="@style/Tile"
                            app:srcCompat="@drawable/ic_activity" />

                        <TextView
                            style="@style/Text.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/row_state" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1">

                            <TextView
                                android:id="@+id/gameStateValue"
                                style="@style/Chip"
                                android:layout_gravity="end|center_vertical"
                                android:ellipsize="end"
                                android:textColor="@color/text_secondary" />
                        </FrameLayout>
                    </LinearLayout>

                    <View style="@style/Separator" />

                    <LinearLayout style="@style/ListRow">

                        <ImageView
                            style="@style/Tile"
                            app:srcCompat="@drawable/ic_server" />

                        <TextView
                            style="@style/Text.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/row_server" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1">

                            <TextView
                                android:id="@+id/serverValue"
                                style="@style/Chip"
                                android:layout_gravity="end|center_vertical"
                                android:ellipsize="end"
                                android:textColor="@color/text_secondary" />

                            <View
                                android:id="@+id/serverSkeleton"
                                style="@style/Skeleton"
                                android:layout_width="72dp"
                                android:layout_gravity="end|center_vertical" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Pinned action bar over a 24 dp fade; Launch is the one filled control. -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:tag="snackbar_anchor">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fade_height"
            android:background="@drawable/bg_fade"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/actionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_12">

            <TextView
                android:id="@+id/statusMessage"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/taskProgress"
                style="@style/Widget.Anoy.Progress.Thin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primaryAction"
                style="@style/Widget.Anoy.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launch" />
        </LinearLayout>
    </LinearLayout>

    <!-- SETTINGS (2.2.0): full-screen page over home in the same visual system.
         Back (header chevron or system back) closes it. No Launch / Stop here. -->
    <LinearLayout
        android:id="@+id/settingsPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settingsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_8"
            android:paddingEnd="@dimen/screen_padding">

            <ImageButton
                android:id="@+id/settingsBack"
                style="@style/IconButton"
                android:contentDescription="@string/settings_back"
                app:srcCompat="@drawable/ic_chevron_left" />

            <TextView
                android:id="@+id/settingsTitle"
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/settings" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/settingsScroll"
            style="@style/Scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/settingsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/space_32">

                <!-- Device -->
                <TextView
                    style="@style/Text.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_device" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/deviceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout style="@style/ListRow">

                            <ImageView
                                style="@style/Tile"
                                app:srcCompat="@drawable/ic_smartphone" />

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:text="@string/settings_model" />

                            <TextView
                                android:id="@+id/modelValue"
                                style="@style/Text.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_12"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <View style="@style/Separator" />

                        <LinearLayout style="@style/ListRow">

                            <ImageView
                                style="@style/Tile"
                                app:srcCompat="@drawable/ic_cpu" />

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:text="@string/settings_android" />

                            <TextView
                                android:id="@+id/androidValue"
                                style="@style/Text.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_12"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Access and files: summary chip, the three items, OBB. Tap a missing item to fix it. -->
                <TextView
                    style="@style/Text.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_state" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/stateCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/accessRow"
                            style="@style/ListRow"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true">

                            <ImageView
                                style="@style/Tile"
                                app:srcCompat="@drawable/ic_shield_check" />

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1">

                                <TextView
                                    android:id="@+id/accessValue"
                                    style="@style/Chip"
                                    android:layout_gravity="start|center_vertical"
                                    android:ellipsize="end"
                                    android:importantForAccessibility="no"
                                    android:textColor="@color/text_secondary" />
                            </FrameLayout>
                        </LinearLayout>

                        <View style="@style/Separator" />

                        <LinearLayout
                            android:id="@+id/permAllFilesRow"
                            style="@style/ListRow"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true">

                            <ImageView
                                style="@style/Tile"
                                app:srcCompat="@drawable/ic_folder_lock" />

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:text="@string/settings_all_files" />

                            <TextView
                                android:id="@+id/permAllFilesValue"
                                style="@style/Chip"
                                android:layout_marginStart="@dimen/space_8"
                                android:importantForAccessibility="no"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <View style="@style/Separator" />

                        <LinearLayout
                            android:id="@+id/permFilesRow"
                            style="@style/ListRow"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true">

                            <ImageView
                                style="@style/Tile"
                                app:srcCompat="@drawable/ic_folder_check" />

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:text="@string/settings_files" />

                            <TextView
                                android:id="@+id/permFilesValue"
                                style="@style/Chip"
                                android:layout_marginStart="@dimen/space_8"
                                android:importantForAccessibility="no"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <View style="@style/Separator" />

                        <LinearLayout
                            android:id="@+id/permInstallRow"
                            style="@style/ListRow"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true">

                            <ImageView
                                style="@style/Tile"
                                app:srcCompat="@drawable/ic_download" />

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:text="@string/settings_install" />

                            <TextView
                                android:id="@+id/permInstallValue"
                                style="@style/Chip"
                                android:layout_marginStart="@dimen/space_8"
                                android:importantForAccessibility="no"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <View style="@style/Separator" />

                        <LinearLayout
                            android:id="@+id/obbRow"
                            style="@style/ListRow">

                            <ImageView
                                style="@style/Tile"
                                app:srcCompat="@drawable/ic_package" />

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:text="@string/settings_obb" />

                            <TextView
                                android:id="@+id/obbValue"
                                style="@style/Chip"
                                android:layout_marginStart="@dimen/space_8"
                                android:importantForAccessibility="no"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:text="@string/settings_obb_hint"
                    android:textColor="@color/text_tertiary" />

                <!-- Report a problem: nothing is sent unless the user taps. -->
                <TextView
                    style="@style/Text.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_report" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/reportCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/settingsTelegram"
                            style="@style/ListRow"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true">

                            <ImageView
                                style="@style/Tile"
                                app:srcCompat="@drawable/ic_send" />

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:text="@string/settings_telegram" />
                        </LinearLayout>

                        <View style="@style/Separator" />

                        <LinearLayout
                            android:id="@+id/settingsCopySupport"
                            style="@style/ListRow"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true">

                            <ImageView
                                style="@style/Tile"
                                app:srcCompat="@drawable/ic_bug" />

                            <TextView
                                style="@style/Text.RowLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:layout_weight="1"
                                android:text="@string/settings_copy_support" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- App -->
                <TextView
                    style="@style/Text.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_app" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/appCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout style="@style/ListRow">

                        <ImageView
                            style="@style/Tile"
                            app:srcCompat="@drawable/ic_info" />

                        <TextView
                            style="@style/Text.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/settings_version" />

                        <TextView
                            android:id="@+id/appVersionValue"
                            style="@style/Text.RowValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:fontFamily="@font/jetbrains_mono_regular"
                            android:fontFeatureSettings="tnum"
                            android:textSize="@dimen/text_callout" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Account: the existing Sign out / Forget this key sheet. -->
                <TextView
                    style="@style/Text.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/group_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_section_account" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signOut"
                    style="@style/Widget.Anoy.Button.Destructive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_out"
                    app:icon="@drawable/ic_log_out"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
