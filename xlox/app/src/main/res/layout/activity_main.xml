<?xml version="1.0" encoding="utf-8"?>
<!-- Home: grouped rows separated by hairlines, one blue primary action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.LargeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/home_title" />

            <Button
                android:id="@+id/signOut"
                style="@style/Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/sign_out" />
        </LinearLayout>

        <TextView
            android:id="@+id/panelNote"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            style="@style/Text.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="6dp"
            android:accessibilityHeading="true"
            android:text="@string/section_licence" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_height"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                style="@style/Text.RowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_status" />

            <TextView
                android:id="@+id/statusValue"
                style="@style/Text.RowValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/dash" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_height"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                style="@style/Text.RowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_expires" />

            <TextView
                android:id="@+id/expiresValue"
                style="@style/Text.RowValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/dash" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_height"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                style="@style/Text.RowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_time_left" />

            <TextView
                android:id="@+id/timeLeftValue"
                style="@style/Text.RowValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:text="@string/dash" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/separator" />

        <TextView
            style="@style/Text.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="6dp"
            android:accessibilityHeading="true"
            android:text="@string/section_game" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_height"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                style="@style/Text.RowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_game" />

            <TextView
                android:id="@+id/gameValue"
                style="@style/Text.RowValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/dash" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_height"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                style="@style/Text.RowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_state" />

            <TextView
                android:id="@+id/gameStateValue"
                style="@style/Text.RowValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/dash" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_height"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                style="@style/Text.RowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_library" />

            <TextView
                android:id="@+id/libraryValue"
                style="@style/Text.RowValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/dash" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_height"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                style="@style/Text.RowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_server" />

            <TextView
                android:id="@+id/serverValue"
                style="@style/Text.RowValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/dash" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/separator" />

        <TextView
            style="@style/Text.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="6dp"
            android:accessibilityHeading="true"
            android:text="@string/section_device" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_height"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                style="@style/Text.RowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_model" />

            <TextView
                android:id="@+id/modelValue"
                style="@style/Text.RowValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/dash" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_height"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                style="@style/Text.RowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_android" />

            <TextView
                android:id="@+id/androidValue"
                style="@style/Text.RowValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/dash" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/separator" />

    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/statusMessage"
            style="@style/Text.Footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/taskProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_height"
            android:layout_marginBottom="14dp"
            android:indeterminateTint="@color/blue"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/primaryAction"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:text="@string/launch" />

            <ProgressBar
                android:id="@+id/actionSpinner"
                style="@style/Spinner"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <Button
            android:id="@+id/help"
            style="@style/Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="@string/help" />
    </LinearLayout>
</LinearLayout>
