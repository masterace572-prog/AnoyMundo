<?xml version="1.0" encoding="utf-8"?>
<!-- Home owns both game cards and its pinned, independent game controls. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homePage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">
    <ScrollView
        android:id="@+id/mainScroll"
        style="@style/Scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/screen_padding">
            <LinearLayout
                android:id="@+id/mainHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_20"
                android:gravity="center_vertical"
                android:minHeight="@dimen/space_56"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/homeKicker"
                        style="@style/Text.Kicker.Tertiary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_name" />
                    <TextView
                        android:id="@+id/homeTitle"
                        style="@style/Text.TitleL"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:accessibilityHeading="true"
                        android:text="@string/home_title" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelNoteCard"
                style="@style/Widget.Anoy.Card.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:focusable="true"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">
                    <ImageView
                        android:layout_width="@dimen/icon_inline"
                        android:layout_height="@dimen/icon_inline"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_megaphone"
                        app:tint="@color/notice_icon" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/panelNoteKicker"
                            style="@style/Text.Kicker.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/announcement" />
                        <TextView
                            android:id="@+id/panelNote"
                            style="@style/Text.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/gameUpdateCard"
                style="@style/Widget.Anoy.Card.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:focusable="true"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">
                    <ImageView
                        android:layout_width="@dimen/icon_inline"
                        android:layout_height="@dimen/icon_inline"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_triangle_alert"
                        app:tint="@color/notice_icon" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.Kicker.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/game_update_kicker" />
                        <TextView
                            android:id="@+id/gameUpdateText"
                            style="@style/Text.Notice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/licenceCard"
                style="@style/Widget.Anoy.Card.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/licenceLabel"
                            style="@style/Text.Kicker"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/licence_expires_in" />
                        <TextView
                            android:id="@+id/statusValue"
                            style="@style/Text.Caption.Medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:drawablePadding="@dimen/space_8"
                            android:gravity="center_vertical"
                            android:text="@string/dash" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/timeLeftValue"
                        style="@style/Text.Countdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/dash" />
                    <TextView
                        android:id="@+id/expiresValue"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:fontFeatureSettings="tnum" />
                    <TextView
                        android:id="@+id/licenceChecked"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textColor="@color/text_tertiary"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/gameCard"
                style="@style/Widget.Anoy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <LinearLayout
                        android:id="@+id/gameHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/gameTile"
                            android:layout_width="@dimen/game_tile"
                            android:layout_height="@dimen/game_tile"
                            android:contentDescription="@string/game_icon_description"
                            android:padding="@dimen/game_icon_inset"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Anoy.GameTile"
                            app:srcCompat="@drawable/ic_game_bgmi"
                            app:strokeColor="@color/hairline"
                            app:strokeWidth="@dimen/hairline" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="true"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/gameValue"
                                    style="@style/Text.TitleM"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:text="@string/game_name" />
                                <TextView
                                    android:id="@+id/gameVersion"
                                    style="@style/Text.Mono"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_8"
                                    android:fontFeatureSettings="tnum"
                                    android:maxLines="1"
                                    android:visibility="gone" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/libraryValue"
                                style="@style/Text.Mono"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/text_tertiary" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        style="@style/Divider"
                        android:layout_marginTop="@dimen/space_20" />
                    <LinearLayout
                        android:id="@+id/stateCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Text.Micro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/row_state" />
                            <TextView
                                android:id="@+id/gameStateValue"
                                style="@style/Text.BodyL.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:drawablePadding="@dimen/space_8"
                                android:gravity="center_vertical"
                                android:text="@string/dash" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Text.Micro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/row_server" />
                            <TextView
                                android:id="@+id/serverValue"
                                style="@style/Text.BodyL.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:drawablePadding="@dimen/space_8"
                                android:gravity="center_vertical"
                                android:text="@string/dash" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/airGameCard"
                style="@style/Widget.Anoy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/airGameTile"
                            android:layout_width="@dimen/game_tile"
                            android:layout_height="@dimen/game_tile"
                            android:contentDescription="@string/game_air_name"
                            android:padding="@dimen/game_icon_inset"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Anoy.GameTile"
                            app:srcCompat="@drawable/ic_game_bgmi_air"
                            app:strokeColor="@color/hairline"
                            app:strokeWidth="@dimen/hairline" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/airGameValue"
                                style="@style/Text.TitleM"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/game_air_name" />
                            <TextView
                                android:id="@+id/airGameVersion"
                                style="@style/Text.Mono"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:visibility="gone" />
                            <TextView
                                android:id="@+id/airLibraryValue"
                                style="@style/Text.Mono"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/game_air_library" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        style="@style/Divider"
                        android:layout_marginTop="@dimen/space_20" />
                    <TextView
                        style="@style/Text.Micro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="@string/row_state" />
                    <TextView
                        android:id="@+id/airGameStateValue"
                        style="@style/Text.BodyL.Medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:drawablePadding="@dimen/space_8"
                        android:gravity="center_vertical"
                        android:text="@string/coming_soon" />
                    <TextView
                        android:id="@+id/airComingSoonDetail"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/game_air_coming_soon_detail" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/black"
        android:orientation="vertical">
        <View
            android:id="@+id/actionDivider"
            style="@style/Divider"
            android:visibility="invisible" />
        <LinearLayout
            android:id="@+id/actionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_16">
            <TextView
                android:id="@+id/statusMessage"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:visibility="gone" />
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/taskProgress"
                style="@style/Widget.Anoy.Progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:importantForAccessibility="no"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/primaryAction"
                style="@style/Widget.Anoy.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/game_launch_bgmi" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/airPrimaryAction"
                style="@style/Widget.Anoy.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:enabled="false"
                android:text="@string/game_air_coming_soon_action" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
