<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 1: sign in. One serif headline (top app bar), one accent-filled control. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/loginTopBar"
        style="@style/Widget.Ds.TopAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12">

        <TextView
            android:id="@+id/appName"
            style="@style/TextAppearance.Ds.HeadlineSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <View
            android:layout_width="@dimen/space_0"
            android:layout_height="@dimen/divider"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/themeToggle"
            style="@style/Widget.Ds.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/theme_toggle"
            android:src="@drawable/ds_ic_dark_mode" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/loginScroll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_0"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_32"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_32">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="@dimen/mark_size"
                android:layout_height="@dimen/mark_size"
                android:contentDescription="@string/content_description_mark"
                android:src="@drawable/ds_mark_anoy" />

            <TextView
                android:id="@+id/premium"
                style="@style/TextAppearance.Ds.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/sign_in_intro" />

            <LinearLayout
                android:id="@+id/loginCard"
                style="@style/Widget.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/accessKeyLabel"
                    style="@style/TextAppearance.Ds.LabelMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/access_key_label"
                    android:textColor="@color/text_secondary"
                    android:labelFor="@id/userkey" />

                <LinearLayout
                    android:id="@+id/accessKeyField"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/field_height"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/ds_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/userkey"
                        style="@style/Widget.Ds.TextField"
                        android:layout_width="@dimen/space_0"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:inputType="textPassword"
                        android:nextFocusForward="@id/login" />

                    <ImageButton
                        android:id="@+id/eyeToggle"
                        style="@style/Widget.Ds.IconButton"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:contentDescription="@string/show_key"
                        android:src="@drawable/ds_ic_visibility" />
                </LinearLayout>

                <TextView
                    android:id="@+id/accessKeyHelper"
                    style="@style/TextAppearance.Ds.Tertiary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/access_key_hint" />

                <com.xlox.ui.designsystem.PrimaryButton
                    android:id="@+id/login"
                    style="@style/Widget.Ds.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/sign_in" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/pasteKey"
                    style="@style/Widget.Ds.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_8"
                    android:minWidth="@dimen/touch_target"
                    android:text="@string/paste_key" />
            </LinearLayout>

            <TextView
                android:id="@+id/buyNow"
                style="@style/TextAppearance.Ds.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/need_key" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buyKey"
                style="@style/Widget.Ds.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:minWidth="@dimen/touch_target"
                android:text="@string/get_a_key" />

            <TextView
                android:id="@+id/telegramCaption"
                style="@style/TextAppearance.Ds.Tertiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/telegram_handle" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
