<?xml version="1.0" encoding="utf-8"?>
<!-- Loader sign-in: the same black, Manrope and quiet blue controls as Home.
     The form scrolls above the IME; icon hit targets stay 48dp, keys scroll in-place. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <TextView
        android:id="@+id/loginBrand"
        style="@style/Text.Dashboard.Brand"
        android:layout_width="match_parent"
        android:layout_height="@dimen/brand_row_height"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:text="@string/brand_name" />

    <ScrollView
        android:id="@+id/loginScroll"
        style="@style/Scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/loginContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_24">

            <Space
                android:id="@+id/loginTopSpace"
                android:layout_width="match_parent"
                android:layout_height="@dimen/login_top_space" />

            <TextView
                android:id="@+id/loginTitle"
                style="@style/Text.Auth.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/login_title" />

            <TextView
                android:id="@+id/loginSubtitle"
                style="@style/Text.Dashboard.Body"
                android:textColor="@color/text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/login_subtitle" />

            <TextView
                android:id="@+id/keyLabel"
                style="@style/Text.Dashboard.Meta.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_28"
                android:labelFor="@id/userkey"
                android:text="@string/licence_key" />

            <!-- No leading decoration: give the key the remaining width, with two
                 equally-sized, separately-labelled trailing icon controls. -->
            <LinearLayout
                android:id="@+id/keyField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/field_height"
                android:layout_marginTop="@dimen/space_8"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="@dimen/space_4">

                <EditText
                    android:id="@+id/userkey"
                    style="@style/Text.Auth.Key"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:background="@null"
                    android:hint="@string/licence_key_hint"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textPassword|textNoSuggestions"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:scrollHorizontally="true"
                    android:gravity="start|center_vertical"
                    android:minHeight="@dimen/field_height"
                    android:paddingStart="@dimen/space_16"
                    android:paddingEnd="@dimen/space_4"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary" />

                <ImageButton
                    android:id="@+id/toggleKey"
                    style="@style/IconButton.Inline"
                    android:contentDescription="@string/show_key_description"
                    app:srcCompat="@drawable/ic_eye"
                    app:tint="@color/key_visibility_tint" />

                <ImageButton
                    android:id="@+id/pasteKey"
                    style="@style/IconButton.Inline"
                    android:contentDescription="@string/paste_key_description"
                    app:srcCompat="@drawable/ic_clipboard" />
            </LinearLayout>

            <!-- Reserved 20 dp helper line, so an error never pushes the layout. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/helper_line">

                <TextView
                    android:id="@+id/keyError"
                    style="@style/Text.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 2.3.4: connection / VPN / server problems: a neutral block
                 (surface-2, secondary text, 16 dp Lucide glyph) with Try again.
                 Problems with the key itself stay red under the field. -->
            <LinearLayout
                android:id="@+id/loginNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_neutral_block"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_12"
                android:paddingTop="@dimen/space_12"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_4"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/loginNoticeIcon"
                        android:layout_width="@dimen/icon_small"
                        android:layout_height="@dimen/icon_small"
                        android:layout_marginTop="@dimen/space_2"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_wifi_off"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/loginNoticeText"
                        style="@style/Text.Dashboard.Notice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_marginEnd="@dimen/space_8"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginNoticeRetry"
                    style="@style/Widget.Anoy.Button.Text.Auth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/try_again" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/loginActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="vertical"
                android:tag="snackbar_anchor">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login"
                    style="@style/Widget.Anoy.Button.Auth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_in" />

                <!-- A short, centred lead and one 48dp link remain readable at large
                     font sizes, without compressing the field or login control. -->
                <LinearLayout
                    android:id="@+id/getKeyRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Dashboard.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/get_key_lead" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/getKey"
                        style="@style/Widget.Anoy.Button.Text.Auth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/get_key_description"
                        android:text="@string/get_key" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Versions: pinned 24 dp above the navigation inset; hidden with the keyboard. -->
    <FrameLayout
        android:id="@+id/loginFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:id="@+id/versionFooter"
            style="@style/Text.Dashboard.Footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />
    </FrameLayout>
</LinearLayout>
