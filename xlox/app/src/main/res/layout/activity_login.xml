<?xml version="1.0" encoding="utf-8"?>
<!--
  Sign in (spec 3.2), 24 dp gutters:
    brand row (56 dp)  "Anoy Hax", left; nothing on the right
    ~72 dp space       (shrinks while the keyboard is open)
    Sign in / subtitle / "Licence key" / field / reserved helper line
    Sign in (56 dp) and "Get one on Telegram"
    footer             "App 2.3.0 · Library 1.13", pinned, hidden with the keyboard
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/loginBrand"
        style="@style/Text.Brand"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/gutter_wide"
        android:paddingEnd="@dimen/gutter_wide"
        android:text="@string/brand_name" />

    <ScrollView
        android:id="@+id/loginScroll"
        style="@style/Scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/loginContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter_wide"
            android:paddingEnd="@dimen/gutter_wide"
            android:paddingBottom="@dimen/space_24">

            <Space
                android:id="@+id/loginTopSpace"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_72" />

            <TextView
                android:id="@+id/loginTitle"
                style="@style/Text.TitleL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/login_title" />

            <TextView
                android:id="@+id/loginSubtitle"
                style="@style/Text.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/login_subtitle" />

            <TextView
                android:id="@+id/keyLabel"
                style="@style/Text.Caption.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:labelFor="@id/userkey"
                android:text="@string/licence_key" />

            <!-- Field: no leading icon; key in Mono; eye, a 1 x 20 dp divider, Paste. -->
            <LinearLayout
                android:id="@+id/keyField"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:layout_marginTop="@dimen/space_8"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/userkey"
                    style="@style/Text.MonoKey"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:background="@null"
                    android:hint="@string/licence_key_hint"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textPassword|textNoSuggestions"
                    android:maxLines="1"
                    android:minHeight="@dimen/touch_target"
                    android:paddingStart="@dimen/space_16"
                    android:paddingEnd="@dimen/space_4"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary" />

                <ImageButton
                    android:id="@+id/toggleKey"
                    style="@style/IconButton.Inline"
                    android:contentDescription="@string/show_key_description"
                    android:src="@drawable/ic_eye" />

                <View
                    android:layout_width="@dimen/hairline"
                    android:layout_height="@dimen/field_divider_height"
                    android:background="@color/hairline"
                    android:importantForAccessibility="no" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pasteKey"
                    style="@style/Widget.Anoy.Button.Text.Paste"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/paste_key_description"
                    android:text="@string/paste" />
            </LinearLayout>

            <!-- Reserved 20 dp helper line, so an error never pushes the layout. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/helper_line">

                <TextView
                    android:id="@+id/keyError"
                    style="@style/Text.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Connection / VPN problems: inline danger-tint block with Try again. -->
            <LinearLayout
                android:id="@+id/loginNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_error_block"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_12"
                android:paddingTop="@dimen/space_12"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_4"
                android:visibility="gone">

                <TextView
                    android:id="@+id/loginNoticeText"
                    style="@style/Text.BodyS"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/danger" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginNoticeRetry"
                    style="@style/Widget.Anoy.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/try_again" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/loginActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="vertical"
                android:tag="snackbar_anchor">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login"
                    style="@style/Widget.Anoy.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_in" />

                <!-- 2.3.1: one centred line. Only "Buy one" is a control (48 dp
                     target, accent, Inter 500); it opens the same Telegram link. -->
                <LinearLayout
                    android:id="@+id/getKeyRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.LinkLead"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/get_key_lead" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/getKey"
                        style="@style/Widget.Anoy.Button.Text.Inline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/get_key_description"
                        android:text="@string/get_key" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Versions: pinned 24 dp above the navigation inset; hidden with the keyboard. -->
    <FrameLayout
        android:id="@+id/loginFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:id="@+id/versionFooter"
            style="@style/Text.Mono.Footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />
    </FrameLayout>
</LinearLayout>
