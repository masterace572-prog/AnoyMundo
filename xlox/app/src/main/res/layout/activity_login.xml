<?xml version="1.0" encoding="utf-8"?>
<!-- Licence-key sign in. Black page, white text, one blue action, icon controls. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRoot"
    style="@style/Scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/loginContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="72dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/loginTile"
            style="@style/Tile.Large"
            android:background="@drawable/bg_tile_blue_large"
            android:src="@drawable/ic_key_round_blue" />

        <TextView
            android:id="@+id/loginTitle"
            style="@style/Text.LargeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/login_title" />

        <TextView
            android:id="@+id/loginSubtitle"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/login_subtitle" />

        <TextView
            android:id="@+id/keyLabel"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:labelFor="@+id/userkey"
            android:text="@string/licence_key" />

        <LinearLayout
            android:id="@+id/keyField"
            android:layout_width="match_parent"
            android:layout_height="@dimen/field_height"
            android:layout_marginTop="8dp"
            android:addStatesFromChildren="true"
            android:background="@drawable/bg_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="@dimen/icon_small"
                android:layout_height="@dimen/icon_small"
                android:layout_marginEnd="10dp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_key_round"
                app:tint="@color/field_icon_tint" />

            <EditText
                android:id="@+id/userkey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:hint="@string/licence_key_hint"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textPassword|textNoSuggestions"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_headline" />

            <ImageButton
                android:id="@+id/toggleKey"
                style="@style/IconButton"
                android:contentDescription="@string/show_key_description"
                app:srcCompat="@drawable/ic_eye" />

            <ImageButton
                android:id="@+id/pasteKey"
                style="@style/IconButton"
                android:contentDescription="@string/paste_key_description"
                app:srcCompat="@drawable/ic_clipboard_paste" />
        </LinearLayout>

        <TextView
            android:id="@+id/keyError"
            style="@style/Text.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="assertive"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_alert_red" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">

            <Button
                android:id="@+id/login"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:enabled="false"
                android:text="@string/sign_in" />

            <ProgressBar
                android:id="@+id/loginSpinner"
                style="@style/Spinner"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <LinearLayout
            android:id="@+id/loginFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Footnote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/need_key" />

            <Button
                android:id="@+id/getKey"
                style="@style/Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:drawablePadding="8dp"
                android:text="@string/get_key"
                app:drawableStartCompat="@drawable/ic_send_blue" />

            <TextView
                android:id="@+id/versionFooter"
                style="@style/Text.Footnote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
