<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 1: access-key sign in. One accent-filled control, no duplicate labels. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/loginTopBar"
        style="@style/Widget.Ds.TopAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:id="@+id/appName"
            style="@style/TextAppearance.Ds.HeadlineSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name" />

        <com.xlox.ui.designsystem.ThemeToggleView
            android:id="@+id/themeToggle"
            android:layout_width="@dimen/toggle_width"
            android:layout_height="@dimen/toggle_height"
            android:contentDescription="@string/theme_toggle" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/loginScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_24"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_32">

            <!-- Custom "A" emblem in a recessed, top-lit container -->
            <FrameLayout
                android:id="@+id/emblemContainer"
                android:layout_width="@dimen/emblem_container"
                android:layout_height="@dimen/emblem_container"
                android:background="@drawable/ds_emblem_container">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="@dimen/emblem_size"
                    android:layout_height="@dimen/emblem_size"
                    android:layout_gravity="center"
                    android:contentDescription="@string/content_description_mark"
                    android:src="@drawable/ds_emblem_a" />
            </FrameLayout>

            <TextView
                android:id="@+id/welcomeHeading"
                style="@style/TextAppearance.Ds.HeadlineLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/welcome_heading" />

            <TextView
                android:id="@+id/premium"
                style="@style/TextAppearance.Ds.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/welcome_subtitle" />

            <!-- Access-key pod -->
            <com.xlox.ui.designsystem.DsSurface
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:padding="@dimen/card_padding"
                app:dsVariant="card">

                <TextView
                    android:id="@+id/accessKeyLabel"
                    style="@style/TextAppearance.Ds.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/userkey"
                    android:text="@string/access_key_label" />

                <LinearLayout
                    android:id="@+id/accessKeyField"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/field_height"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/ds_field_rest"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_16"
                    android:paddingEnd="@dimen/space_4">

                    <ImageView
                        android:id="@+id/keyIcon"
                        android:layout_width="@dimen/icon_inline"
                        android:layout_height="@dimen/icon_inline"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ds_ic_key"
                        app:tint="@color/icon" />

                    <EditText
                        android:id="@+id/userkey"
                        style="@style/Widget.Ds.TextField"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="@string/access_key_hint"
                        android:inputType="textPassword"
                        android:nextFocusForward="@id/login"
                        android:paddingStart="@dimen/space_12"
                        android:paddingEnd="@dimen/space_4"
                        tools:ignore="Autofill" />

                    <ImageButton
                        android:id="@+id/eyeToggle"
                        style="@style/Widget.Ds.IconButton"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:background="@drawable/ds_icon_ripple"
                        android:contentDescription="@string/show_key"
                        android:src="@drawable/ds_ic_eye"
                        app:tint="@color/icon" />
                </LinearLayout>

                <com.xlox.ui.designsystem.PrimaryButton
                    android:id="@+id/login"
                    style="@style/Widget.Ds.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/login_button_height"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/sign_in" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/pasteKey"
                    style="@style/Widget.Ds.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_12"
                    android:drawableStart="@drawable/ds_ic_clipboard"
                    android:drawablePadding="@dimen/space_8"
                    android:paddingStart="@dimen/space_16"
                    android:paddingEnd="@dimen/space_16"
                    android:text="@string/paste_key" />
            </com.xlox.ui.designsystem.DsSurface>

            <!-- Need a key? Get a key — one interactive pill row -->
            <LinearLayout
                android:id="@+id/buyKey"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/ds_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16">

                <TextView
                    android:id="@+id/buyNow"
                    style="@style/TextAppearance.Ds.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/need_key" />

                <TextView
                    android:id="@+id/buyKeyLabel"
                    style="@style/TextAppearance.Ds.LabelLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/get_a_key"
                    android:textColor="@color/accent_ink" />

                <ImageView
                    android:id="@+id/buyKeyArrow"
                    android:layout_width="@dimen/icon_inline"
                    android:layout_height="@dimen/icon_inline"
                    android:layout_marginStart="@dimen/space_4"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ds_ic_arrow_up_right"
                    app:tint="@color/accent_ink" />
            </LinearLayout>

            <!-- Signature badge -->
            <TextView
                android:id="@+id/telegramCaption"
                style="@style/TextAppearance.Ds.Mono.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:background="@drawable/ds_badge"
                android:paddingStart="@dimen/space_12"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/space_12"
                android:paddingBottom="@dimen/space_8"
                android:text="@string/telegram_handle"
                android:textColor="@color/text_tertiary" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
