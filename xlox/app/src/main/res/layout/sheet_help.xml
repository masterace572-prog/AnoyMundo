<?xml version="1.0" encoding="utf-8"?>
<!--
  Help (spec 3.9): the shared sheet with a handle. Kicker HELP + Title M; the
  three topics LAUNCH / FILES AND ACCESS / RENEW (kicker + Body, split by
  dividers, 20 dp either side); a surface-3 list with Help on Telegram and
  Copy support info; then a tonal "Got it" (48 dp).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/helpRoot"
    style="@style/Scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter_wide"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/gutter_wide"
        android:paddingBottom="@dimen/gutter_wide">

        <View style="@style/SheetHandle" />

        <TextView
            style="@style/Text.Kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_title" />

        <TextView
            android:id="@+id/helpTitle"
            style="@style/Text.TitleM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kicker_gap"
            android:accessibilityHeading="true"
            android:text="@string/help_open" />

        <!-- Launch -->
        <LinearLayout
            android:id="@+id/helpTipLaunch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Kicker.Tertiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:contentDescription="@string/help_launch_title"
                android:text="@string/launch" />

            <TextView
                style="@style/Text.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/help_launch_body" />
        </LinearLayout>

        <View
            style="@style/Divider"
            android:layout_marginTop="@dimen/space_20" />

        <!-- Files and access -->
        <LinearLayout
            android:id="@+id/helpTipAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Kicker.Tertiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:contentDescription="@string/help_access_title"
                android:text="@string/help_kicker_access" />

            <TextView
                style="@style/Text.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/help_access_body" />
        </LinearLayout>

        <View
            style="@style/Divider"
            android:layout_marginTop="@dimen/space_20" />

        <!-- Renew -->
        <LinearLayout
            android:id="@+id/helpTipRenew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Kicker.Tertiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:contentDescription="@string/help_renew_title"
                android:text="@string/renew" />

            <TextView
                style="@style/Text.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/help_renew_body" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Anoy.Group.InSheet"
            android:layout_marginTop="@dimen/space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/helpTelegram"
                    style="@style/Row.InSheet"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/Text.RowLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/help" />

                    <ImageView
                        style="@style/RowGlyph"
                        app:srcCompat="@drawable/ic_arrow_up_right" />
                </LinearLayout>

                <View style="@style/RowDivider" />

                <LinearLayout
                    android:id="@+id/helpCopySupport"
                    style="@style/Row.InSheet"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/Text.RowLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/help_copy_support" />

                    <ImageView
                        style="@style/RowGlyph"
                        app:srcCompat="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/helpGotIt"
            style="@style/Widget.Anoy.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/help_got_it" />
    </LinearLayout>
</ScrollView>
