<?xml version="1.0" encoding="utf-8"?>
<!-- Help: three short tips, a private "Copy support info" and the existing Telegram link. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/helpRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_32"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:id="@+id/helpTitle"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/help_title" />

        <LinearLayout
            android:id="@+id/helpTipLaunch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:focusable="true"
            android:orientation="horizontal">

            <ImageView
                style="@style/Tile"
                app:srcCompat="@drawable/ic_play" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/help_launch_title" />

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/help_launch_body" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/helpTipAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:focusable="true"
            android:orientation="horizontal">

            <ImageView
                style="@style/Tile"
                app:srcCompat="@drawable/ic_folder_lock" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/help_access_title" />

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/help_access_body" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/helpTipRenew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:focusable="true"
            android:orientation="horizontal">

            <ImageView
                style="@style/Tile"
                app:srcCompat="@drawable/ic_timer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/help_renew_title" />

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/help_renew_body" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/helpCopySupport"
            style="@style/Widget.Anoy.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/help_copy_support"
            app:icon="@drawable/ic_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/helpTelegram"
            style="@style/Widget.Anoy.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:minHeight="@dimen/button_height"
            android:text="@string/help"
            app:icon="@drawable/ic_send" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/helpGotIt"
            style="@style/Widget.Anoy.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/help_got_it" />
    </LinearLayout>
</ScrollView>
