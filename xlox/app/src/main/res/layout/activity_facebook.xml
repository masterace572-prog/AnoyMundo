<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 3: WebView. Edge-to-edge with safeDrawing padding on the container. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/facebookRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Widget.Ds.TopAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/screen_padding">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.Ds.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/ds_icon_ripple"
            android:contentDescription="@string/back"
            android:src="@drawable/ds_ic_arrow_left"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/TextAppearance.Ds.TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/facebook" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <WebView
            android:id="@+id/facebookWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/facebookProgressBar"
            android:layout_width="@dimen/progress_circular_large"
            android:layout_height="@dimen/progress_circular_large"
            android:layout_gravity="center"
            android:contentDescription="@string/page_loading"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
