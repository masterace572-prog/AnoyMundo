<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/snackbarRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="@dimen/space_16"
    android:layout_marginEnd="@dimen/space_16"
    android:background="@drawable/ds_snackbar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingEnd="@dimen/space_8"
    android:paddingBottom="@dimen/space_12">

    <TextView
        android:id="@+id/snackbarText"
        style="@style/TextAppearance.Ds.BodyMedium"
        android:layout_width="@dimen/space_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_primary" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/snackbarAction"
        style="@style/Widget.Ds.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height"
        android:minWidth="@dimen/touch_target"
        android:text="@string/dismiss"
        android:visibility="gone" />
</LinearLayout>
