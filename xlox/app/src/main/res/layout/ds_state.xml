<?xml version="1.0" encoding="utf-8"?>
<!-- Shared loading / empty / error state. Used by MAct and the debug preview. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/stateRuleRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/stateRule"
            android:layout_width="@dimen/status_rule"
            android:layout_height="match_parent"
            android:background="@color/error" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stateHeadline"
                style="@style/TextAppearance.Ds.HeadlineSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/stateSupporting"
                style="@style/TextAppearance.Ds.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stateLoadingRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/stateIndicator"
            android:layout_width="@dimen/progress_circular"
            android:layout_height="@dimen/progress_circular"
            android:contentDescription="@string/state_loading"
            android:indeterminate="true"
            android:indeterminateTint="@color/text_secondary" />

        <ProgressBar
            android:id="@+id/stateProgress"
            style="@style/Widget.Ds.Progress.Linear"
            android:layout_width="0dp"
            android:layout_height="@dimen/progress_linear"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statePercent"
            style="@style/TextAppearance.Ds.Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12" />
    </LinearLayout>

    <TextView
        android:id="@+id/stateDetail"
        style="@style/TextAppearance.Ds.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/stateAction"
        style="@style/Widget.Ds.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_16"
        android:minWidth="@dimen/touch_target"
        android:text="@string/dismiss"
        android:visibility="gone" />

</merge>
