<?xml version="1.0" encoding="utf-8"?>
<!-- Compact, fixed-height state row: no layout shift when a state changes. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:id="@+id/stateRule"
        android:layout_width="@dimen/status_rule"
        android:layout_height="@dimen/list_item_single"
        android:background="@color/hairline_strong" />

    <ProgressBar
        android:id="@+id/stateIndicator"
        android:layout_width="@dimen/progress_circular"
        android:layout_height="@dimen/progress_circular"
        android:layout_marginStart="@dimen/space_12"
        android:contentDescription="@string/state_loading"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/stateProgress"
        style="@style/Widget.Ds.Progress.Linear"
        android:layout_width="0dp"
        android:layout_height="@dimen/progress_linear"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:max="100"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statePercent"
        style="@style/TextAppearance.Ds.Mono.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/stateDetail"
        style="@style/TextAppearance.Ds.BodyMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/stateAction"
        style="@style/Widget.Ds.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target"
        android:minWidth="@dimen/touch_target"
        android:text="@string/dismiss"
        android:visibility="gone" />

    <!-- Kept for source compatibility with the v1 state API. -->
    <View
        android:id="@+id/stateRuleRow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/stateLoadingRow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/stateHeadline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/stateSupporting"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</merge>
