<?xml version="1.0" encoding="utf-8"?>
<!-- Settings is a retained pager page. Help is here; Sign out keeps its confirmation flow. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clickable="true"
    android:focusable="false">
    <ScrollView
        android:id="@+id/settingsScroll"
        style="@style/Scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_24">
            <LinearLayout
                android:id="@+id/settingsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/settingsTitle"
                    style="@style/Text.Dashboard.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/settings"
                    android:layout_weight="1" />
                <FrameLayout
                    android:id="@+id/helpButton"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:clickable="true"
                    android:contentDescription="@string/help_open"
                    android:focusable="true">
                    <TextView
                        style="@style/Text.HelpGlyph"
                        android:layout_width="@dimen/help_circle"
                        android:layout_height="@dimen/help_circle"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_help_circle"
                        android:duplicateParentState="true"
                        android:importantForAccessibility="no"
                        android:text="@string/help_glyph" />
                </FrameLayout>
            </LinearLayout>
            <TextView
                style="@style/Text.Dashboard.Section"
                android:layout_marginTop="@dimen/space_24"
                android:accessibilityHeading="true"
                android:text="@string/settings_section_licence" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/licenceGroup"
                style="@style/Widget.Anoy.Group.Dashboard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/licenceKeyRow"
                        style="@style/Row.Dashboard"
                        android:paddingTop="@dimen/space_4"
                        android:paddingEnd="@dimen/space_4"
                        android:paddingBottom="@dimen/space_4"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            style="@style/Text.Dashboard.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/licence_key" />
                        <TextView
                            android:id="@+id/licenceKeyValue"
                            style="@style/Text.Mono.Key"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:text="@string/dash" />
                        <ImageButton
                            android:id="@+id/licenceKeyEye"
                            style="@style/IconButton.Inline"
                            android:contentDescription="@string/licence_key_show"
                            android:src="@drawable/ic_eye" />
                    </LinearLayout>
                    <View
                        style="@style/RowDivider" />
                    <LinearLayout
                        style="@style/Row.Dashboard"
                        android:background="@null"
                        android:focusable="true">
                        <TextView
                            style="@style/Text.Dashboard.RowLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_licence_status" />
                        <TextView
                            android:id="@+id/licenceStatusValue"
                            style="@style/Text.Dashboard.RowValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:drawablePadding="@dimen/space_8"
                            android:text="@string/dash" />
                    </LinearLayout>
                    <View
                        style="@style/RowDivider" />
                    <LinearLayout
                        style="@style/Row.Dashboard"
                        android:background="@null"
                        android:focusable="true">
                        <TextView
                            style="@style/Text.Dashboard.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_licence_expires" />
                        <TextView
                            android:id="@+id/licenceExpiresValue"
                            style="@style/Text.Dashboard.RowValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:fontFeatureSettings="tnum"
                            android:text="@string/dash" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:id="@+id/licenceChecked"
                style="@style/Text.Dashboard.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:paddingStart="@dimen/row_padding"
                android:paddingEnd="@dimen/row_padding"
                android:visibility="gone" />
            <TextView
                style="@style/Text.Dashboard.Section"
                android:layout_marginTop="@dimen/space_24"
                android:accessibilityHeading="true"
                android:text="@string/settings_section_updates" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/updatesGroup"
                style="@style/Widget.Anoy.Group.Dashboard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/checkUpdateRow"
                        style="@style/Row.Dashboard"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Text.Dashboard.RowLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_check_updates" />
                            <TextView
                                android:id="@+id/checkUpdateCaption"
                                style="@style/Text.Dashboard.Meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:accessibilityLiveRegion="polite"
                                android:text="@string/settings_not_checked" />
                        </LinearLayout>
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/checkUpdateSpinner"
                            style="@style/Widget.Anoy.StatusSpinner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:importantForAccessibility="no"
                            android:indeterminate="true"
                            android:visibility="gone" />
                        <ImageView
                            android:id="@+id/checkUpdateIcon"
                            android:layout_width="@dimen/icon_small"
                            android:layout_height="@dimen/icon_small"
                            android:layout_marginStart="@dimen/space_16"
                            android:importantForAccessibility="no"
                            android:visibility="gone"
                            app:srcCompat="@drawable/ic_check"
                            app:tint="@color/success" />
                        <TextView
                            android:id="@+id/checkUpdateValue"
                            style="@style/Text.Dashboard.RowValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:accessibilityLiveRegion="polite"
                            android:visibility="gone" />
                        <ImageView
                            android:id="@+id/checkUpdateGlyph"
                            style="@style/RowGlyph"
                            app:srcCompat="@drawable/ic_chevron_right" />
                    </LinearLayout>
                    <View
                        style="@style/RowDivider" />
                    <LinearLayout
                        android:id="@+id/redownloadRow"
                        style="@style/Row.Dashboard"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            style="@style/Text.Dashboard.RowLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_redownload" />
                        <ImageView
                            style="@style/RowGlyph"
                            app:srcCompat="@drawable/ic_chevron_right" />
                    </LinearLayout>
                    <View
                        style="@style/RowDivider" />
                    <LinearLayout
                        style="@style/Row.Dashboard"
                        android:background="@null"
                        android:focusable="true">
                        <TextView
                            style="@style/Text.Dashboard.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_library_version" />
                        <TextView
                            android:id="@+id/libraryVersionValue"
                            style="@style/Text.Dashboard.Meta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:fontFeatureSettings="tnum"
                            android:gravity="end"
                            android:text="@string/dash" />
                    </LinearLayout>
                    <View
                        style="@style/RowDivider" />
                    <LinearLayout
                        style="@style/Row.Dashboard"
                        android:background="@null"
                        android:focusable="true">
                        <TextView
                            style="@style/Text.Dashboard.RowLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_version" />
                        <TextView
                            android:id="@+id/appVersionValue"
                            style="@style/Text.Dashboard.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:fontFeatureSettings="tnum" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/Text.Dashboard.Section"
                android:layout_marginTop="@dimen/space_24"
                android:accessibilityHeading="true"
                android:text="@string/settings_section_google" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/googleGroup"
                style="@style/Widget.Anoy.Group.Dashboard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        style="@style/Row.Dashboard"
                        android:background="@null"
                        android:focusable="true">
                        <TextView
                            style="@style/Text.Dashboard.RowLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/google_status_label" />
                        <TextView
                            android:id="@+id/googleStatusValue"
                            style="@style/Text.Dashboard.RowValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:drawablePadding="@dimen/space_8"
                            android:text="@string/google_status_none" />
                    </LinearLayout>
                    <View
                        style="@style/RowDivider" />
                    <LinearLayout
                        android:id="@+id/googleSetupRow"
                        style="@style/Row.Dashboard"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Text.Dashboard.RowLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/google_setup_row" />
                            <TextView
                                android:id="@+id/googleSetupCaption"
                                style="@style/Text.Dashboard.Meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:text="@string/google_setup_caption" />
                        </LinearLayout>
                        <ImageView
                            style="@style/RowGlyph"
                            app:srcCompat="@drawable/ic_chevron_right" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/Text.Dashboard.Section"
                android:layout_marginTop="@dimen/space_24"
                android:accessibilityHeading="true"
                android:text="@string/settings_section_device" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/deviceCard"
                style="@style/Widget.Anoy.Group.Dashboard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        style="@style/Row.Dashboard"
                        android:background="@null"
                        android:focusable="true">
                        <TextView
                            style="@style/Text.Dashboard.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_model" />
                        <TextView
                            android:id="@+id/modelValue"
                            style="@style/Text.Dashboard.RowValue.SingleLine"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <View
                        style="@style/RowDivider" />
                    <LinearLayout
                        style="@style/Row.Dashboard"
                        android:background="@null"
                        android:focusable="true">
                        <TextView
                            style="@style/Text.Dashboard.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_android" />
                        <TextView
                            android:id="@+id/androidValue"
                            style="@style/Text.Dashboard.RowValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/Text.Dashboard.Section"
                android:layout_marginTop="@dimen/space_24"
                android:accessibilityHeading="true"
                android:text="@string/settings_section_report" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/reportCard"
                style="@style/Widget.Anoy.Group.Dashboard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/settingsTelegram"
                        style="@style/Row.Dashboard"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            style="@style/Text.Dashboard.RowLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_telegram" />
                        <ImageView
                            style="@style/RowGlyph"
                            app:srcCompat="@drawable/ic_arrow_up_right" />
                    </LinearLayout>
                    <View
                        style="@style/RowDivider" />
                    <LinearLayout
                        android:id="@+id/settingsCopySupport"
                        style="@style/Row.Dashboard"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            style="@style/Text.Dashboard.RowLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_copy_support" />
                        <ImageView
                            style="@style/RowGlyph"
                            app:srcCompat="@drawable/ic_chevron_right" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/signOut"
                style="@style/Widget.Anoy.Button.Dashboard.SignOut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="center"
                android:textColor="@color/danger_text"
                android:text="@string/sign_out" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
