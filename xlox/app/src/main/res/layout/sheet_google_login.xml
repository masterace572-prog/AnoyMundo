<?xml version="1.0" encoding="utf-8"?>
<!--
  Google login setup (test build): the shared sheet with a handle. Kicker
  GOOGLE LOGIN + Title M, one BodyS explainer, the current provider state, then
  the latching switch that copies this phone's Google apps into Mundo. Once on
  it stays on (until the app is reinstalled or its data is cleared). Progress
  and the installer's result show inline; the tonal Cancel becomes Done once a
  task has finished.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/googleSheetRoot"
    style="@style/Scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter_wide"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/gutter_wide"
        android:paddingBottom="@dimen/gutter_wide">

        <View style="@style/SheetHandle" />

        <TextView
            style="@style/Text.Kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/google_sheet_kicker" />

        <TextView
            android:id="@+id/googleSheetTitle"
            style="@style/Text.TitleM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kicker_gap"
            android:accessibilityHeading="true"
            android:text="@string/google_sheet_title" />

        <TextView
            style="@style/Text.BodyS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/google_sheet_body" />

        <TextView
            android:id="@+id/googleSheetStatus"
            style="@style/Text.Dashboard.Meta.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:drawablePadding="@dimen/space_8"
            android:text="@string/google_status_none" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/googleEnableSwitch"
            style="@style/Widget.Anoy.Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/google_switch_label" />

        <TextView
            android:id="@+id/googleSwitchCaption"
            style="@style/Text.Dashboard.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/google_switch_caption_off" />

        <LinearLayout
            android:id="@+id/googleProgressWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/googleProgress"
                style="@style/Widget.Anoy.Progress.Sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/googleProgressText"
                style="@style/Text.Dashboard.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:accessibilityLiveRegion="polite"
                android:text="@string/google_working_phone" />
        </LinearLayout>

        <TextView
            android:id="@+id/googleResultText"
            style="@style/Text.BodyS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/googleCancel"
            style="@style/Widget.Anoy.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/cancel" />
    </LinearLayout>
</ScrollView>
