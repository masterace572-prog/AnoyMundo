<?xml version="1.0" encoding="utf-8"?>
<!--
  Google login setup (test build): the shared sheet with a handle. Kicker
  GOOGLE LOGIN + Title M, one BodyS explainer, the current provider state, then
  the actions: copy this phone's Google apps, download microG instead, or
  repair a broken microG. Progress and the installer's result show inline; the
  tonal Cancel becomes Done once a task has finished.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/googleSheetRoot"
    style="@style/Scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter_wide"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/gutter_wide"
        android:paddingBottom="@dimen/gutter_wide">

        <View style="@style/SheetHandle" />

        <TextView
            style="@style/Text.Kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/google_sheet_kicker" />

        <TextView
            android:id="@+id/googleSheetTitle"
            style="@style/Text.TitleM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kicker_gap"
            android:accessibilityHeading="true"
            android:text="@string/google_sheet_title" />

        <TextView
            style="@style/Text.BodyS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/google_sheet_body" />

        <TextView
            android:id="@+id/googleSheetStatus"
            style="@style/Text.Dashboard.Meta.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:drawablePadding="@dimen/space_8"
            android:text="@string/google_status_none" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/googleUsePhone"
            style="@style/Widget.Anoy.Button.Sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/google_use_phone" />

        <TextView
            android:id="@+id/googlePhoneCaption"
            style="@style/Text.Dashboard.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/google_use_phone_unavailable"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/googleUseMicrog"
            style="@style/Widget.Anoy.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/google_use_microg" />

        <TextView
            android:id="@+id/googleMicrogCaption"
            style="@style/Text.Dashboard.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/google_microg_caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/googleRepair"
            style="@style/Widget.Anoy.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/google_repair"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/googleOpenProvider"
            style="@style/Widget.Anoy.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/google_open_store"
            android:visibility="gone" />

        <TextView
            android:id="@+id/googleOpenProviderCaption"
            style="@style/Text.Dashboard.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/google_open_store_caption"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/googleProgressWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/googleProgress"
                style="@style/Widget.Anoy.Progress.Sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/googleProgressText"
                style="@style/Text.Dashboard.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:accessibilityLiveRegion="polite"
                android:text="@string/google_working_phone" />
        </LinearLayout>

        <TextView
            android:id="@+id/googleResultText"
            style="@style/Text.BodyS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/googleCancel"
            style="@style/Widget.Anoy.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/cancel" />
    </LinearLayout>
</ScrollView>
