<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/bg_light_dialog">

    <ImageView
        android:id="@+id/loadingIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_anoy"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/loadingText"
        style="@style/IosHeadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sign_in"
        android:layout_marginBottom="18dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:indeterminate="false"
        android:progressDrawable="@drawable/bg_ios_progress" />

    <TextView
        android:id="@+id/progressText"
        style="@style/IosFootnote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/okButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="OK"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textColor="@color/anoyOnBlue"
        android:background="@drawable/bg_light_ok_button"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:stateListAnimator="@null" />

</LinearLayout>
