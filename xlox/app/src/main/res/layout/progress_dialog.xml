<?xml version="1.0" encoding="utf-8"?>
<!-- OBB copy progress dialog: surfaceElevated, dialog radius, linear progress. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ds_dialog"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <TextView
        android:id="@+id/progressTitle"
        style="@style/TextAppearance.Ds.HeadlineSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/state_loading" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.Ds.Progress.Linear"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_linear"
        android:layout_marginTop="@dimen/space_16"
        android:max="100" />

    <TextView
        android:id="@+id/progressText"
        style="@style/TextAppearance.Ds.Tertiary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/state_loading" />
</LinearLayout>
