<?xml version="1.0" encoding="utf-8"?>
<!--
  Library update sheet (spec 3.3): the shared sheet, non-dismissible, so no
  handle. Kicker LIBRARY, Title M (+ a 20 dp green check when up to date),
  Body S, then a 3 dp bar, the Mono byte count and one action when needed.
  Settings > Re-download library reuses it (optional: Close after a failure).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gateRoot"
    style="@style/Sheet">

    <TextView
        android:id="@+id/gateKicker"
        style="@style/Text.Kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/row_library" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kicker_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/gateTitle"
            style="@style/Text.TitleM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:accessibilityLiveRegion="polite" />

        <ImageView
            android:id="@+id/gateIcon"
            android:layout_width="@dimen/icon_title"
            android:layout_height="@dimen/icon_title"
            android:layout_marginStart="@dimen/space_8"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_check"
            app:tint="@color/success" />
    </LinearLayout>

    <TextView
        android:id="@+id/gateMessage"
        style="@style/Text.BodyS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8" />

    <TextView
        android:id="@+id/gateDetail"
        style="@style/Text.Mono.Footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:fontFeatureSettings="tnum"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/gateProgress"
        style="@style/Widget.Anoy.Progress.Sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/gateProgressText"
        style="@style/Text.Mono.Footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:fontFeatureSettings="tnum"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/gateAction"
        style="@style/Widget.Anoy.Button.Sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:visibility="gone" />

    <!-- Settings re-download only: closes the sheet after a failure (the old library stays). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/gateClose"
        style="@style/Widget.Anoy.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/close"
        android:visibility="gone" />
</LinearLayout>
