<?xml version="1.0" encoding="utf-8"?>
<!-- Mandatory library update gate. Text has no background of its own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <ProgressBar
        android:id="@+id/gateSpinner"
        style="@style/Spinner"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/gateTitle"
        style="@style/Text.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:text="@string/update_checking_title" />

    <TextView
        android:id="@+id/gateMessage"
        style="@style/Text.Footnote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:text="@string/update_checking_message" />

    <TextView
        android:id="@+id/gateDetail"
        style="@style/Text.Footnote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/text_tertiary"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/gateProgress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_height"
        android:layout_marginTop="22dp"
        android:indeterminate="false"
        android:max="100"
        android:indeterminateTint="@color/blue"
        android:progressDrawable="@drawable/progress_bar"
        android:visibility="gone" />

    <TextView
        android:id="@+id/gateProgressText"
        style="@style/Text.Footnote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <Button
        android:id="@+id/gateAction"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_marginTop="24dp"
        android:text="@string/update_now"
        android:visibility="gone" />
</LinearLayout>
