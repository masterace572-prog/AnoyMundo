<?xml version="1.0" encoding="utf-8"?>
<!--
  Update gate content, shown in a non-dismissable bottom sheet
  (28 dp top corners, no handle, 60 % scrim). One visual slot at the top:
  either a Lottie animation (checking / done) or a 56 dp icon tile.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gateRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_32"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_24">

    <FrameLayout
        android:id="@+id/gateVisual"
        android:layout_width="@dimen/gate_anim"
        android:layout_height="@dimen/gate_anim">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/gateAnim"
            android:layout_width="@dimen/gate_anim"
            android:layout_height="@dimen/gate_anim"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:lottie_renderMode="hardware" />

        <ImageView
            android:id="@+id/gateIcon"
            style="@style/TileLarge"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/gateTitle"
        style="@style/Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:accessibilityHeading="true"
        android:accessibilityLiveRegion="polite"
        android:gravity="center" />

    <TextView
        android:id="@+id/gateMessage"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center" />

    <TextView
        android:id="@+id/gateDetail"
        style="@style/Chip"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_chip_neutral"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:fontFeatureSettings="tnum"
        android:paddingStart="12dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_download"
        app:drawableTint="@color/text_secondary" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/gateProgress"
        style="@style/Widget.Anoy.Progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:visibility="gone" />

    <TextView
        android:id="@+id/gateProgressText"
        style="@style/Text.Mono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/gateAction"
        style="@style/Widget.Anoy.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:visibility="gone" />
</LinearLayout>
