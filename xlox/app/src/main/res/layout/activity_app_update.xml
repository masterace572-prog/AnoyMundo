<?xml version="1.0" encoding="utf-8"?>
<!--
  2.2.0 in-app app update (the APK - never the library, see UpdateGate).
  Scrolling header + "What's new" card, with a pinned bottom panel: status
  line, progress and the buttons. Mandatory releases have no "Not now".
  appUpdateRoot gets the status-bar inset; the panel gets the navigation bar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appUpdateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/appUpdateScroll"
        style="@style/Scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/appUpdateContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="48dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="200dp">

            <ImageView
                android:id="@+id/appUpdateIcon"
                style="@style/TileLarge"
                android:background="@drawable/bg_status_blue"
                app:srcCompat="@drawable/ic_arrow_down_to_line"
                app:tint="@color/blue" />

            <TextView
                android:id="@+id/appUpdateTitle"
                style="@style/Text.LargeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:text="@string/app_update_title" />

            <TextView
                android:id="@+id/appUpdateSubtitle"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8" />

            <TextView
                style="@style/Text.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:accessibilityHeading="true"
                android:text="@string/app_update_whats_new" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/appUpdateNotesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/appUpdateNotes"
                    style="@style/Text.Callout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6sp"
                    android:padding="@dimen/card_padding"
                    android:textIsSelectable="false" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Pinned panel over a 24 dp fade, like home's action bar. -->
    <LinearLayout
        android:id="@+id/appUpdateBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fade_height"
            android:background="@drawable/bg_fade"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/appUpdatePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_12">

            <TextView
                android:id="@+id/appUpdateStatus"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/appUpdateProgress"
                style="@style/Widget.Anoy.Progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:visibility="gone" />

            <TextView
                android:id="@+id/appUpdateProgressText"
                style="@style/Text.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginBottom="@dimen/space_12"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appUpdatePrimary"
                style="@style/Widget.Anoy.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_update_now" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appUpdateLater"
                style="@style/Widget.Anoy.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/app_update_not_now" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
