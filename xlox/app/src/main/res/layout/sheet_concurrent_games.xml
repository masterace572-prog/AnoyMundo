<?xml version="1.0" encoding="utf-8"?>
<!-- Scrollable for narrow windows / large text. Cancel is always available. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/concurrentGamesRoot"
    style="@style/Sheet.Draggable"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View style="@style/SheetHandle" />

        <TextView
            style="@style/Text.Kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/concurrent_games_kicker" />

        <TextView
            style="@style/Text.TitleM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kicker_gap"
            android:accessibilityHeading="true"
            android:text="@string/concurrent_games_title" />

        <TextView
            android:id="@+id/concurrentGamesMessage"
            style="@style/Text.BodyS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/concurrentGamesConfirm"
            style="@style/Widget.Anoy.Button.Sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:enabled="false"
            android:text="@string/concurrent_games_confirm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/concurrentGamesCancel"
            style="@style/Widget.Anoy.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/cancel" />
    </LinearLayout>
</ScrollView>
