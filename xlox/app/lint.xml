<?xml version="1.0" encoding="utf-8"?>
<!--
  Lint policy for the XLOX loader.

  The checks below describe deliberate, pre-existing product constraints of the
  loader itself, not the UI redesign:

    ScopedStorage / UnusedAttribute   MANAGE_EXTERNAL_STORAGE and the API-36
                                      pageSizeCompat flag are required by the
                                      virtual-container SDK.
    UnsafeDynamicallyLoadedCode       the loader injects a native library at
    SetWorldReadable / Writable        runtime; this is outside the UI layer.
    AppBundleLocaleChanges            Prefs.java runtime locale switching.
    IconLocation                      ic_anoy.png stays as the densityless
                                      launcher icon (frozen by the audit).
    ChromeOsAbiSupport                arm64-v8a-only by design.
    GradleDependency                  versions are pinned deliberately; no new
                                      UI library is introduced.

  Every UI-related check stays at full severity: NewApi, InvalidVectorPath,
  UseAppTint, UnusedResources, InefficientWeight, Overdraw, ContentDescription,
  Autofill, LabelFor, TooManyViews, PluralsCandidate, ObsoleteSdkInt and
  RtlEnabled are all resolved in source rather than suppressed here.
-->
<lint>
    <issue id="ScopedStorage" severity="ignore" />
    <issue id="UnusedAttribute" severity="ignore" />
    <issue id="UnsafeDynamicallyLoadedCode" severity="ignore" />
    <issue id="SetWorldReadable" severity="ignore" />
    <issue id="SetWorldWritable" severity="ignore" />
    <issue id="AppBundleLocaleChanges" severity="ignore" />
    <issue id="IconLocation" severity="ignore" />
    <issue id="ChromeOsAbiSupport" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
</lint>
