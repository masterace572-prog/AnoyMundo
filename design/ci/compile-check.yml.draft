# DRAFT - not active. GitHub only runs workflows from .github/workflows/, and
# this file is deliberately outside it. To use it, copy it to
# .github/workflows/splash-compile-check.yml on the splash-compile-check branch
# ONLY (never on arena/2e95185a-anoymundo).
#
# Compile-only check for the splash hand-off changes (B1-B4). It mirrors the
# build steps of build-xlox.yml (checkout, icon bundle, static UI gate, JDK 17
# + Gradle cache, SDK/NDK install, Android lint) but:
#   - runs on a push to the splash-compile-check branch and nothing else
#     (no workflow_dispatch, no pull_request, no tags),
#   - reads no secrets, signs nothing with the release key,
#   - creates no release or tag, uploads nothing to a server or the panel,
#   - has its own name and concurrency group, so it can never cancel or
#     overwrite a build-xlox.yml run.
# Its only output is two short-lived workflow artifacts (see the last steps).
name: Splash compile check (no publish)

on:
  push:
    branches: [splash-compile-check]

permissions:
  contents: read

concurrency:
  group: splash-compile-check-${{ github.ref }}
  cancel-in-progress: true

jobs:
  compile:
    runs-on: ubuntu-24.04
    timeout-minutes: 50
    defaults:
      run:
        working-directory: xlox
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      # Same as build-xlox.yml. A no-op when the PNG is already in the tree.
      - name: Bundle the BGMI icon (no-op when already committed)
        run: python3 scripts/fetch_game_icon.py

      - name: Static UI gates (no SDK needed)
        run: python3 scripts/ui_quality_gate.py

      - name: JDK 17
        uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: '17'
          cache: gradle
          cache-dependency-path: |
            xlox/gradle/wrapper/gradle-wrapper.properties
            xlox/build.gradle
            xlox/app/build.gradle

      # Identical to build-xlox.yml (the NDK is needed: assembleDebug also
      # builds libXloX.so through externalNativeBuild).
      - name: Install SDK platform, build-tools and pinned NDK
        run: |
          SDK="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/android-sdk}}"
          mkdir -p "$SDK"
          if [ -x "$SDK/cmdline-tools/latest/bin/sdkmanager" ]; then
            SM="$SDK/cmdline-tools/latest/bin/sdkmanager"
          elif command -v sdkmanager >/dev/null 2>&1; then
            SM="$(command -v sdkmanager)"
          else
            echo "Installing Android command line tools"
            curl -fsSL -o /tmp/cmdtools.zip \
              https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip
            rm -rf /tmp/cmdtools && mkdir -p /tmp/cmdtools
            unzip -q /tmp/cmdtools.zip -d /tmp/cmdtools
            mkdir -p "$SDK/cmdline-tools/latest"
            cp -r /tmp/cmdtools/cmdline-tools/. "$SDK/cmdline-tools/latest/"
            SM="$SDK/cmdline-tools/latest/bin/sdkmanager"
          fi
          echo "ANDROID_HOME=$SDK" >> "$GITHUB_ENV"
          echo "ANDROID_SDK_ROOT=$SDK" >> "$GITHUB_ENV"
          yes | "$SM" --sdk_root="$SDK" --licenses > /dev/null 2>&1 || true
          "$SM" --sdk_root="$SDK" --install "platform-tools" "platforms;android-34" "platforms;android-36" \
                                           "build-tools;34.0.0" "ndk;24.0.8215888"
          test -x "$SDK/ndk/24.0.8215888/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android21-clang"
          "$SM" --sdk_root="$SDK" --list_installed | grep -E 'android-36|34\.0\.0|24\.0\.8215888'

      # No signing secrets: the debug build is signed with the runner's
      # auto-generated debug key.
      - name: Assemble debug APK
        run: |
          chmod +x gradlew
          set +e
          ./gradlew assembleDebug --no-daemon > /tmp/assemble.log 2>&1
          rc=$?
          cat /tmp/assemble.log
          if [ $rc -ne 0 ]; then
            # Surface compiler / resource errors as annotations (readable via the API).
            grep -E "Duplicate class|error:|: error|e: |ERROR:|What went wrong|AAPT|Execution failed|not found|cannot find symbol" /tmp/assemble.log \
              | grep -v "^\s*at " | head -40 | while IFS= read -r line; do
                echo "::error::$(echo "$line" | cut -c1-400)"
              done
            grep -A3 -E "error:" /tmp/assemble.log | head -60 | tr '\n' ' ' | cut -c1-3500 | sed 's/^/::error title=context::/'
            grep -A8 "What went wrong" /tmp/assemble.log | head -30 | tr '\n' ' ' | cut -c1-3500 | sed 's/^/::error title=gradle::/'
          fi
          exit $rc

      # The same lint gate as build-xlox.yml (lintRelease, errors fail the
      # job). It needs no secret: without XLOX_STORE_PASSWORD the release
      # signingConfig is simply null (app/build.gradle), and lint signs nothing.
      - name: Android lint (errors fail the build)
        run: |
          set +e
          ./gradlew lintRelease --no-daemon > /tmp/lint.log 2>&1
          rc=$?
          cat /tmp/lint.log
          R=$(ls app/build/reports/lint-results-release.txt app/build/intermediates/lint_intermediate_text_report/release/*.txt 2>/dev/null | head -1)
          if [ -n "$R" ]; then
            grep -E ": Error:" "$R" | head -40 | while IFS= read -r line; do echo "::error::$(echo "$line" | cut -c1-400)"; done
            grep -E ": Warning:" "$R" | head -20 | while IFS= read -r line; do echo "::warning::$(echo "$line" | cut -c1-400)"; done
            # GitHub shows at most 10 warnings per step: one notice lists them all.
            S=$(grep -E ": Warning:" "$R" | sed -E 's#^.*/app/(src/main/)?##; s#: Warning: .*\[([A-Za-z0-9]+)\]$# \1#' | sort | tr '\n' ';')
            echo "::notice title=Lint warnings ($(grep -cE ': Warning:' "$R"))::${S:-none}"
          fi
          [ $rc -ne 0 ] && grep -E "What went wrong|Lint found" /tmp/lint.log | head -5 | sed 's/^/::error::/'
          exit $rc

      - name: Upload lint report
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: splash-compile-check-lint
          path: xlox/app/build/reports/lint-results-release.*
          if-no-files-found: ignore
          retention-days: 3

      # Debug APK as a workflow artifact only (3 days). It is signed with the
      # runner's throwaway DEBUG key, not app/xlox.jks, so it CANNOT be
      # installed over the real Anoy 2.3.8 (same package com.xlox, different
      # signature): the phone refuses the update. Use a phone without the
      # real app, or uninstall it first (this deletes its data and sign-in).
      # It is also debuggable, so its frame times are NOT representative of
      # the release build. The repository is public: anyone signed in to
      # GitHub can download this artifact while it exists.
      - name: Upload debug APK (artifact, 3 days)
        uses: actions/upload-artifact@v7
        with:
          name: splash-compile-check-debug-apk
          path: xlox/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
          retention-days: 3
